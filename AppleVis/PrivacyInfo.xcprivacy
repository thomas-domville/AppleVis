<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  PrivacyInfo.xcprivacy — Apple Privacy Manifest (required for App Store submission)
  https://developer.apple.com/documentation/bundleresources/privacy-manifest-files

  Rewritten for the native Swift app — the previous version (assets/PrivacyInfo.xcprivacy)
  was written for the Expo/React Native prototype and referenced dependencies
  (AsyncStorage, expo-file-system, RN internals) that no longer exist.

  NOT independently verified against Apple's current published reason-code list
  in this pass (no network access) — re-check the "Required Reason APIs" codes
  below against https://developer.apple.com/documentation/bundleresources/privacy_manifest_files/describing_use_of_required_reason_api
  before submission; only the categories/purposes were re-derived from the
  actual Swift code, not the specific reason letter/number codes themselves.
-->
<plist version="1.0">
<dict>
  <!-- ── Collected Data Types ──────────────────────────────────────────────── -->
  <!-- AppleVis does not collect any data for tracking purposes. -->
  <key>NSPrivacyTracking</key>
  <false/>
  <key>NSPrivacyTrackingDomains</key>
  <array/>

  <key>NSPrivacyCollectedDataTypes</key>
  <array>
    <!-- Account credentials: session token stored in Keychain (AuthStore) -->
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypeEmailAddress</string>
      <key>NSPrivacyCollectedDataTypeLinked</key>
      <true/>
      <key>NSPrivacyCollectedDataTypeTracking</key>
      <false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array>
        <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
      </array>
    </dict>
    <!-- iCloud key-value sync: saved items, queue, playback positions, settings (ICloudSyncManager) -->
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypeOtherUserContent</string>
      <key>NSPrivacyCollectedDataTypeLinked</key>
      <true/>
      <key>NSPrivacyCollectedDataTypeTracking</key>
      <false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array>
        <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
      </array>
    </dict>
    <!-- APNs device token — sent to applevis.com only, to enable push notifications (PushNotificationManager) -->
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypeDeviceID</string>
      <key>NSPrivacyCollectedDataTypeLinked</key>
      <true/>
      <key>NSPrivacyCollectedDataTypeTracking</key>
      <false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array>
        <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
      </array>
    </dict>
  </array>

  <!-- ── Required Reason APIs ──────────────────────────────────────────────── -->
  <key>NSPrivacyAccessedAPITypes</key>
  <array>

    <!-- NSUserDefaults — UserDefaults.standard throughout, plus the
         group.com.applevis.app App Group suite shared by the main app and
         the Share Extension target. -->
    <dict>
      <key>NSPrivacyAccessedAPIType</key>
      <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
      <key>NSPrivacyAccessedAPITypeReasons</key>
      <array>
        <!-- Accessed from app and app extensions that are members of the same App Group -->
        <string>CA92.1</string>
      </array>
    </dict>

    <!-- File timestamps — DownloadManager manages downloaded episode files
         in the app's container; PlayerStore/AppleVisApp purge URLCache
         based on age for the Storage → Cache Retention setting. -->
    <dict>
      <key>NSPrivacyAccessedAPIType</key>
      <string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
      <key>NSPrivacyAccessedAPITypeReasons</key>
      <array>
        <!-- Accessed to manage files/data within the app's container -->
        <string>0A2A.1</string>
      </array>
    </dict>

    <!-- Disk space — StorageView reports downloaded-episode/cache usage to the user. -->
    <dict>
      <key>NSPrivacyAccessedAPIType</key>
      <string>NSPrivacyAccessedAPICategoryDiskSpace</string>
      <key>NSPrivacyAccessedAPITypeReasons</key>
      <array>
        <!-- Accessed to display disk space information to the user -->
        <string>E174.1</string>
      </array>
    </dict>

  </array>
</dict>
</plist>

        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หากคุณออกจากระบบในภายหลัง หน้าหลักจะสามารถแสดงสิ่งใหม่ ๆ ตั้งแต่การเข้าชมครั้งล่าสุดของคุณได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İleride oturumu kapatırsanız Ana Sayfa, son ziyaretinizden bu yana yenilikleri gösterebilir."

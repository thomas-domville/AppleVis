          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "問題の診断に役立つよう、アプリのバージョンと iOS のバージョンを添付します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",

        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα θέματα που είδατε, η παρακολούθηση νέων σχολίων και το ιστορικό επισκέψεων μπορούν να σας ακολουθούν σε όλες τις συσκευές όταν το ιστορικό είναι ενεργό."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los temas vistos, el seguimiento de comentarios nuevos y el historial de visitas pueden acompañarte en tus dispositivos cuando el historial está activado."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وقتی تاریخچه روشن باشد، موضوعات دیده‌شده، پیگیری دیدگاه‌های جدید و تاریخچهٔ بازدید می‌توانند در همهٔ دستگاه‌ها همراهتان باشند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sujets vus, le suivi des nouveaux commentaires et l'historique des visites peuvent vous suivre sur vos appareils lorsque l'historique est activé."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "נושאים שנצפו, מעקב אחר תגובות חדשות והיסטוריית ביקורים יכולים לעבור איתך בין מכשירים כשההיסטוריה מופעלת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इतिहास चालू होने पर देखे गए विषय, नई टिप्पणियों की ट्रैकिंग और विज़िट इतिहास आपके सभी डिवाइस पर साथ रह सकते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Topik yang dilihat, pelacakan komentar baru, dan riwayat kunjungan dapat mengikuti Anda di berbagai perangkat saat riwayat diaktifkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli argomenti visti, il monitoraggio dei nuovi commenti e la cronologia delle visite possono seguirti sui tuoi dispositivi quando la cronologia è attiva."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "履歴がオンのとき、閲覧したトピック、新着コメントの追跡、訪問履歴をデバイス間で引き継げます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기록이 켜져 있으면 본 주제, 새 댓글 추적, 방문 기록이 여러 기기에서 이어집니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bekeken onderwerpen, het bijhouden van nieuwe reacties en je bezoekgeschiedenis kunnen je naar al je apparaten volgen als de geschiedenis aanstaat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyświetlone wątki, śledzenie nowych komentarzy i historia wizyt mogą być dostępne na wszystkich urządzeniach, gdy historia jest włączona."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tópicos vistos, acompanhamento de novos comentários e histórico de visitas podem acompanhar você entre dispositivos quando o histórico está ativado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Просмотренные темы, отслеживание новых комментариев и история посещений могут переноситься между устройствами, если история включена."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visade ämnen, spårning av nya kommentarer och besökshistorik kan följa med dig mellan enheter när historik är aktiverat."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หัวข้อที่ดูแล้ว การติดตามความคิดเห็นใหม่ และประวัติการเข้าชม จะตามคุณไปทุกอุปกรณ์เมื่อเปิดประวัติไว้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geçmiş açıkken görülen konular, yeni yorum takibi ve ziyaret geçmişi cihazlarınız arasında sizi izleyebilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переглянуті теми, відстеження нових коментарів та історія відвідувань можуть переноситися між пристроями, якщо історію ввімкнено."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi bật lịch sử, các chủ đề đã xem, theo dõi bình luận mới và lịch sử truy cập có thể theo bạn trên các thiết bị."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开启记录后，已查看的话题、新评论追踪和访问记录可在你的各设备之间同步。"
          }
        }
      }
    },

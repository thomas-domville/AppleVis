          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Witamy z powrotem w AppleVis. Wracasz tam, gdzie skończyłeś."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",

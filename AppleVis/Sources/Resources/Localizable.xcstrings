    "Leaves the tour to show you this screen for real. A Resume Tour button brings you right back to this exact step." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يغادر الجولة ليريك هذه الشاشة فعليًا. زر إعادة تشغيل الجولة يعيدك مباشرة إلى هذه الخطوة بالذات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verlässt die Tour, um dir diesen Bildschirm in echt zu zeigen. Eine Schaltfläche „Tour fortsetzen“ bringt dich genau zu diesem Schritt zurück."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εγκαταλείπει την περιήγηση για να σας δείξει αυτή την οθόνη στην πράξη. Ένα κουμπί Συνέχιση Περιήγησης σας επαναφέρει ακριβώς σε αυτό το βήμα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sale del recorrido para mostrarte esta pantalla de verdad. Un botón Reanudar recorrido te trae de vuelta exactamente a este paso."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تور را ترک می‌کند تا این صفحه را واقعاً به شما نشان دهد. دکمهٔ ازسرگیری تور دقیقاً شما را به همین مرحله بازمی‌گرداند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quitte la visite pour vous montrer cet écran pour de vrai. Un bouton Reprendre la visite vous ramène exactement à cette étape."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יוצא מהסיור כדי להראות לך את המסך הזה באמת. כפתור המשך סיור מחזיר אותך בדיוק לשלב הזה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपको यह स्क्रीन वास्तव में दिखाने के लिए टूर छोड़ देता है। एक टूर फिर से शुरू करें बटन आपको बिल्कुल इसी चरण पर वापस ले आता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meninggalkan tur untuk menunjukkan layar ini kepada Anda secara nyata. Tombol Lanjutkan Tur membawa Anda kembali tepat ke langkah ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esce dal tour per mostrarti questa schermata sul serio. Un pulsante Riprendi il tour ti riporta esattamente a questo passaggio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ツアーを離れて、この画面を実際に表示します。「ツアーを再開」ボタンで、まさにこのステップに戻ってこられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "투어에서 나가 이 화면을 실제로 보여줘요. '투어 재개' 버튼을 누르면 바로 이 단계로 정확히 돌아올 수 있어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verlaat de rondleiding om je dit scherm echt te tonen. Een knop Rondleiding hervatten brengt je precies terug naar deze stap."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opuszcza wycieczkę, aby pokazać Ci ten ekran naprawdę. Przycisk Wznów wycieczkę przywraca Cię dokładnie do tego kroku."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sai do tour para te mostrar essa tela de verdade. Um botão Retomar Tour te traz de volta exatamente a este passo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Покидает тур, чтобы показать вам этот экран по-настоящему. Кнопка «Возобновить тур» вернёт вас точно на этот же шаг."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lämnar rundturen för att visa dig den här skärmen på riktigt. En knapp för att återuppta rundturen tar dig tillbaka exakt till det här steget."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ออกจากทัวร์เพื่อแสดงหน้าจอนี้ให้คุณเห็นจริง ปุ่มดำเนินการทัวร์ต่อจะพาคุณกลับมาที่ขั้นตอนนี้พอดี"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu ekranı size gerçekten göstermek için turdan çıkar. Bir Turu Sürdür düğmesi sizi tam olarak bu adıma geri getirir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Виходить із туру, щоб показати вам цей екран по-справжньому. Кнопка «Відновити тур» поверне вас точно на цей крок."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rời chuyến tham quan để cho bạn xem màn hình này thật sự. Một nút Tiếp tục Chuyến tham quan sẽ đưa bạn quay lại đúng bước này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",

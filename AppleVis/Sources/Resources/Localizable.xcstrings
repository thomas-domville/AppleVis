          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وقتی کسی پاسخ دهد به شما اطلاع می‌دهد. می‌توانید هر زمان از خود موضوع دنبال‌کردن را لغو کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",

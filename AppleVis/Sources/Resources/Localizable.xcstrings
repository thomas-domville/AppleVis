    "See a short, skippable walkthrough of Home, Discover, For You, Search, Profile, and Settings." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شاهد جولة قصيرة يمكن تخطيها للشاشة الرئيسية والاستكشاف ومن أجلك والبحث والملف الشخصي والإعدادات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sieh dir eine kurze, überspringbare Einführung zu Home, Entdecken, Für dich, Suche, Profil und Einstellungen an."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δείτε μια σύντομη, παραλείψιμη περιήγηση των Αρχική, Ανακάλυψη, Για Εσάς, Αναζήτηση, Προφίλ και Ρυθμίσεις."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mira un breve recorrido, que puedes omitir, de Inicio, Descubrir, Para ti, Buscar, Perfil y Configuración."

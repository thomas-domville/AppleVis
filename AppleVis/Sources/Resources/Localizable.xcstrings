        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nút Cho phép thông báo không cho biết lời hỏi quyền của iOS sắp hỏi gì hay vì sao. Giờ có ghi chú ngắn giải thích rằng chỉ gửi cảnh báo cho những gì bạn bật ở trên, và bạn có thể đổi bất cứ lúc nào trong Cài đặt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“允许通知”按钮没有说明 iOS 的权限请求将要询问什么，也没有说明原因。现在有一条简短说明：只会针对你在上方打开的内容发送提醒，并且可以随时在设置中更改。"
          }
        }
      }
    },
    "No More Dead Preview on System Default Sound" : {

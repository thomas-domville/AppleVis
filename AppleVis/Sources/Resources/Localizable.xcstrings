    "Appends your app version, device, and accessibility settings (like VoiceOver) to help diagnose the issue." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُلحق إصدار التطبيق والجهاز وإعدادات إمكانية الوصول (مثل VoiceOver) للمساعدة في تشخيص المشكلة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügt deine App-Version, dein Gerät und Bedienungshilfen-Einstellungen (wie VoiceOver) hinzu, um die Diagnose zu erleichtern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προσθέτει την έκδοση της εφαρμογής, τη συσκευή και τις ρυθμίσεις προσβασιμότητας (όπως το VoiceOver) για να βοηθήσει στη διάγνωση του προβλήματος."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade la versión de la app, el dispositivo y la configuración de accesibilidad (como VoiceOver) para ayudar a diagnosticar el problema."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",

        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Σχετικά με την Apple καλύπτει προϊόντα και πλατφόρμες της Apple, όπως iPhone, Mac, Apple Watch και εφαρμογές."

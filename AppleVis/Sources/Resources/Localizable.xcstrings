    "%@ Colorful confetti is falling to celebrate. %@" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ يتساقط قصاصات ورقية ملونة للاحتفال. %@"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Buntes Konfetti fällt zur Feier. %@"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Πολύχρωμα κομφετί πέφτουν για να γιορτάσουν. %@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ Colorful confetti is falling to celebrate. %2$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Confeti de colores cae para celebrar. %@"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ کاغذرنگی‌های رنگارنگ برای جشن در حال ریزش هستند. %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Des confettis colorés tombent pour célébrer. %@"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ קונפטי צבעוני נופל לרגל החגיגה. %@"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ जश्न मनाने के लिए रंगीन कंफ़ेटी गिर रही है। %@"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Confetti warna-warni berjatuhan untuk merayakan. %@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Coriandoli colorati cadono per festeggiare. %@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ お祝いのカラフルな紙吹雪が舞っています。%@"
          }

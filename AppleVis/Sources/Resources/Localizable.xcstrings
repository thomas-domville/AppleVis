    "Adds a vibration for the same moments Confirmation Sounds covers, like saving, signing in, and errors." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يضيف اهتزازًا في نفس اللحظات التي تغطيها أصوات التأكيد، مثل الحفظ وتسجيل الدخول والأخطاء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügt eine Vibration für dieselben Momente wie Bestätigungstöne hinzu, etwa beim Speichern, Anmelden und bei Fehlern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προσθέτει δόνηση στις ίδιες στιγμές που καλύπτουν οι Ήχοι Επιβεβαίωσης, όπως αποθήκευση, σύνδεση και σφάλματα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade una vibración para los mismos momentos que cubren los Sonidos de confirmación, como guardar, iniciar sesión y errores."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "در همان لحظاتی که صداهای تأیید پوشش می‌دهند—مانند ذخیره، ورود و خطاها—یک لرزش اضافه می‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute une vibration aux mêmes moments que les Sons de confirmation, comme l'enregistrement, la connexion et les erreurs."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מוסיף רטט לאותם רגעים שמכסים צלילי אישור, כמו שמירה, התחברות ושגיאות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पुष्टिकरण ध्वनियों द्वारा कवर किए गए समान क्षणों, जैसे सेव करना, साइन इन करना और त्रुटियों के लिए एक कंपन जोड़ता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menambahkan getaran untuk momen yang sama yang dicakup oleh Suara Konfirmasi, seperti menyimpan, masuk, dan kesalahan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiunge una vibrazione negli stessi momenti coperti dai Suoni di conferma, come salvataggio, accesso ed errori."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "確認音が鳴るのと同じタイミング（保存、サインイン、エラーなど）で振動を追加します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장, 로그인, 오류 등 확인음이 울리는 시점에 진동을 추가합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voegt trilling toe op dezelfde momenten als bevestigingsgeluiden, zoals opslaan, aanmelden en fouten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaje wibrację w tych samych momentach co Dźwięki potwierdzenia, np. przy zapisywaniu, logowaniu i błędach."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adiciona uma vibração para os mesmos momentos cobertos pelos Sons de confirmação, como salvar, entrar e erros."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавляет вибрацию в те же моменты, что и звуки подтверждения: при сохранении, входе и ошибках."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lägger till vibration vid samma tillfällen som Bekräftelseljud, till exempel vid sparande, inloggning och fel."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เพิ่มการสั่นในช่วงเวลาเดียวกับที่เสียงยืนยันครอบคลุม เช่น การบันทึก การลงชื่อเข้าใช้ และข้อผิดพลาด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaydetme, oturum açma ve hatalar gibi Onay Sesleri'nin kapsadığı aynı anlarda titreşim ekler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Додає вібрацію в ті самі моменти, що охоплюють звуки підтвердження, як-от збереження, вхід і помилки."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thêm rung cho những thời điểm mà Âm thanh xác nhận đề cập, như lưu, đăng nhập và lỗi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在“确认音效”涵盖的相同时刻（如保存、登录和出错时）添加振动。"
          }
        }
      }
    },

        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleVis 포럼은 판매, 교환, 광고를 위한 곳이 아닙니다. 커뮤니티에 정말 도움이 된다고 생각한다면 먼저 AppleVis에 연락해 주세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De AppleVis-forums zijn niet bedoeld voor verkopen, ruilen of reclame. Als je denkt dat dit de community echt helpt, neem dan eerst contact op met AppleVis."

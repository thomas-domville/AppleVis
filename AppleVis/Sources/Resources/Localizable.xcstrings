    "Usage analytics are aggregated and never linked to your account or device identity." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُجمَّع تحليلات الاستخدام ولا تُربط أبدًا بحسابك أو جهازك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutzungsanalysen werden zusammengefasst und nie mit deinem Konto oder deinem Gerät verknüpft."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα στατιστικά χρήσης συγκεντρώνονται και δεν συνδέονται ποτέ με τον λογαριασμό ή τη συσκευή σας."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",

    "Shows how much space AppleVis is using on this device, split between downloaded episodes and cached content." : {
      "comment" : "A description of the storage usage of the app.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعرض مقدار المساحة التي يستخدمها AppleVis على هذا الجهاز، مقسّمة بين الحلقات التي تم تنزيلها والمحتوى المخزّن مؤقتًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt, wie viel Speicher AppleVis auf diesem Gerät belegt, aufgeteilt in geladene Folgen und zwischengespeicherte Inhalte."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δείχνει πόσο χώρο χρησιμοποιεί το AppleVis σε αυτή τη συσκευή, χωρισμένο σε ληφθέντα επεισόδια και αποθηκευμένο προσωρινά περιεχόμενο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra cuánto espacio usa AppleVis en este dispositivo, dividido entre episodios descargados y contenido en caché."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نشان می‌دهد AppleVis چه مقدار فضا در این دستگاه اشغال کرده است، به تفکیک قسمت‌های بارگیری‌شده و محتوای ذخیره‌شدهٔ موقت."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indique l'espace utilisé par AppleVis sur cet appareil, réparti entre les épisodes téléchargés et le contenu en cache."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מציג כמה מקום AppleVis תופס במכשיר הזה, בחלוקה בין פרקים שהורדו לתוכן שנשמר במטמון."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दिखाता है कि इस डिवाइस पर AppleVis कितनी जगह ले रहा है, डाउनलोड किए गए एपिसोड और कैश की गई सामग्री में बाँटकर।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menampilkan berapa banyak ruang yang digunakan AppleVis di perangkat ini, dibagi antara episode yang diunduh dan konten dalam cache."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra quanto spazio usa AppleVis su questo dispositivo, diviso tra episodi scaricati e contenuti nella cache."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスで AppleVis が使っている容量を、ダウンロード済みのエピソードとキャッシュされたコンテンツに分けて表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기에서 AppleVis가 사용하는 공간을 다운로드한 에피소드와 캐시된 콘텐츠로 나누어 보여 줍니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toont hoeveel ruimte AppleVis op dit apparaat gebruikt, verdeeld over gedownloade afleveringen en inhoud in de cache."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokazuje, ile miejsca zajmuje AppleVis na tym urządzeniu, z podziałem na pobrane odcinki i treści w pamięci podręcznej."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra quanto espaço o AppleVis está usando neste dispositivo, dividido entre episódios baixados e conteúdo em cache."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывает, сколько места AppleVis занимает на этом устройстве, с разбивкой на загруженные выпуски и кэшированный контент."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visar hur mycket utrymme AppleVis använder på den här enheten, uppdelat på nedladdade avsnitt och cachelagrat innehåll."
          }
        },
        "th" : {

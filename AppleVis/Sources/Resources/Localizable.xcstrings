        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jumlahnya terus bertambah di setiap kunjungan sampai Anda membuka item itu atau menandainya sudah dibaca."
          }
        },
        "it" : {
          "stringUnit" : {

        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваше повідомлення надсилається через AppleVis. %@ не побачить вашу електронну адресу, якщо не вирішить відповісти."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tin nhắn của bạn được gửi qua AppleVis. %@ sẽ không thấy địa chỉ email của bạn trừ khi họ chọn trả lời."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您的消息通过 AppleVis 发送。除非 %@ 选择回复，否则不会看到您的电子邮件地址。"
          }
        }
      }
    },

    "Shortens the quiet pauses between words, so episodes move along a little faster without changing the speed." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقصّر فترات التوقف الصامتة بين الكلمات، بحيث تتقدم الحلقات بسرعة أكبر قليلاً دون تغيير السرعة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verkürzt stille Pausen zwischen Wörtern, sodass Folgen etwas schneller vorangehen, ohne die Geschwindigkeit zu ändern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Συντομεύει τις σιωπηλές παύσεις μεταξύ λέξεων, ώστε τα επεισόδια να προχωρούν λίγο πιο γρήγορα χωρίς να αλλάζει η ταχύτητα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acorta las pausas silenciosas entre palabras, para que los episodios avancen un poco más rápido sin cambiar la velocidad."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مکث‌های ساکت بین کلمات را کوتاه می‌کند تا قسمت‌ها کمی سریع‌تر پیش بروند بدون تغییر سرعت."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raccourcit les silences entre les mots, pour que les épisodes avancent un peu plus vite sans changer la vitesse."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מקצר את ההפסקות השקטות בין מילים, כך שהפרקים מתקדמים מהר יותר מבלי לשנות את המהירות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "शब्दों के बीच शांत विराम को छोटा करता है, ताकि एपिसोड गति बदले बिना थोड़ा तेज़ी से आगे बढ़ें。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mempersingkat jeda sunyi antar kata, sehingga episode berjalan sedikit lebih cepat tanpa mengubah kecepatan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accorcia le pause silenziose tra le parole, così gli episodi procedono un po' più velocemente senza cambiare la velocità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "単語間の無音の間を短縮し、速度を変えることなく、エピソードが少し速く進むようにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "단어 사이의 조용한 정지를 줄여 속도를 변경하지 않고도 에피소드가 조금 더 빠르게 진행되게 합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verkort de stille pauzes tussen woorden, zodat afleveringen iets sneller verlopen zonder de snelheid te wijzigen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skraca ciche przerwy między słowami, dzięki czemu odcinki toczą się nieco szybciej bez zmiany prędkości."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encurta as pausas silenciosas entre palavras, para que os episódios avancem um pouco mais rápido sem alterar a velocidade."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сокращает тихие паузы между словами, чтобы эпизоды проходили немного быстрее без изменения скорости."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",

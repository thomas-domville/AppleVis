    "Also see Windows, Android, smart home, and other assistive tech discussions in Forums." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شاهد أيضًا نقاشات حول Windows وAndroid والمنزل الذكي والتقنيات المساعدة الأخرى في المنتديات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siehst außerdem Diskussionen zu Windows, Android, Smart Home und anderen Hilfstechnologien in den Foren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δείτε επίσης συζητήσεις για Windows, Android, έξυπνο σπίτι και άλλες τεχνολογίες υποβοήθησης στα Φόρουμ."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "También verás debates sobre Windows, Android, hogar inteligente y otras tecnologías de asistencia en los Foros."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "همچنین بحث‌های مربوط به ویندوز، اندروید، خانهٔ هوشمند و سایر فناوری‌های کمکی را در انجمن‌ها ببینید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voyez aussi les discussions sur Windows, Android, la domotique et d'autres technologies d'assistance dans les Forums."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תראה גם דיונים על Windows, Android, בית חכם וטכנולוגיות מסייעות אחרות בפורומים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फ़ोरम में Windows, Android, स्मार्ट होम, और अन्य सहायक तकनीक चर्चाएं भी देखें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lihat juga diskusi tentang Windows, Android, rumah pintar, dan teknologi bantu lainnya di Forum."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vedrai anche discussioni su Windows, Android, smart home e altre tecnologie assistive nei Forum."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フォーラムでは、Windows、Android、スマートホーム、その他の支援技術に関する話題もご覧いただけます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "포럼에서 Windows, Android, 스마트홈 및 기타 보조 기술 관련 논의도 확인할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zie ook discussies over Windows, Android, smart home en andere hulptechnologieën in Forums."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobaczysz też dyskusje o Windows, Android, inteligentnym domu i innych technologiach wspomagających na Forach."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Também veja discussões sobre Windows, Android, casa inteligente e outras tecnologias assistivas nos Fóruns."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Также вы увидите обсуждения Windows, Android, умного дома и других вспомогательных технологий на форумах."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se även diskussioner om Windows, Android, smart hem och annan hjälpmedelsteknik i Forum."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ดูการสนทนาเกี่ยวกับ Windows, Android, บ้านอัจฉริยะ และเทคโนโลยีสิ่งอำนวยความสะดวกอื่น ๆ ในฟอรัมด้วย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forumlarda ayrıca Windows, Android, akıllı ev ve diğer yardımcı teknoloji tartışmalarını da görürsünüz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Також ви побачите обговорення Windows, Android, розумного дому та інших допоміжних технологій на форумах."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xem thêm các thảo luận về Windows, Android, nhà thông minh và các công nghệ hỗ trợ khác trong Diễn đàn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您还可以在论坛中看到有关 Windows、Android、智能家居和其他辅助技术的讨论。"
          }
        }
      }
    },

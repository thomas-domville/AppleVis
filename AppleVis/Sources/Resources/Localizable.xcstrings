    "Search across forum topics, app directory listings, and resources. Results appear as you type." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ابحث في المنتديات والتطبيقات والموارد. تظهر النتائج أثناء الكتابة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suche in Foren, Apps und Ressourcen. Ergebnisse erscheinen während der Eingabe."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αναζήτηση σε θέματα φόρουμ, κατάλογο εφαρμογών και πόρους. Τα αποτελέσματα εμφανίζονται κατά την πληκτρολόγηση."
          }
        },
        "en" : {

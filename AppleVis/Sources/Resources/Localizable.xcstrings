    "This list needs a small update to the AppleVis website. It will fill in by itself once that's done, so check back soon." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحتاج هذه القائمة إلى تحديث صغير على موقع AppleVis. ستمتلئ من تلقاء نفسها بعد انتهائه، لذا عد قريبًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für diese Liste ist ein kleines Update der AppleVis-Website nötig. Sie füllt sich von selbst, sobald es fertig ist. Schau also bald wieder vorbei."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτή η λίστα χρειάζεται μια μικρή ενημέρωση του ιστότοπου του AppleVis. Θα συμπληρωθεί μόνη της μόλις γίνει, οπότε ελέγξτε ξανά σύντομα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta lista necesita una pequeña actualización del sitio web de AppleVis. Se llenará sola cuando esté lista, así que vuelve pronto."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این فهرست به یک به‌روزرسانی کوچک در وب‌سایت AppleVis نیاز دارد. پس از آن خودش پر می‌شود، پس به‌زودی دوباره سر بزنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette liste nécessite une petite mise à jour du site AppleVis. Elle se remplira d’elle-même une fois celle-ci terminée. Revenez bientôt."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הרשימה הזו צריכה עדכון קטן באתר AppleVis. היא תתמלא מעצמה כשהעדכון יסתיים, אז כדאי לחזור בקרוב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस सूची के लिए AppleVis वेबसाइट में एक छोटा अपडेट ज़रूरी है। उसके पूरा होते ही यह अपने आप भर जाएगी, इसलिए जल्द ही फिर देखें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daftar ini memerlukan pembaruan kecil pada situs web AppleVis. Daftar akan terisi sendiri setelah pembaruan selesai, jadi periksa lagi nanti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo elenco richiede un piccolo aggiornamento del sito AppleVis. Si riempirà da solo quando sarà pronto, quindi torna a controllare presto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このリストには AppleVis の Web サイトの小さなアップデートが必要です。アップデートが終わると自動的に表示されるので、また後で確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 목록은 AppleVis 웹사이트의 작은 업데이트가 필요합니다. 업데이트가 끝나면 자동으로 채워지니 곧 다시 확인해 주세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voor deze lijst is een kleine update van de AppleVis-website nodig. Hij vult zich vanzelf zodra die klaar is, dus kijk snel weer."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta lista wymaga niewielkiej aktualizacji witryny AppleVis. Wypełni się sama, gdy aktualizacja się zakończy, więc zajrzyj tu wkrótce."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta lista precisa de uma pequena atualização no site do AppleVis. Ela será preenchida sozinha quando isso terminar, então volte em breve."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для этого списка нужно небольшое обновление сайта AppleVis. Он заполнится сам, когда обновление будет готово, так что загляните сюда позже."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här listan behöver en liten uppdatering av AppleVis webbplats. Den fylls i av sig själv när den är klar, så titta in snart igen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รายการนี้ต้องมีการอัปเดตเล็กน้อยบนเว็บไซต์ AppleVis เมื่ออัปเดตเสร็จ รายการจะแสดงขึ้นเอง โปรดกลับมาดูอีกครั้งเร็วๆ นี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu liste için AppleVis web sitesinde küçük bir güncelleme gerekiyor. Güncelleme bitince liste kendiliğinden dolacak, bu yüzden yakında tekrar bakın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для цього списку потрібне невелике оновлення сайту AppleVis. Він заповниться сам, щойно оновлення буде готове, тож загляньте згодом."
          }
        },
        "vi" : {

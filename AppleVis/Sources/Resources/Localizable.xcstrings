    "We do not use third-party advertising networks or sell your data to advertisers." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا نستخدم شبكات إعلانات خارجية ولا نبيع بياناتك للمعلنين."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir nutzen keine Werbenetzwerke von Drittanbietern und verkaufen deine Daten nicht an Werbetreibende."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν χρησιμοποιούμε διαφημιστικά δίκτυα τρίτων και δεν πουλάμε τα δεδομένα σας σε διαφημιστές."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No usamos redes publicitarias de terceros ni vendemos tus datos a anunciantes."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "از شبکه‌های تبلیغاتی شخص ثالث استفاده نمی‌کنیم و داده‌های شما را به تبلیغ‌کنندگان نمی‌فروشیم."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous n'utilisons aucun réseau publicitaire tiers et ne vendons pas vos données à des annonceurs."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "איננו משתמשים ברשתות פרסום של צד שלישי ואיננו מוכרים את המידע שלך למפרסמים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हम तीसरे पक्ष के विज्ञापन नेटवर्क इस्तेमाल नहीं करते और आपका डेटा विज्ञापनदाताओं को नहीं बेचते।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kami tidak menggunakan jaringan iklan pihak ketiga dan tidak menjual data Anda kepada pengiklan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non usiamo reti pubblicitarie di terze parti e non vendiamo i tuoi dati agli inserzionisti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サードパーティの広告ネットワークは使わず、データを広告主に販売することもありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "타사 광고 네트워크를 사용하지 않으며 데이터를 광고주에게 판매하지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We gebruiken geen advertentienetwerken van derden en verkopen je gegevens niet aan adverteerders."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie korzystamy z zewnętrznych sieci reklamowych ani nie sprzedajemy Twoich danych reklamodawcom."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não usamos redes de anúncios de terceiros nem vendemos seus dados a anunciantes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мы не используем сторонние рекламные сети и не продаём ваши данные рекламодателям."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi använder inga annonsnätverk från tredje part och säljer inte din data till annonsörer."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เราไม่ใช้เครือข่ายโฆษณาของบุคคลที่สามและไม่ขายข้อมูลของคุณให้ผู้ลงโฆษณา"

    "Check the App Store listing and choose which AppleVis details to refresh." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحقق من صفحة App Store واختر تفاصيل AppleVis التي تريد تحديثها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüft den App Store-Eintrag und lässt dich auswählen, welche AppleVis-Details aktualisiert werden sollen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ελέγχει την καταχώριση στο App Store και σου επιτρέπει να επιλέξεις ποια στοιχεία του AppleVis θα ανανεωθούν."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revisa la ficha de la App Store y te permite elegir qué detalles de AppleVis actualizar."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فهرست App Store را بررسی می‌کند و به شما امکان می‌دهد انتخاب کنید کدام جزئیات AppleVis تازه‌سازی شود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifie la fiche App Store et vous permet de choisir les détails AppleVis à actualiser."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בודק את הרישום ב-App Store ומאפשר לך לבחור אילו פרטים ב-AppleVis לרענן."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store लिस्टिंग जाँचता है और आपको यह चुनने देता है कि AppleVis के कौन-से विवरण रीफ़्रेश करने हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memeriksa listingan App Store dan membiarkan Anda memilih detail AppleVis mana yang akan disegarkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controlla la scheda dell'App Store e ti permette di scegliere quali dettagli di AppleVis aggiornare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Storeの掲載情報を確認し、更新するAppleVisの詳細を選択できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store 등록 정보를 확인하고 새로고침할 AppleVis 세부정보를 선택할 수 있게 해줍니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controleert de App Store-vermelding en laat je kiezen welke AppleVis-details worden vernieuwd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprawdza wpis w App Store i pozwala wybrać, które szczegóły AppleVis odświeżyć."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifica a ficha da App Store e permite que você escolha quais detalhes do AppleVis atualizar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проверяет карточку в App Store и позволяет выбрать, какие сведения AppleVis обновить."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontrollerar App Store-listningen och låter dig välja vilka AppleVis-detaljer som ska uppdateras."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตรวจสอบข้อมูลบน App Store และให้คุณเลือกรายละเอียดของ AppleVis ที่จะรีเฟรช"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store listesini kontrol eder ve hangi AppleVis ayrıntılarının yenileneceğini seçmenizi sağlar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перевіряє опис в App Store і дає змогу вибрати, які відомості AppleVis оновити."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiểm tra thông tin trên App Store và cho phép bạn chọn chi tiết nào của AppleVis cần làm mới."
          }

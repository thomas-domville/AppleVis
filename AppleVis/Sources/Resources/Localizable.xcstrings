        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يضبط توازن تردد الصوت. عادةً ما يكون وضوح الكلام هو الأفضل للبودكاست الحواري."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passt die Frequenzbalance des Audios an. Sprachklarheit eignet sich meist am besten für gesprochene Podcasts."
          }

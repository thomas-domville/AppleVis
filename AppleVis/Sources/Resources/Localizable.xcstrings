        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bài đăng AppleVis phải bằng tiếng Anh. Vui lòng dùng Dịch hoặc chỉnh sửa bản nháp bằng tiếng Anh trước khi đăng."

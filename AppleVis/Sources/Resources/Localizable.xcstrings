        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오디오 주파수 균형을 조정합니다. 말 위주의 팟캐스트에는 대개 음성 선명도가 가장 적합합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Past de frequentiebalans van de audio aan. Spraakhelderheid is meestal het beste voor gesproken podcasts."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostosowuje równowagę częstotliwości dźwięku. Klarowność mowy zwykle sprawdza się najlepiej w podcastach mówionych."

    "You're offline. Connect to Wi-Fi or cellular to see what you're following." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أنت غير متصل. اتصل بشبكة Wi-Fi أو الشبكة الخلوية لرؤية ما تتابعه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bist offline. Stelle eine WLAN- oder Mobilfunkverbindung her, um zu sehen, was du abonniert hast."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Είστε εκτός σύνδεσης. Συνδεθείτε σε Wi-Fi ή δίκτυο κινητής για να δείτε τι ακολουθείτε."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No tienes conexión. Conéctate a Wi-Fi o a datos móviles para ver lo que sigues."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آفلاین هستید. برای دیدن آنچه دنبال می‌کنید به Wi-Fi یا شبکهٔ همراه وصل شوید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous êtes hors ligne. Connectez-vous au Wi-Fi ou au réseau cellulaire pour voir ce que vous suivez."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אתה במצב לא מקוון. התחבר ל-Wi-Fi או לרשת סלולרית כדי לראות אחרי מה אתה עוקב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप ऑफ़लाइन हैं। आप क्या फ़ॉलो कर रहे हैं देखने के लिए Wi-Fi या सेल्युलर से कनेक्ट करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda sedang offline. Sambungkan ke Wi-Fi atau seluler untuk melihat yang Anda ikuti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sei offline. Connettiti al Wi-Fi o alla rete cellulare per vedere cosa segui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフラインです。フォロー中の項目を見るには Wi-Fi またはモバイル通信に接続してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오프라인 상태입니다. 팔로우 중인 항목을 보려면 Wi-Fi 또는 셀룰러에 연결하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je bent offline. Maak verbinding met wifi of mobiel netwerk om te zien wat je volgt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jesteś offline. Połącz się z Wi-Fi lub siecią komórkową, aby zobaczyć obserwowane elementy."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você está offline. Conecte-se ao Wi-Fi ou à rede celular para ver o que você segue."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы не в сети. Подключитесь к Wi-Fi или сотовой сети, чтобы увидеть свои подписки."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du är offline. Anslut till wifi eller mobilnät för att se det du följer."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณออฟไลน์อยู่ เชื่อมต่อ Wi-Fi หรือเครือข่ายมือถือเพื่อดูสิ่งที่คุณติดตาม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çevrimdışısınız. Takip ettiklerinizi görmek için Wi-Fi'ye veya hücresel ağa bağlanın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ви офлайн. Під’єднайтеся до Wi-Fi або мобільної мережі, щоб побачити, що ви відстежуєте."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn đang ngoại tuyến. Hãy kết nối Wi-Fi hoặc mạng di động để xem những gì bạn theo dõi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {

    "iOS will ask you to confirm — this only sends alerts for what you turned on above, and you can change it anytime in Settings." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيطلب منك iOS التأكيد — يرسل هذا تنبيهات فقط لما فعّلته أعلاه، ويمكنك تغييره في أي وقت من الإعدادات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS wird dich um Bestätigung bitten — dies sendet nur Benachrichtigungen für das, was du oben aktiviert hast, und du kannst es jederzeit in den Einstellungen ändern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το iOS θα σας ζητήσει να επιβεβαιώσετε — αυτό στέλνει ειδοποιήσεις μόνο για όσα ενεργοποιήσατε παραπάνω, και μπορείτε να το αλλάξετε ανά πάσα στιγμή στις Ρυθμίσεις."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS te pedirá que confirmes — esto solo envía avisos de lo que activaste arriba, y puedes cambiarlo en cualquier momento en Configuración."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سیستم‌عامل iOS از شما تأیید می‌خواهد — این فقط برای مواردی که در بالا روشن کرده‌اید هشدار می‌فرستد و می‌توانید هر زمان آن را از تنظیمات تغییر دهید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS vous demandera de confirmer — cela n'envoie des alertes que pour ce que vous avez activé ci-dessus, et vous pouvez le modifier à tout moment dans les Réglages."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS יבקש ממך לאשר — זה שולח התראות רק עבור מה שהפעלת למעלה, ואפשר לשנות זאת בכל עת בהגדרות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS आपसे पुष्टि करने के लिए कहेगा — यह केवल उन्हीं चीज़ों के लिए अलर्ट भेजता है जिन्हें आपने ऊपर चालू किया है, और आप इसे कभी भी सेटिंग्स में बदल सकते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS akan meminta Anda mengonfirmasi — ini hanya mengirim peringatan untuk yang Anda aktifkan di atas, dan Anda dapat mengubahnya kapan saja di Pengaturan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS ti chiederà di confermare — questo invia avvisi solo per ciò che hai attivato sopra, e puoi cambiarlo in qualsiasi momento nelle Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOSから確認を求められます——これは上でオンにした項目のアラートのみを送信するもので、設定からいつでも変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS에서 확인을 요청합니다 — 이는 위에서 켠 항목에 대해서만 알림을 보내며, 언제든지 설정에서 변경할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS zal je vragen om te bevestigen — dit stuurt alleen meldingen voor wat je hierboven hebt aangezet, en je kunt dit op elk moment wijzigen in Instellingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS poprosi Cię o potwierdzenie — wysyła to powiadomienia tylko dla tego, co włączyłeś powyżej, i możesz to zmienić w dowolnym momencie w Ustawieniach."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O iOS vai pedir que você confirme — isso só envia alertas para o que você ativou acima, e você pode alterar isso a qualquer momento em Configurações."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS попросит вас подтвердить — это отправляет уведомления только для того, что вы включили выше, и вы можете изменить это в любое время в Настройках."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS kommer att be dig bekräfta — det här skickar bara aviseringar för det du slog på ovan, och du kan ändra det när som helst i Inställningar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS จะขอให้คุณยืนยัน — สิ่งนี้จะส่งการแจ้งเตือนเฉพาะสิ่งที่คุณเปิดไว้ด้านบนเท่านั้น และคุณสามารถเปลี่ยนได้ทุกเมื่อในการตั้งค่า"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS onaylamanızı isteyecek — bu yalnızca yukarıda açtığınız şeyler için uyarı gönderir ve bunu istediğiniz zaman Ayarlar'dan değiştirebilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS попросить вас підтвердити — це надсилає сповіщення лише для того, що ви увімкнули вище, і ви можете змінити це будь-коли в Налаштуваннях."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS sẽ yêu cầu bạn xác nhận — điều này chỉ gửi cảnh báo cho những gì bạn đã bật ở trên, và bạn có thể thay đổi bất cứ lúc nào trong Cài đặt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS 会要求你确认——这只会为你在上面开启的项目发送提醒，你可以随时在设置中更改。"
          }
        }
      }
    },

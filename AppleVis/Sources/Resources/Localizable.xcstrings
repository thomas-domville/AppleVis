    "AppleVis collects your email address and username for your account, and a device push token for notifications." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يجمع AppleVis بريدك الإلكتروني واسم المستخدم لحسابك، ورمز الإشعارات الفورية لجهازك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleVis erfasst deine E-Mail-Adresse und deinen Benutzernamen für dein Konto sowie ein Push-Token deines Geräts für Benachrichtigungen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το AppleVis συλλέγει το email και το όνομα χρήστη σας για τον λογαριασμό, καθώς και ένα διακριτικό push της συσκευής για ειδοποιήσεις."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleVis recopila tu correo electrónico y tu nombre de usuario para tu cuenta, y un token push del dispositivo para las notificaciones."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleVis ایمیل و نام کاربری شما را برای حساب و یک توکن اعلان فوری دستگاه را برای اعلان‌ها جمع‌آوری می‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleVis collecte votre adresse e-mail et votre nom d'utilisateur pour votre compte, ainsi qu'un jeton push de l'appareil pour les notifications."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleVis אוסף את כתובת הדוא\"ל ושם המשתמש שלך עבור החשבון, ואסימון push של המכשיר עבור התראות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleVis आपके खाते के लिए आपका ईमेल पता और उपयोगकर्ता नाम, और सूचनाओं के लिए डिवाइस का पुश टोकन इकट्ठा करता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleVis mengumpulkan alamat email dan nama pengguna untuk akun Anda, serta token push perangkat untuk notifikasi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleVis raccoglie l'indirizzo email e il nome utente per il tuo account e un token push del dispositivo per le notifiche."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleVis は、アカウント用にメールアドレスとユーザ名を、通知用にデバイスのプッシュトークンを収集します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleVis는 계정을 위해 이메일 주소와 사용자 이름을, 알림을 위해 기기 푸시 토큰을 수집합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",

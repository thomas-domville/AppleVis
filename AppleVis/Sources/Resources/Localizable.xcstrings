    "Automatically pauses playback after the chosen period. Useful for falling asleep while listening." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يوقف التشغيل مؤقتًا تلقائيًا بعد الفترة المختارة. مفيد للنوم أثناء الاستماع."
          }
        },
        "de" : {
          "stringUnit" : {

        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleVis gönderileri İngilizce olmalıdır. Lütfen paylaşmadan önce Çevir'i kullanın veya taslağınızı İngilizce olarak düzenleyin."
          }

        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каталог додатків AppleVis — ресурс спільноти. Прочитайте й підтвердьте наведене нижче, перш ніж додавати додаток."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Danh mục ứng dụng AppleVis là tài nguyên của cộng đồng. Hãy đọc và xác nhận các điều sau trước khi thêm ứng dụng."

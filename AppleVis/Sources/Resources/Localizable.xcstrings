    "Exits the tour. You can replay it any time from Profile." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يخرج من الجولة. يمكنك إعادة تشغيلها في أي وقت من الملف الشخصي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beendet die Tour. Du kannst sie jederzeit über „Profil“ erneut abspielen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Έξοδος από την ξενάγηση. Μπορείτε να την επαναλάβετε ανά πάσα στιγμή από το Προφίλ."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sale del recorrido. Puedes reproducirlo de nuevo en cualquier momento desde Perfil."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "از تور خارج می‌شود. می‌توانید هر زمان آن را از نمایه دوباره پخش کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quitte la visite guidée. Vous pouvez la revoir à tout moment depuis Profil."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יוצא מהסיור. תוכל לשחק אותו שוב בכל עת מהפרופיל."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "टूर से बाहर निकलता है। आप इसे किसी भी समय प्रोफ़ाइल से फिर से चला सकते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keluar dari tur. Anda dapat memutarnya lagi kapan saja dari Profil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esce dal tour. Puoi rivederlo in qualsiasi momento da Profilo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ツアーを終了します。「プロフィール」からいつでも再生できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "둘러보기를 종료합니다. 프로필에서 언제든지 다시 재생할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verlaat de rondleiding. Je kunt deze op elk moment opnieuw afspelen vanuit Profiel."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kończy samouczek. Możesz odtworzyć go ponownie w dowolnym momencie z Profilu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sai do tour. Você pode reproduzi-lo novamente a qualquer momento em Perfil."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выходит из обзора. Вы можете просмотреть его снова в любое время в разделе «Профиль»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avslutar rundturen. Du kan spela upp den igen när som helst från Profil."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ออกจากทัวร์ คุณสามารถเล่นซ้ำได้ทุกเมื่อจากโปรไฟล์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turdan çıkar. Profil'den istediğiniz zaman tekrar oynatabilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Виходить із туру. Ви можете відтворити його знову будь-коли з розділу «Профіль»."

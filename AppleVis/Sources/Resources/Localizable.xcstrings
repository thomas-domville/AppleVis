    "Appends your app version and iOS version to help diagnose the issue." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُرفق إصدار تطبيقك وإصدار iOS للمساعدة في تشخيص المشكلة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügt deine App- und iOS-Version hinzu, um bei der Diagnose des Problems zu helfen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προσαρτά την έκδοση της εφαρμογής σας και την έκδοση iOS για να βοηθήσει στη διάγνωση του προβλήματος."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade la versión de tu app y de iOS para ayudar a diagnosticar el problema."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نسخهٔ برنامه و نسخهٔ iOS شما را برای کمک به تشخیص مشکل پیوست می‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute la version de votre appli et d'iOS pour aider à diagnostiquer le problème."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מצרף את גרסת האפליקציה וגרסת ה-iOS שלך כדי לסייע באבחון הבעיה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "समस्या के निदान में मदद के लिए आपके ऐप संस्करण और iOS संस्करण को जोड़ता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menambahkan versi aplikasi dan versi iOS Anda untuk membantu mendiagnosis masalah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allega la versione dell'app e di iOS per aiutare a diagnosticare il problema."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "問題の診断に役立つよう、アプリのバージョンと iOS のバージョンを添付します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "문제 진단에 도움이 되도록 앱 버전과 iOS 버전을 첨부합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voegt je app-versie en iOS-versie toe om te helpen bij het diagnosticeren van het probleem."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dołącza wersję Twojej aplikacji i iOS, aby pomóc zdiagnozować problem."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anexa a versão do seu app e do iOS para ajudar a diagnosticar o problema."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавляет версию приложения и iOS, чтобы помочь диагностировать проблему."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bifogar din appversion och iOS-version för att hjälpa till att diagnostisera problemet."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แนบเวอร์ชันแอปและเวอร์ชัน iOS ของคุณเพื่อช่วยวินิจฉัยปัญหา"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sorunu teşhis etmeye yardımcı olmak için uygulama sürümünüzü ve iOS sürümünüzü ekler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Додає версію застосунку та версію iOS, щоб допомогти діагностувати проблему."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đính kèm phiên bản ứng dụng và phiên bản iOS của bạn để giúp chẩn đoán sự cố."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "附加您的应用版本和 iOS 版本，以帮助诊断问题。"
          }
        }
      }
    },
    "Appends your app version, device, and accessibility settings (like VoiceOver) to help diagnose the issue." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُلحق إصدار التطبيق والجهاز وإعدادات إمكانية الوصول (مثل VoiceOver) للمساعدة في تشخيص المشكلة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügt deine App-Version, dein Gerät und Bedienungshilfen-Einstellungen (wie VoiceOver) hinzu, um die Diagnose zu erleichtern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προσθέτει την έκδοση της εφαρμογής, τη συσκευή και τις ρυθμίσεις προσβασιμότητας (όπως το VoiceOver) για να βοηθήσει στη διάγνωση του προβλήματος."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade la versión de la app, el dispositivo y la configuración de accesibilidad (como VoiceOver) para ayudar a diagnosticar el problema."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نسخهٔ برنامه، دستگاه، و تنظیمات دسترس‌پذیری (مانند VoiceOver) را برای کمک به تشخیص مشکل اضافه می‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute la version de l'appli, l'appareil et les réglages d'accessibilité (comme VoiceOver) pour aider à diagnostiquer le problème."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מוסיף את גרסת האפליקציה, המכשיר והגדרות הנגישות (כמו VoiceOver) כדי לסייע באבחון הבעיה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "समस्या का निदान करने में मदद के लिए आपका ऐप वर्शन, डिवाइस, और एक्सेसिबिलिटी सेटिंग्स (जैसे VoiceOver) जोड़ता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menambahkan versi aplikasi, perangkat, dan pengaturan aksesibilitas (seperti VoiceOver) untuk membantu mendiagnosis masalah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiunge la versione dell'app, il dispositivo e le impostazioni di accessibilità (come VoiceOver) per aiutare a diagnosticare il problema."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリのバージョン、デバイス、アクセシビリティ設定（VoiceOverなど）を追加し、問題の診断に役立てます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "문제 진단에 도움이 되도록 앱 버전, 기기, 접근성 설정(예: VoiceOver)을 추가합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voegt je app-versie, apparaat en toegankelijkheidsinstellingen (zoals VoiceOver) toe om het probleem te helpen diagnosticeren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaje wersję aplikacji, urządzenie i ustawienia ułatwień dostępu (takie jak VoiceOver), aby pomóc zdiagnozować problem."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adiciona a versão do app, o dispositivo e as configurações de acessibilidade (como o VoiceOver) para ajudar a diagnosticar o problema."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавляет версию приложения, устройство и настройки специальных возможностей (например, VoiceOver), чтобы помочь диагностировать проблему."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lägger till din appversion, enhet och tillgänglighetsinställningar (som VoiceOver) för att hjälpa till att diagnostisera problemet."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เพิ่มเวอร์ชันแอป อุปกรณ์ และการตั้งค่าการช่วยการเข้าถึง (เช่น VoiceOver) เพื่อช่วยวินิจฉัยปัญหา"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sorunu teşhis etmeye yardımcı olmak için uygulama sürümünüzü, cihazınızı ve erişilebilirlik ayarlarınızı (VoiceOver gibi) ekler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Додає версію застосунку, пристрій і налаштування спеціальних можливостей (наприклад, VoiceOver), щоб допомогти діагностувати проблему."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thêm phiên bản ứng dụng, thiết bị và cài đặt trợ năng (như VoiceOver) để giúp chẩn đoán sự cố."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "附加你的应用版本、设备和辅助功能设置（如 VoiceOver），以帮助诊断问题。"

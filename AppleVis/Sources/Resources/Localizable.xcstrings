    "Swipe up or down to switch between the latest and the most recommended apps." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسحب لأعلى أو لأسفل للتبديل بين أحدث التطبيقات والأكثر توصية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Streiche nach oben oder unten, um zwischen den neuesten und den am häufigsten empfohlenen Apps zu wechseln."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σαρώστε προς τα πάνω ή κάτω για εναλλαγή ανάμεσα στις πιο πρόσφατες και στις εφαρμογές με τις περισσότερες συστάσεις."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desliza hacia arriba o hacia abajo para cambiar entre las apps más recientes y las más recomendadas."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای جابه‌جایی بین جدیدترین و پرتوصیه‌ترین برنامه‌ها، به بالا یا پایین بکشید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balayez vers le haut ou le bas pour passer des applis récentes aux plus recommandées."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "החלק למעלה או למטה כדי לעבור בין האפליקציות האחרונות לבין המומלצות ביותר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नवीनतम और सबसे ज़्यादा अनुशंसित ऐप्स के बीच बदलने के लिए ऊपर या नीचे स्वाइप करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gesek ke atas atau ke bawah untuk beralih antara aplikasi terbaru dan yang paling direkomendasikan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scorri in alto o in basso per passare dalle app più recenti a quelle più consigliate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上下にスワイプして、最新のアプリとおすすめ数の多いアプリを切り替えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "위나 아래로 쓸어서 최신 앱과 가장 많이 추천된 앱 사이를 전환합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veeg omhoog of omlaag om te wisselen tussen de nieuwste en de meest aanbevolen apps."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przesuń w górę lub w dół, aby przełączać między najnowszymi i najczęściej polecanymi aplikacjami."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deslize para cima ou para baixo para alternar entre os apps mais recentes e os mais recomendados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",

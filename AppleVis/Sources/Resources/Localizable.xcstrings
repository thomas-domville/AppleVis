    "Change these in iOS Settings → Accessibility. AppleVis detects and respects them automatically." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "غيّر هذه في إعدادات iOS → إمكانية الوصول. يكتشفها AppleVis ويحترمها تلقائيًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ändere diese in den iOS-Einstellungen → Bedienungshilfen. AppleVis erkennt und berücksichtigt sie automatisch."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αλλάξτε αυτά στις Ρυθμίσεις iOS → Προσβασιμότητα. Το AppleVis τα εντοπίζει και τα σέβεται αυτόματα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia estos ajustes en Configuración de iOS → Accesibilidad. AppleVis los detecta y respeta automáticamente."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این‌ها را در تنظیمات iOS ← دسترس‌پذیری تغییر دهید. AppleVis آن‌ها را به‌طور خودکار تشخیص داده و رعایت می‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modifiez ces réglages dans Réglages iOS → Accessibilité. AppleVis les détecte et les respecte automatiquement."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שנה אותם בהגדרות iOS ← נגישות. AppleVis מזהה ומכבדת אותם אוטומטית."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इन्हें iOS सेटिंग्स → सुलभता में बदलें। AppleVis इन्हें स्वचालित रूप से पहचानता और सम्मान करता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ubah ini di Pengaturan iOS → Aksesibilitas. AppleVis mendeteksi dan menghormatinya secara otomatis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modifica queste impostazioni in Impostazioni iOS → Accessibilità. AppleVis le rileva e le rispetta automaticamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらは「iOS 設定」→「アクセシビリティ」で変更できます。AppleVis はそれらを自動的に検出して反映します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS 설정 → 손쉬운 사용에서 이 항목을 변경하세요. AppleVis는 이를 자동으로 감지하고 따릅니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wijzig deze in iOS-instellingen → Toegankelijkheid. AppleVis detecteert en respecteert ze automatisch."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmień je w Ustawieniach iOS → Ułatwienia dostępu. AppleVis automatycznie je wykrywa i respektuje."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altere-os em Ajustes do iOS → Acessibilidade. A AppleVis os detecta e respeita automaticamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Измените их в настройках iOS → Специальные возможности. AppleVis автоматически распознаёт и учитывает их."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ändra dessa i iOS-inställningar → Hjälpmedel. AppleVis upptäcker och respekterar dem automatiskt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เปลี่ยนสิ่งเหล่านี้ในการตั้งค่า iOS → การช่วยการเข้าถึง AppleVis จะตรวจจับและปฏิบัติตามโดยอัตโนมัติ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bunları iOS Ayarları → Erişilebilirlik'ten değiştirin. AppleVis bunları otomatik olarak algılar ve uygular."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Змініть їх у Налаштуваннях iOS → Спеціальні можливості. AppleVis автоматично визначає та враховує їх."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thay đổi các mục này trong Cài đặt iOS → Trợ năng. AppleVis tự động phát hiện và tuân theo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在“iOS 设置”→“辅助功能”中更改这些设置。AppleVis 会自动检测并遵循它们。"
          }
        }
      }
    },
    "Change this anytime in Settings > Privacy." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {

        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seletores deslizáveis anunciam o que você escolheu"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пролистываемые переключатели озвучивают ваш выбор"

    "Your message appears to be in another language. AppleVis is an English community — would you like to translate it before posting?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your message appears to be in another language. AppleVis is an English community — would you like to translate it before posting?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu mensaje parece estar en otro idioma. AppleVis es una comunidad en inglés — ¿deseas traducirlo antes de publicar?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre message semble être dans une autre langue. AppleVis est une communauté en anglais — souhaitez-vous le traduire avant de publier ?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Nachricht scheint in einer anderen Sprache verfasst zu sein. AppleVis ist eine englischsprachige Community — möchtest du sie vor dem Posten übersetzen?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua mensagem parece estar em outro idioma. AppleVis é uma comunidade em inglês — deseja traduzi-la antes de publicar?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo messaggio sembra essere in un'altra lingua. AppleVis è una community in inglese — vuoi tradurlo prima di pubblicare?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メッセージが他の言語で書かれているようです。AppleVisは英語のコミュニティです。投稿前に英語に翻訳しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메시지가 다른 언어로 작성된 것 같습니다. AppleVis는 영어 커뮤니티입니다. 게시 전에 영어로 번역하시겠습니까?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bericht lijkt in een andere taal te zijn. AppleVis is een Engelstalige gemeenschap — wil je het vertalen voor je plaatst?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的消息似乎是用其他语言编写的。AppleVis是英语社区，您是否希望在发布前将其翻译成英文？"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبدو أن رسالتك مكتوبة بلغة أخرى. AppleVis مجتمع يعمل باللغة الإنجليزية — هل تريد ترجمتها قبل النشر؟"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका संदेश किसी अन्य भाषा में लिखा लगता है। AppleVis एक अंग्रेज़ी समुदाय है — क्या आप पोस्ट करने से पहले इसका अनुवाद करना चाहते हैं?"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "به نظر می‌رسد پیام شما به زبان دیگری نوشته شده است. AppleVis یک جامعه انگلیسی‌زبان است — آیا می‌خواهید قبل از انتشار آن را ترجمه کنید؟"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваше сообщение написано не на английском. AppleVis требует публикации на английском языке — нажмите, чтобы открыть Google Переводчик."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesajınız İngilizce dışında bir dilde yazılmış gibi görünüyor. AppleVis, İngilizce yayınlamayı gerektirir — Google Translate'i açmak için dokunun."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoja wiadomość wydaje się być napisana w języku innym niż angielski. AppleVis wymaga publikowania po angielsku — dotknij, aby otworzyć Google Translate."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt meddelande verkar vara på ett annat språk än engelska. AppleVis kräver inlägg på engelska — tryck för att öppna Google Translate."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההודעה שלך נראית כתובה בשפה שאינה אנגלית. AppleVis מחייב פרסום באנגלית — הקש כדי לפתוח את Google Translate."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesan Anda tampaknya ditulis dalam bahasa selain bahasa Inggris. AppleVis mengharuskan postingan dalam bahasa Inggris — ketuk untuk membuka Google Translate."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tin nhắn của bạn có vẻ được viết bằng ngôn ngữ khác tiếng Anh. AppleVis yêu cầu đăng bài bằng tiếng Anh — nhấn để mở Google Dịch."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваше повідомлення написано не англійською. AppleVis вимагає публікацій англійською мовою — натисніть, щоб відкрити Google Перекладач."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το μήνυμά σας φαίνεται να είναι σε γλώσσα άλλη από τα αγγλικά. Το AppleVis απαιτεί δημοσιεύσεις στα αγγλικά — πατήστε για να ανοίξετε το Google Translate."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อความของคุณดูเหมือนเขียนในภาษาอื่นที่ไม่ใช่ภาษาอังกฤษ AppleVis ต้องการโพสต์เป็นภาษาอังกฤษ — แตะเพื่อเปิด Google แปลภาษา"
          }
        }
      }
    },

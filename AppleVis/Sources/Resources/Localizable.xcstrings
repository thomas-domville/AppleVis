        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وقتی روشن است، زبان ملایم‌تر هم به‌صورت ستاره‌دار نمایش داده می‌شود، مثل s ستاره ستاره ستاره، به‌جای نوشتن کامل."

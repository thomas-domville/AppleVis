    "Notifies you about new activity in topics you're following." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُخطرك بالنشاط الجديد في المواضيع التي تتابعها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benachrichtigt dich über neue Aktivitäten in Themen, denen du folgst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σας ειδοποιεί για νέα δραστηριότητα σε θέματα που ακολουθείτε."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te notifica sobre la actividad nueva en los temas que sigues."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "از فعالیت جدید در موضوعاتی که دنبال می‌کنید به شما اطلاع می‌دهد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avertit de la nouvelle activité dans les sujets que vous suivez."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מודיע לך על פעילות חדשה בנושאים שאתה עוקב אחריהם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके फ़ॉलो किए गए विषयों में नई गतिविधि के बारे में सूचित करता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memberi tahu Anda tentang aktivitas baru dalam topik yang Anda ikuti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti avvisa della nuova attività negli argomenti che segui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フォロー中のトピックの新しいアクティビティについて通知します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "팔로우 중인 주제의 새 활동을 알려줍니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meldt je over nieuwe activiteit in onderwerpen die je volgt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Powiadamia Cię o nowej aktywności w obserwowanych wątkach."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notifica você sobre nova atividade nos tópicos que você segue."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уведомляет вас о новой активности в темах, на которые вы подписаны."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meddelar dig om ny aktivitet i ämnen du följer."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แจ้งเตือนคุณเกี่ยวกับกิจกรรมใหม่ในหัวข้อที่คุณติดตาม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Takip ettiğiniz konulardaki yeni etkinlik hakkında sizi bilgilendirir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повідомляє вас про нову активність у темах, на які ви підписані."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thông báo cho bạn về hoạt động mới trong các chủ đề bạn đang theo dõi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通知您所关注话题的新活动。"
          }
        }
      }
    },
    "Notifies you about new comments anywhere on AppleVis, not just things you follow. This one can get chatty." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُخطرك بالتعليقات الجديدة في أي مكان على AppleVis، وليس فقط ما تتابعه. قد يكون هذا كثيرًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benachrichtigt dich über neue Kommentare überall auf AppleVis, nicht nur bei Dingen, denen du folgst. Das kann geschwätzig werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σας ειδοποιεί για νέα σχόλια οπουδήποτε στο AppleVis, όχι μόνο για πράγματα που ακολουθείτε. Αυτό μπορεί να γίνει πολύ συχνό."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te notifica sobre comentarios nuevos en cualquier parte de AppleVis, no solo en lo que sigues. Esta opción puede ser muy activa."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "از دیدگاه‌های جدید در هرجای AppleVis به شما اطلاع می‌دهد، نه فقط مواردی که دنبال می‌کنید. این می‌تواند پرحرف باشد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avertit des nouveaux commentaires n'importe où sur AppleVis, pas seulement sur ce que vous suivez. Celui-ci peut être bavard."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מודיע לך על תגובות חדשות בכל מקום ב-AppleVis, לא רק בדברים שאתה עוקב אחריהם. זה יכול להיות מפוטפט."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleVis पर कहीं भी नई टिप्पणियों के बारे में सूचित करता है, न केवल आपके फ़ॉलो किए गए। यह बार-बार आ सकता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memberi tahu Anda tentang komentar baru di mana pun di AppleVis, tidak hanya hal yang Anda ikuti. Ini bisa cukup sering."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti avvisa dei nuovi commenti in qualsiasi punto di AppleVis, non solo sulle cose che segui. Questa può diventare piuttosto chiacchierona."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フォロー中のものだけでなく、AppleVis 上のあらゆる場所での新着コメントについて通知します。頻繁な通知になる場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "팔로우 여부와 상관없이 AppleVis 어디서든 새 댓글을 알려줍니다. 이 알림은 잦을 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meldt je over nieuwe reacties overal op AppleVis, niet alleen dingen die je volgt. Deze kan druk zijn."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Powiadamia Cię o nowych komentarzach w dowolnym miejscu AppleVis, nie tylko o rzeczach, które obserwujesz. Może to być dość częste."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notifica você sobre novos comentários em qualquer lugar da AppleVis, não apenas nas coisas que você segue. Essa pode ser bem tagarela."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уведомляет вас о новых комментариях в любом месте AppleVis, а не только там, на что вы подписаны. Может быть очень активным."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meddelar dig om nya kommentarer var som helst på AppleVis, inte bara saker du följer. Denna kan bli pratsam."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แจ้งเตือนคุณเกี่ยวกับความคิดเห็นใหม่ทุกที่ใน AppleVis ไม่ใช่แค่สิ่งที่คุณติดตาม รายการนี้อาจมีความถี่สูง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca takip ettikleriniz değil, AppleVis'in her yerindeki yeni yorumlar hakkında sizi bilgilendirir. Bu oldukça sık olabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повідомляє вас про нові коментарі будь-де на AppleVis, не лише про те, на що ви підписані. Це може бути досить часто."

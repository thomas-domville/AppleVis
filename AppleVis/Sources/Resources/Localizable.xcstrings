    "Plays a sound for everyday navigation — tab switching, picker changes, opening screens, and list refreshes." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يشغّل صوتًا للتنقل اليومي — تبديل علامات التبويب، تغييرات المنتقي، فتح الشاشات، وتحديثات القوائم."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spielt einen Ton für die tägliche Navigation ab – Tab-Wechsel, Änderungen in Auswahllisten, Bildschirme öffnen und Listenaktualisierungen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αναπαράγει έναν ήχο για την καθημερινή πλοήγηση — αλλαγή καρτέλας, αλλαγές επιλογέα, άνοιγμα οθονών και ανανεώσεις λιστών."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproduce un sonido para la navegación cotidiana: cambio de pestañas, cambios de selector, apertura de pantallas y actualizaciones de listas."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صدایی برای پیمایش روزمره پخش می‌کند — جابه‌جایی برگه، تغییر انتخابگر، باز کردن صفحه‌ها و به‌روزرسانی فهرست‌ها."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Émet un son pour la navigation quotidienne — changement d'onglet, changements de sélecteur, ouverture d'écrans et actualisations de listes."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "משמיע צליל לניווט יומיומי — מעבר בין לשוניות, שינויי בורר, פתיחת מסכים ורענון רשימות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रोज़मर्रा के नेविगेशन के लिए ध्वनि बजाता है — टैब बदलना, पिकर परिवर्तन, स्क्रीन खोलना, और सूची रिफ़्रेश。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memutar suara untuk navigasi sehari-hari — pergantian tab, perubahan pemilih, membuka layar, dan penyegaran daftar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riproduce un suono per la navigazione quotidiana: cambio di scheda, modifiche al selettore, apertura di schermate e aggiornamenti degli elenchi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日常的なナビゲーション（タブの切り替え、ピッカーの変更、画面表示、リストの更新）でサウンドを再生します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일상적인 탐색을 위한 소리를 재생합니다 — 탭 전환, 선택기 변경, 화면 열기, 목록 새로 고침."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speelt een geluid af voor dagelijkse navigatie — tabbladwisselingen, kiezerwijzigingen, schermen openen en lijstvernieuwingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odtwarza dźwięk podczas codziennej nawigacji — przełączanie kart, zmiany selektora, otwieranie ekranów i odświeżanie list."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproduz um som para a navegação cotidiana — troca de abas, mudanças de seletor, abertura de telas e atualizações de listas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Воспроизводит звук для повседневной навигации — переключение вкладок, изменения в выборах, открытие экранов и обновление списков."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spelar upp ett ljud för vardaglig navigering — fliksbyten, väljarändringar, öppning av skärmar och listuppdateringar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เล่นเสียงสำหรับการนำทางทั่วไป — การสลับแท็บ การเปลี่ยนตัวเลือก การเปิดหน้าจอ และการรีเฟรชลิสต์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Günlük gezinme için ses çalar — sekme değiştirme, seçici değişiklikleri, ekran açma ve liste yenilemeleri."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відтворює звук для повсякденної навігації — перемикання вкладок, зміни в селекторах, відкриття екранів і оновлення списків."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phát âm thanh cho điều hướng hàng ngày — chuyển thẻ, thay đổi bộ chọn, mở màn hình và làm mới danh sách."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为日常导航播放音效——切换标签页、选择器更改、打开屏幕以及列表刷新。"
          }
        }
      }
    },
    "Plays a sound for moments worth noticing — saving, downloads finishing, notifications, and podcast play and pause." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يشغّل صوتًا للحظات الجديرة بالملاحظة — الحفظ، انتهاء التنزيلات، الإشعارات، وتشغيل/إيقاف البودكاست مؤقتًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spielt einen Ton für bemerkenswerte Momente ab – Speichern, abgeschlossene Downloads, Benachrichtigungen sowie Podcast-Wiedergabe/Pause."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αναπαράγει έναν ήχο για στιγμές που αξίζει να προσέξετε — αποθήκευση, ολοκλήρωση λήψεων, ειδοποιήσεις και αναπαραγωγή/παύση podcast."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproduce un sonido para momentos notables: guardar, descargas finalizadas, notificaciones y reproducción/pausa de pódcast."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صدایی برای لحظات قابل‌توجه پخش می‌کند — ذخیره، پایان بارگیری‌ها، اعلان‌ها و پخش/توقف پادکست."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Émet un son pour les moments importants — enregistrement, fin des téléchargements, notifications et lecture/pause de podcast."

          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleVis thu thập địa chỉ email và tên người dùng cho tài khoản của bạn, cùng mã thông báo đẩy của thiết bị để gửi thông báo."

    "Choose to pause and resume later, or skip the tour completely." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر الإيقاف المؤقت والمتابعة لاحقًا، أو تخطي الجولة بالكامل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entscheide dich, ob du pausieren und später fortsetzen oder die Tour ganz überspringen möchtest."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιλέξτε παύση και συνέχεια αργότερα, ή πλήρη παράλειψη της περιήγησης."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige pausar y continuar más tarde, o saltarte el recorrido por completo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "می‌توانید مکث کنید و بعدا ادامه دهید، یا کل تور را رد کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez de mettre en pause et reprendre plus tard, ou d'ignorer complètement la visite."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בחר/י להשהות ולחזור מאוחר יותר, או לדלג על הסיור לגמרי."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बाद में रोकने और फिर से शुरू करने या टूर को पूरी तरह छोड़ने में से चुनें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih untuk menjeda dan melanjutkan nanti, atau melewati tur sepenuhnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli se mettere in pausa e riprendere più tardi, oppure saltare completamente il tour."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一時停止してあとで再開するか、ツアーを完全にスキップするか選べます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일시 중지 후 나중에 다시 시작하거나, 투어를 완전히 건너뛸 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies om te pauzeren en later verder te gaan, of de rondleiding volledig over te slaan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz, czy wstrzymać i wznowić później, czy całkowicie pominąć przewodnik."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha pausar e retomar depois, ou pular o tour completamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите: приостановить и продолжить позже или полностью пропустить тур."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",

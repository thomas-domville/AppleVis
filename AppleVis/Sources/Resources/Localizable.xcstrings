    "How long to keep cached content before automatically removing it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How long to keep cached content before automatically removing it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuánto tiempo conservar el contenido en caché antes de eliminarlo automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Durée de conservation du contenu mis en cache avant suppression automatique."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie lange gecachte Inhalte aufbewahrt werden, bevor sie automatisch gelöscht werden."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Por quanto tempo manter o conteúdo em cache antes de removê-lo automaticamente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per quanto tempo conservare i contenuti nella cache prima di rimuoverli automaticamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャッシュコンテンツを自動削除するまでの保持期間。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동 삭제 전에 캐시된 콘텐츠를 보존하는 기간."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoe lang gecachte inhoud bewaard wordt voor automatisch verwijderen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缓存内容自动删除前的保留时长。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المدة التي يتم فيها الاحتفاظ بالمحتوى المخزَّن مؤقتاً قبل حذفه تلقائياً."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्वचालित रूप से हटाए जाने से पहले कैश की गई सामग्री कितनी देर रखी जाए।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مدت زمانی که محتوای ذخیره‌شده در حافظه پنهان قبل از حذف خودکار نگهداری می‌شود."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как долго хранить кэшированный контент перед автоматическим удалением."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önbelleğe alınan içeriğin otomatik silinmeden önce ne kadar süre saklanacağı."
          }
        },
        "pl": {

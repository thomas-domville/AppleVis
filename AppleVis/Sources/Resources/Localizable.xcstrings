    "Answer a few questions and get a draft bio you can edit." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أجب عن بعض الأسئلة واحصل على مسودة سيرة ذاتية يمكنك تعديلها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beantworte ein paar Fragen und erhalte einen bearbeitbaren Entwurf für deine Biografie."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Απαντήστε σε μερικές ερωτήσεις και λάβετε ένα προσχέδιο βιογραφικού που μπορείτε να επεξεργαστείτε."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Responde algunas preguntas y obtén un borrador de biografía que puedes editar."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "به چند پرسش پاسخ دهید و پیش‌نویس بیوگرافی‌ای دریافت کنید که می‌توانید ویرایش کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Répondez à quelques questions pour obtenir une ébauche de bio que vous pourrez modifier."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ענה על כמה שאלות וקבל טיוטת ביוגרפיה שתוכל לערוך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कुछ प्रश्नों के उत्तर दें और एक ड्राफ़्ट बायो प्राप्त करें जिसे आप संपादित कर सकते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jawab beberapa pertanyaan dan dapatkan draf bio yang dapat Anda edit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rispondi ad alcune domande e ottieni una bozza di biografia che puoi modificare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "いくつかの質問に答えると、編集可能なプロフィール文の下書きが作成されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "몇 가지 질문에 답하면 편집 가능한 소개글 초안을 받을 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beantwoord een paar vragen en ontvang een concept-bio die je kunt bewerken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odpowiedz na kilka pytań i otrzymaj szkic biografii, który możesz edytować."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Responda a algumas perguntas e obtenha um rascunho de biografia que você pode editar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",

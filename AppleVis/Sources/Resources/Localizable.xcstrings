    "Here's your draft. You can still edit this after using it." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إليك مسودتك. لا يزال بإمكانك تعديلها بعد استخدامها."
          }
        },
        "de" : {

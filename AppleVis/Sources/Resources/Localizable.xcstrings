        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마지막으로 재생한 에피소드를 멈춘 곳부터 이어서 재생합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hervat de laatst afgespeelde aflevering waar je gebleven was."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wznawia ostatnio odtwarzany odcinek od miejsca, w którym skończyłeś."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retoma o último episódio de onde você parou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Продолжает последний прослушанный эпизод с того места, где вы остановились."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Återupptar det senast spelade avsnittet där du slutade."

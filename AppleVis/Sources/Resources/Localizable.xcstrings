            "state": "translated",
            "value": "Jak długo przechowywać zawartość pamięci podręcznej przed automatycznym usunięciem."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hur länge cachad innehåll ska sparas innan det raderas automatiskt."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כמה זמן לשמור תוכן במטמון לפני מחיקה אוטומטית."
          }
        },
        "id": {
          "stringUnit": {

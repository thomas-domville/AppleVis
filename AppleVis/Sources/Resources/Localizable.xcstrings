        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تور راهنمای صفحهٔ اصلی، کاوش، برای شما، و نمایه و تنظیمات را دوباره پخش می‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relance la visite guidée d'Accueil, Découvrir, Pour vous, et Profil et réglages."

    "Automatically appends your app version and iOS version to help diagnose the issue." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُرفق تلقائيًا إصدار تطبيقك وإصدار iOS للمساعدة في تشخيص المشكلة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügt automatisch deine App- und iOS-Version hinzu, um bei der Diagnose des Problems zu helfen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προσαρτά αυτόματα την έκδοση της εφαρμογής σας και την έκδοση iOS για να βοηθήσει στη διάγνωση του προβλήματος."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade automáticamente la versión de tu app y de iOS para ayudar a diagnosticar el problema."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نسخهٔ برنامه و نسخهٔ iOS شما را به‌طور خودکار برای کمک به تشخیص مشکل پیوست می‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute automatiquement la version de votre appli et d'iOS pour aider à diagnostiquer le problème."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מצרף אוטומטית את גרסת האפליקציה וגרסת ה-iOS שלך כדי לסייע באבחון הבעיה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "समस्या के निदान में मदद के लिए आपके ऐप संस्करण और iOS संस्करण को स्वचालित रूप से जोड़ता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Secara otomatis menambahkan versi aplikasi dan versi iOS Anda untuk membantu mendiagnosis masalah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allega automaticamente la versione dell'app e di iOS per aiutare a diagnosticare il problema."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "問題の診断に役立つよう、アプリのバージョンと iOS のバージョンを自動的に添付します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "문제 진단에 도움이 되도록 앱 버전과 iOS 버전을 자동으로 첨부합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voegt automatisch je app-versie en iOS-versie toe om te helpen bij het diagnosticeren van het probleem."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatycznie dołącza wersję Twojej aplikacji i iOS, aby pomóc zdiagnozować problem."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anexa automaticamente a versão do seu app e do iOS para ajudar a diagnosticar o problema."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Автоматически добавляет версию приложения и iOS, чтобы помочь диагностировать проблему."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bifogar automatiskt din appversion och iOS-version för att hjälpa till att diagnostisera problemet."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แนบเวอร์ชันแอปและเวอร์ชัน iOS ของคุณโดยอัตโนมัติเพื่อช่วยวินิจฉัยปัญหา"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sorunu teşhis etmeye yardımcı olmak için uygulama sürümünüzü ve iOS sürümünüzü otomatik olarak ekler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Автоматично додає версію застосунку та версію iOS, щоб допомогти діагностувати проблему."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tự động đính kèm phiên bản ứng dụng và phiên bản iOS của bạn để giúp chẩn đoán sự cố."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自动附加您的应用版本和 iOS 版本，以帮助诊断问题。"
          }
        }
      }
    },

    "Browse active accessibility bugs reported by the AppleVis community." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تصفح أخطاء إمكانية الوصول النشطة التي أبلغ عنها مجتمع AppleVis."

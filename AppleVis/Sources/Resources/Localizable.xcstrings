    "This will remove %@ of downloaded podcast episodes from this device.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This will remove %@ of downloaded podcast episodes from this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto eliminará %@ de episodios descargados de este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprimera %@ d'épisodes téléchargés de cet appareil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies löscht %@ heruntergeladener Episoden von diesem Gerät."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso removerá %@ de episódios baixados deste dispositivo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verranno rimossi %@ di episodi scaricati da questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスから%@のダウンロード済みエピソードを削除します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서 다운로드된 에피소드 %@를 제거합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit verwijdert %@ aan gedownloade afleveringen van dit apparaat."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将从此设备删除%@的已下载剧集。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيؤدي هذا إلى إزالة %@ من الحلقات المنزَّلة من هذا الجهاز."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इससे इस डिवाइस से %@ डाउनलोड किए गए एपिसोड हट जाएंगे।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این عمل %@ از قسمت‌های دانلودشده را از این دستگاه حذف می‌کند."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это удалит %@ загруженных подкастов с устройства."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işlem, cihazdan %@ indirilen podcast'i siler."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spowoduje to usunięcie %@ pobranych podcastów z urządzenia."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här raderar %@ nedladdade poddar från enheten."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פעולה זו תמחק %@ פודקאסטים שהורדו מהמכשיר."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini akan menghapus %@ podcast yang diunduh dari perangkat."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điều này sẽ xóa %@ podcast đã tải xuống khỏi thiết bị."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це видалить %@ завантажених подкастів із пристрою."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό θα διαγράψει %@ ληφθέντα podcast από τη συσκευή."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การดำเนินการนี้จะลบพอดแคสต์ที่ดาวน์โหลด %@ จากอุปกรณ์"
          }
        }
      }
    },
    "This will remove %@ of cached content. It will be re-downloaded next time you open each section.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {

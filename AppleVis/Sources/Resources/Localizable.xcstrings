    "Resumes the last-played episode from where you left off." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستأنف آخر حلقة مشغّلة من حيث توقفت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setzt die zuletzt gespielte Folge dort fort, wo du aufgehört hast."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Συνεχίζει το τελευταίο επεισόδιο από εκεί που σταματήσατε."
          }
        },
        "es" : {
          "stringUnit" : {

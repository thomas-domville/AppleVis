        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נושאים שאתה עוקב אחריהם. נשמרים מקומית ומסונכרנים דרך iCloud."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Topik yang Anda ikuti. Disimpan secara lokal dan disinkronkan melalui iCloud."

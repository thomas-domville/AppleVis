          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blendet nicht-Apple-Forumskategorien auf der Startseite aus."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αποκρύπτει κατηγορίες φόρουμ που δεν σχετίζονται με την Apple από την Αρχική."

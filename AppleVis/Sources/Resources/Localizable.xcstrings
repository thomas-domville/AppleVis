    "Follow AppleVis wherever you already hang out online, for updates outside the app." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تابع AppleVis أينما كنت متواجدًا بالفعل على الإنترنت، للحصول على التحديثات خارج التطبيق."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folge AppleVis dort, wo du ohnehin online unterwegs bist, für Updates außerhalb der App."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ακολουθήστε το AppleVis όπου κι αν βρίσκεστε ήδη online, για ενημερώσεις εκτός της εφαρμογής."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sigue a AppleVis en donde ya sueles estar en línea, para recibir novedades fuera de la app."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleVis را در هر جایی که آنلاین حضور دارید دنبال کنید تا از به‌روزرسانی‌ها خارج از برنامه مطلع شوید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suivez AppleVis là où vous êtes déjà en ligne, pour des mises à jour en dehors de l'appli."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עקוב אחר AppleVis בכל מקום שאתה כבר נמצא בו באינטרנט, לעדכונים מחוץ לאפליקציה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleVis को वहां फ़ॉलो करें जहां आप पहले से ऑनलाइन रहते हैं, ऐप के बाहर की जानकारी के लिए।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikuti AppleVis di tempat Anda biasa online, untuk pembaruan di luar aplikasi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segui AppleVis ovunque tu sia già online, per aggiornamenti al di fuori dell'app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すでにご利用のオンラインの場で AppleVis をフォローすると、アプリ外でも最新情報を受け取れます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이미 온라인에서 활동하는 곳에서 AppleVis를 팔로우하면 앱 외부에서도 소식을 받을 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volg AppleVis waar je online al actief bent, voor updates buiten de app."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obserwuj AppleVis tam, gdzie już bywasz online, aby otrzymywać aktualizacje poza aplikacją."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siga a AppleVis onde quer que você já esteja online, para atualizações fora do app."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подпишитесь на AppleVis там, где вы уже бываете онлайн, чтобы получать обновления вне приложения."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",

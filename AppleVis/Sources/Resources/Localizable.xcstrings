            "value" : "Installatie zet de focus eerst op Welkom"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konfiguracja ustawia fokus najpierw na Witaj"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A configuração foca primeiro em Boas-vindas"
          }
        },
        "ru" : {

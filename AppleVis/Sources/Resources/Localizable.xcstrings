    "Play, pause, and skip from the Lock Screen and Control Center while a podcast episode is playing." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شغّل وأوقف مؤقتًا وتخطَّ من شاشة القفل ومركز التحكم أثناء تشغيل حلقة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abspielen, pausieren und springen über den Sperrbildschirm und das Kontrollzentrum, während eine Podcast-Folge läuft."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αναπαραγωγή, παύση και μεταπήδηση από την οθόνη κλειδώματος και το Κέντρο ελέγχου ενώ παίζει ένα επεισόδιο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproduce, pausa y salta desde la pantalla bloqueada y el centro de control mientras suena un episodio."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هنگام پخش یک قسمت، از صفحهٔ قفل و مرکز کنترل پخش، توقف و پرش کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisez, mettez en pause et avancez depuis l'écran verrouillé et le centre de contrôle pendant la lecture d'un épisode."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "נגן, השהה ודלג ממסך הנעילה וממרכז הבקרה בזמן שפרק מתנגן."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एपिसोड चलते समय लॉक स्क्रीन और कंट्रोल सेंटर से चलाएं, रोकें और आगे-पीछे करें।"

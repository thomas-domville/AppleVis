    "A fresh batch of App Directory entries arrived in the %@, with practical discoveries for blind and low vision Apple users." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وصلت دفعة جديدة من الإدخالات إلى دليل التطبيقات (%@)، مع اكتشافات عملية لمستخدمي Apple المكفوفين وضعاف البصر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In %@ kam eine neue Reihe von Einträgen ins App-Verzeichnis, mit praktischen Entdeckungen für blinde und sehbehinderte Apple-Nutzer."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μια νέα σειρά καταχωρίσεων έφτασε στον Κατάλογο Εφαρμογών (%@), με πρακτικές ανακαλύψεις για τυφλούς χρήστες Apple και χρήστες με χαμηλή όραση."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Llegó una nueva tanda de entradas al directorio de apps (%@), con descubrimientos prácticos para usuarios de Apple ciegos y con baja visión."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دسته‌ای تازه از ورودی‌ها به فهرست برنامه‌ها اضافه شد (%@)، با یافته‌های کاربردی برای کاربران نابینا و کم‌بینای Apple."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une nouvelle série de fiches est arrivée dans le répertoire d'applis (%@), avec des découvertes utiles pour les personnes aveugles et malvoyantes qui utilisent Apple."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "סדרה חדשה של רשומות הגיעה לספריית האפליקציות (%@), עם תגליות מעשיות למשתמשי Apple עיוורים ולקויי ראייה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐप निर्देशिका में नई प्रविष्टियों का एक समूह आया (%@), जिसमें दृष्टिहीन और कम दृष्टि वाले Apple उपयोगकर्ताओं के लिए व्यावहारिक खोजें हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sekumpulan entri baru masuk ke Direktori Aplikasi (%@), dengan temuan praktis bagi pengguna Apple tunanetra dan low vision."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È arrivata una nuova serie di voci nella directory delle app (%@), con scoperte utili per gli utenti Apple ciechi e ipovedenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリディレクトリに新しいエントリがまとめて追加されました(%@)。視覚障害やロービジョンの Apple ユーザーに役立つ発見があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱 디렉터리에 새 항목이 대거 추가되었습니다(%@). 시각장애인과 저시력 Apple 사용자를 위한 실용적인 발견이 담겨 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er kwam een nieuwe reeks items in de app-directory (%@), met praktische ontdekkingen voor blinde en slechtziende Apple-gebruikers."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do katalogu aplikacji trafiła nowa porcja wpisów (%@) z praktycznymi odkryciami dla niewidomych i słabowidzących użytkowników Apple."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um novo lote de entradas chegou ao diretório de apps (%@), com descobertas práticas para usuários Apple cegos e com baixa visão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В каталог приложений поступила новая порция записей (%@) с полезными находками для незрячих и слабовидящих пользователей Apple."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En ny omgång poster kom till appkatalogen (%@), med praktiska upptäckter för blinda och synsvaga Apple-användare."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "มีรายการชุดใหม่ในไดเรกทอรีแอป (%@) พร้อมสิ่งที่ค้นพบที่ใช้ได้จริงสำหรับผู้ใช้ Apple ที่ตาบอดและสายตาเลือนราง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulama Dizini'ne yeni bir giriş grubu geldi (%@); görme engelli ve az gören Apple kullanıcıları için pratik keşiflerle."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "До каталогу додатків надійшла нова порція записів (%@) з корисними знахідками для незрячих і слабкозорих користувачів Apple."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một loạt mục mới đã được thêm vào Danh mục ứng dụng (%@), với những phát hiện thiết thực cho người dùng Apple khiếm thị và thị lực kém."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "应用目录新增了一批条目（%@），为盲人和低视力 Apple 用户带来实用的新发现。"
          }
        }
      }

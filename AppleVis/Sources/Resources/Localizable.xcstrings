          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleVis が最初にテストしたのはバージョン %@ です。現在の App Store のバージョンではアクセシビリティが異なる場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleVis는 원래 버전 %@을(를) 테스트했습니다. 현재 App Store 버전에서는 손쉬운 사용이 다를 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",

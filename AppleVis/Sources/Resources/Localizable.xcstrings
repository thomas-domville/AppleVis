            "state" : "translated",
            "value" : "Відображається збережений вміст. Потягніть вниз для оновлення за наявності мережі."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đang hiển thị nội dung được lưu trong bộ nhớ đệm. Kéo xuống để làm mới khi có mạng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在显示已保存的内容。联网后下拉刷新。"
          }
        }
      }
    },
    "Shown in the app directory list view, not the full review." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يظهر في عرض قائمة دليل التطبيقات، وليس في المراجعة الكاملة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird in der Listenansicht des App-Verzeichnisses angezeigt, nicht in der vollständigen Bewertung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εμφανίζεται στην προβολή λίστας του καταλόγου εφαρμογών, όχι στην πλήρη κριτική."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se muestra en la vista de lista del directorio de apps, no en la reseña completa."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "در نمای فهرست فهرست برنامه‌ها نمایش داده می‌شود، نه در بررسی کامل."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiché dans la vue de liste du répertoire d'applis, pas dans l'avis complet."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מוצג בתצוגת הרשימה של ספריית האפליקציות, לא בביקורת המלאה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐप निर्देशिका सूची दृश्य में दिखाया जाता है, पूरी समीक्षा में नहीं。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ditampilkan di tampilan daftar direktori aplikasi, bukan ulasan lengkap."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrato nella visualizzazione a elenco della directory delle app, non nella recensione completa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリディレクトリのリスト表示に表示されます。レビュー全文には表示されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전체 리뷰가 아니라 앱 디렉터리 목록 보기에 표시됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wordt getoond in de lijstweergave van de app-directory, niet in de volledige recensie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyświetlane w widoku listy katalogu aplikacji, a nie w pełnej recenzji."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exibido na visualização em lista do diretório de apps, não na avaliação completa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отображается в списке каталога приложений, а не в полном отзыве."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visas i listvyn för appkatalogen, inte hela recensionen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แสดงในมุมมองรายการไดเรกทอรีแอป ไม่ใช่รีวิวเต็ม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulama dizini liste görünümünde gösterilir, tam incelemede değil."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відображається в переліку каталогу додатків, а не в повному відгуку."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiển thị trong khung xem danh sách danh mục ứng dụng, không phải bài đánh giá đầy đủ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "显示在应用目录列表视图中，而非完整评论。"
          }
        }
      }
    },
    "Shows a dismissable card on Home summarizing new activity since your last visit." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعرض بطاقة قابلة للإغلاق على الشاشة الرئيسية تلخص النشاط الجديد منذ آخر زيارة لك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt auf der Startseite eine schließbare Karte an, die neue Aktivitäten seit deinem letzten Besuch zusammenfasst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εμφανίζει μια απορριπτόμενη κάρτα στην Αρχική που συνοψίζει τη νέα δραστηριότητα από την τελευταία σας επίσκεψη."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra una tarjeta descartable en Inicio que resume la actividad nueva desde tu última visita."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کارتی قابل‌بستن در صفحهٔ اصلی نمایش می‌دهد که فعالیت جدید از آخرین بازدید شما را خلاصه می‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche une carte ignorable sur Accueil résumant la nouvelle activité depuis votre dernière visite."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מציג כרטיס שניתן לסגור בבית שמסכם פעילות חדשה מאז הביקור האחרון שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "होम पर एक खारिज करने योग्य कार्ड दिखाता है जो आपकी अंतिम विज़िट के बाद से नई गतिविधि का सारांश देता है。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menampilkan kartu yang dapat ditutup di Beranda yang merangkum aktivitas baru sejak kunjungan terakhir Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra una scheda ignorabile su Home che riassume la nuova attività dalla tua ultima visita."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "前回の訪問以降の新しいアクティビティをまとめた、閉じることができるカードを「ホーム」に表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마지막 방문 이후 새 활동을 요약한 닫을 수 있는 카드를 홈에 표시합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toont een sluitbare kaart op Start met een samenvatting van nieuwe activiteit sinds je laatste bezoek."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokazuje możliwą do zamknięcia kartę na Stronie głównej podsumowującą nową aktywność od Twojej ostatniej wizyty."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra um cartão dispensável no Início resumindo a nova atividade desde sua última visita."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывает закрываемую карточку на «Главной», подводящую итог новой активности с момента вашего последнего посещения."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visar ett avvisningsbart kort på Hem som sammanfattar ny aktivitet sedan ditt senaste besök."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แสดงการ์ดที่ปิดได้บนหน้าแรกซึ่งสรุปกิจกรรมใหม่ตั้งแต่ครั้งล่าสุดที่คุณเข้าชม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ana Sayfa'da son ziyaretinizden bu yana yeni etkinliği özetleyen kapatılabilir bir kart gösterir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показує картку, яку можна закрити, на «Головна» з підсумком нової активності з часу вашого останнього відвідування."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiển thị thẻ có thể đóng trên Trang chủ tóm tắt hoạt động mới kể từ lần truy cập gần nhất của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在“主页”上显示可关闭的卡片，汇总自您上次访问以来的新活动。"
          }
        }
      }
    },
    "Shows a number on the AppleVis icon for unread notifications — opening the app clears it." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعرض رقمًا على أيقونة AppleVis للإشعارات غير المقروءة — يؤدي فتح التطبيق إلى مسحه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt eine Zahl auf dem AppleVis-Symbol für ungelesene Benachrichtigungen an – das Öffnen der App löscht sie."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εμφανίζει έναν αριθμό στο εικονίδιο AppleVis για μη αναγνωσμένες ειδοποιήσεις — το άνοιγμα της εφαρμογής το εκκαθαρίζει."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra un número en el icono de AppleVis para notificaciones sin leer; al abrir la app se borra."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عددی روی نماد AppleVis برای اعلان‌های نخوانده نمایش می‌دهد — باز کردن برنامه آن را پاک می‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche un nombre sur l'icône AppleVis pour les notifications non lues — l'ouverture de l'appli l'efface."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מציג מספר על סמל AppleVis עבור התראות שלא נקראו — פתיחת האפליקציה מנקה אותו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपठित सूचनाओं के लिए AppleVis आइकन पर एक संख्या दिखाता है — ऐप खोलने से यह साफ़ हो जाता है。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menampilkan angka pada ikon AppleVis untuk notifikasi belum dibaca — membuka aplikasi menghapusnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra un numero sull'icona di AppleVis per le notifiche non lette: aprire l'app lo cancella."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未読通知の数を AppleVis のアイコンに表示します。アプリを開くとクリアされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "읽지 않은 알림에 대해 AppleVis 아이콘에 숫자를 표시합니다 — 앱을 열면 사라집니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toont een getal op het AppleVis-pictogram voor ongelezen meldingen — het openen van de app wist dit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokazuje liczbę na ikonie AppleVis dla nieprzeczytanych powiadomień — otwarcie aplikacji ją czyści."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra um número no ícone da AppleVis para notificações não lidas — abrir o app o limpa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывает число на значке AppleVis для непрочитанных уведомлений — при открытии приложения оно исчезает."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visar ett tal på AppleVis-ikonen för olästa aviseringar — att öppna appen rensar det."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แสดงตัวเลขบนไอคอน AppleVis สำหรับการแจ้งเตือนที่ยังไม่ได้อ่าน — การเปิดแอปจะล้างมัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Okunmamış bildirimler için AppleVis simgesinde bir sayı gösterir — uygulamayı açmak bunu temizler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показує число на піктограмі AppleVis для непрочитаних сповіщень — відкриття застосунку очищує його."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiển thị số trên biểu tượng AppleVis cho các thông báo chưa đọc — mở ứng dụng sẽ xóa số này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 AppleVis 图标上显示未读通知数量——打开应用即可清除。"
          }
        }
      }
    },

    "Submit a blog post draft for the AppleVis editorial team to review. This does not publish immediately — an editor will follow up." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أرسل مسودة منشور مدونة ليراجعها فريق تحرير AppleVis. لن يُنشر هذا فورًا — سيتابع معك أحد المحررين."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reiche einen Blogbeitragsentwurf zur Überprüfung durch das AppleVis-Redaktionsteam ein. Dies wird nicht sofort veröffentlicht – ein Redakteur meldet sich."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Υποβάλετε ένα προσχέδιο ανάρτησης ιστολογίου για έλεγχο από τη συντακτική ομάδα του AppleVis. Αυτό δεν δημοσιεύεται αμέσως — ένας συντάκτης θα επικοινωνήσει."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envía un borrador de entrada de blog para que el equipo editorial de AppleVis lo revise. Esto no se publica de inmediato: un editor se pondrá en contacto."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پیش‌نویس پست وبلاگ را برای بررسی تیم ویرایشی AppleVis ارسال کنید. این بلافاصله منتشر نمی‌شود — ویراستاری پیگیری خواهد کرد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoyez un brouillon d'article de blog pour que l'équipe éditoriale d'AppleVis l'examine. Cela ne publie pas immédiatement — un éditeur fera un suivi."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שלח טיוטת פוסט בבלוג לבדיקה על ידי צוות העריכה של AppleVis. זה לא מתפרסם מיד — עורך יחזור אליך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleVis संपादकीय टीम की समीक्षा के लिए ब्लॉग पोस्ट ड्राफ़्ट सबमिट करें। यह तुरंत प्रकाशित नहीं होता — एक संपादक फ़ॉलो-अप करेगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirim draf postingan blog agar ditinjau oleh tim editorial AppleVis. Ini tidak langsung dipublikasikan — editor akan menindaklanjuti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invia una bozza di articolo del blog per la revisione da parte del team editoriale di AppleVis. Non viene pubblicato immediatamente: un editor ti contatterà."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ブログ記事の下書きを AppleVis 編集チームのレビュー用に送信します。これはすぐには公開されません。編集者から連絡があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleVis 편집팀이 검토할 블로그 게시물 초안을 제출합니다. 즉시 게시되지 않으며 편집자가 후속 조치를 취합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dien een concept-blogbericht in ter beoordeling door het redactieteam van AppleVis. Dit wordt niet direct gepubliceerd — een redacteur neemt contact op."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prześlij szkic wpisu na blogu do sprawdzenia przez zespół redakcyjny AppleVis. Nie zostanie to opublikowane od razu — redaktor się odezwie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envie um rascunho de postagem de blog para a equipe editorial da AppleVis revisar. Isso não publica imediatamente — um editor entrará em contato."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отправьте черновик записи блога на рассмотрение редакции AppleVis. Он не публикуется сразу — редактор свяжется с вами."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skicka in ett blogginläggsutkast för granskning av AppleVis redaktion. Detta publiceras inte omedelbart — en redaktör hör av sig."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ส่งร่างบทความบล็อกให้ทีมบรรณาธิการ AppleVis ตรวจสอบ การดำเนินการนี้จะไม่เผยแพร่ทันที — บรรณาธิการจะติดต่อกลับ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleVis editör ekibinin incelemesi için bir blog yazısı taslağı gönderin. Bu hemen yayınlanmaz — bir editör sizinle iletişime geçecek."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Надішліть чернетку запису блогу на розгляд редакції AppleVis. Це не публікується одразу — редактор зв'яжеться з вами."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gửi bản nháp bài viết blog để đội ngũ biên tập AppleVis xem xét. Bài viết không được đăng ngay lập tức — biên tập viên sẽ liên hệ lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提交博客文章草稿供 AppleVis 编辑团队审核。此操作不会立即发布——编辑将跟进联系。"
          }
        }
      }
    },

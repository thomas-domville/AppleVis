    "Non-Apple topics include Windows, Android, smart home tech, and general assistive technology discussions." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تشمل المواضيع غير المتعلقة بـ Apple: Windows وAndroid وتقنيات المنزل الذكي والنقاشات العامة حول التقنيات المساعدة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",

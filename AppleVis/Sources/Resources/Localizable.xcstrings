        }
      }
    },
    "I'm not the developer or publisher of this app, and I'm not otherwise connected with it. AppleVis guidelines don't allow developers to submit their own apps." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لست مطوّر هذا التطبيق أو ناشره، ولا تربطني به أي صلة أخرى. لا تسمح إرشادات AppleVis للمطوّرين بإرسال تطبيقاتهم."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich bin weder Entwickler noch Herausgeber dieser App und auch sonst nicht mit ihr verbunden. Die AppleVis-Richtlinien erlauben Entwicklern nicht, ihre eigenen Apps einzureichen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν είμαι ο προγραμματιστής ή ο εκδότης αυτής της εφαρμογής και δεν έχω άλλη σχέση μαζί της. Οι κανόνες του AppleVis δεν επιτρέπουν στους προγραμματιστές να υποβάλλουν τις δικές τους εφαρμογές."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No soy el desarrollador ni el editor de esta app, ni tengo ninguna otra relación con ella. Las normas de AppleVis no permiten a los desarrolladores enviar sus propias apps."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "توسعه‌دهنده یا ناشر این برنامه نیستم و هیچ ارتباط دیگری هم با آن ندارم. راهنمای AppleVis اجازه نمی‌دهد توسعه‌دهندگان برنامه‌های خودشان را ارسال کنند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je ne suis ni le développeur ni l'éditeur de cette appli, et je n'y suis lié d'aucune autre façon. Les règles d'AppleVis n'autorisent pas les développeurs à proposer leurs propres applis."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אני לא המפתח/ת או המפרסם/ת של האפליקציה הזו, ואין לי קשר אחר אליה. ההנחיות של AppleVis לא מאפשרות למפתחים לשלוח את האפליקציות שלהם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मैं इस ऐप का डेवलपर या प्रकाशक नहीं हूँ, और किसी और तरह से भी इससे जुड़ा/जुड़ी नहीं हूँ। AppleVis दिशानिर्देश डेवलपर को अपने ही ऐप सबमिट करने की अनुमति नहीं देते।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saya bukan pengembang atau penerbit aplikasi ini, dan tidak memiliki hubungan lain dengannya. Pedoman AppleVis tidak mengizinkan pengembang mengirim aplikasi mereka sendiri."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non sono lo sviluppatore né l'editore di questa app, e non ho altri legami con essa. Le linee guida di AppleVis non consentono agli sviluppatori di inviare le proprie app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアプリの開発者でも発行者でもなく、そのほかの関係もありません。AppleVis のガイドラインでは、開発者が自分のアプリを投稿することは認められていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 앱의 개발자나 배포자가 아니며, 그 밖의 관련도 없습니다. AppleVis 가이드라인에서는 개발자가 자신의 앱을 제출하는 것을 허용하지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ik ben niet de ontwikkelaar of uitgever van deze app en heb er ook op een andere manier niets mee te maken. De richtlijnen van AppleVis staan niet toe dat ontwikkelaars hun eigen apps indienen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie jestem twórcą ani wydawcą tej aplikacji i nie jestem z nią w żaden inny sposób powiązany. Zasady AppleVis nie pozwalają twórcom zgłaszać własnych aplikacji."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não sou o desenvolvedor nem o editor deste app, e não tenho outra ligação com ele. As diretrizes do AppleVis não permitem que desenvolvedores enviem os próprios apps."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Я не разработчик и не издатель этого приложения и никак иначе с ним не связан. Правила AppleVis не разрешают разработчикам отправлять собственные приложения."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jag är inte appens utvecklare eller utgivare och har ingen annan koppling till den. AppleVis riktlinjer tillåter inte att utvecklare skickar in sina egna appar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ฉันไม่ใช่ผู้พัฒนาหรือผู้เผยแพร่แอปนี้ และไม่มีความเกี่ยวข้องอื่นใดกับแอปนี้ แนวทางของ AppleVis ไม่อนุญาตให้ผู้พัฒนาส่งแอปของตนเอง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu uygulamanın geliştiricisi veya yayıncısı değilim ve onunla başka bir bağlantım da yok. AppleVis yönergeleri, geliştiricilerin kendi uygulamalarını göndermesine izin vermez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Я не розробник і не видавець цього додатка й ніяк інакше з ним не пов'язаний. Правила AppleVis не дозволяють розробникам надсилати власні додатки."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tôi không phải nhà phát triển hay nhà phát hành ứng dụng này, và cũng không có liên hệ nào khác với nó. Quy tắc của AppleVis không cho phép nhà phát triển gửi ứng dụng của chính mình."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我不是这个应用的开发者或发行者，也与它没有其他关联。AppleVis 准则不允许开发者提交自己的应用。"
          }
        }
      }
    },
    "Free or Paid was taken from the App Store listing. Change it if the app is free with in-app purchases or needs a subscription." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أُخذت معلومة مجاني أو مدفوع من صفحة App Store. غيّرها إن كان التطبيق يتضمن عمليات شراء داخلية أو يتطلب اشتراكًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Kostenlos“ oder „Kostenpflichtig“ wurde aus dem App-Store-Eintrag übernommen. Ändere es, wenn die App In-App-Käufe hat oder ein Abo braucht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Δωρεάν ή Επί πληρωμή πάρθηκε από τη σελίδα του App Store. Αλλάξτε το αν η εφαρμογή έχει αγορές εντός εφαρμογής ή χρειάζεται συνδρομή."
          }
        },
        "es" : {
          "stringUnit" : {

    "Refresh the details that look right. Anything you leave off will stay just as it is." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قم بتحديث التفاصيل التي تبدو صحيحة. أي شيء تتركه متوقفًا سيبقى كما هو تمامًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktualisiere die Details, die richtig aussehen. Alles, was du auslässt, bleibt genau so, wie es ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ανανέωσε τα στοιχεία που φαίνονται σωστά. Ό,τι αφήσεις ανενεργό θα παραμείνει ακριβώς όπως είναι."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actualiza los detalles que te parezcan correctos. Todo lo que dejes desactivado se quedará exactamente igual."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جزئیاتی را که درست به نظر می‌رسند تازه‌سازی کنید. هر چیزی که خاموش بگذارید دقیقاً همان‌طور که هست باقی می‌ماند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actualisez les détails qui vous semblent corrects. Tout ce que vous laissez désactivé restera exactement tel quel."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "רענן את הפרטים שנראים נכונים. כל מה שתשאיר כבוי יישאר בדיוק כפי שהוא."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जो विवरण सही लगें उन्हें रीफ़्रेश करें। जिसे आप बंद छोड़ेंगे वह बिल्कुल वैसा ही रहेगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segarkan detail yang terlihat benar. Apa pun yang Anda biarkan nonaktif akan tetap persis seperti semula."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiorna i dettagli che ti sembrano corretti. Tutto ciò che lasci disattivato resterà esattamente com'è."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正しいと思う詳細を更新してください。オフのままにした項目はそのまま変わりません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "올바르게 보이는 세부정보를 새로고침하세요. 꺼짐으로 남겨둔 항목은 지금 그대로 유지됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vernieuw de details die er goed uitzien. Alles wat je uitgeschakeld laat, blijft precies zoals het is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odśwież szczegóły, które wyglądają poprawnie. Wszystko, co pozostawisz wyłączone, pozostanie dokładnie takie samo."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atualize os detalhes que parecem corretos. Tudo o que você deixar desativado permanecerá exatamente como está."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обновите те сведения, которые выглядят правильно. Всё, что вы оставите выключенным, останется точно таким же."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uppdatera de detaljer som ser rätt ut. Allt du lämnar avstängt förblir precis som det är."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รีเฟรชรายละเอียดที่ดูถูกต้อง ส่วนที่คุณปล่อยให้ปิดอยู่จะคงเดิมทุกประการ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doğru görünen ayrıntıları yenileyin. Kapalı bıraktığınız her şey tam olarak olduğu gibi kalır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оновіть ті відомості, що виглядають правильно. Усе, що ви залишите вимкненим, залишиться точно таким самим."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Làm mới các chi tiết trông có vẻ đúng. Bất cứ điều gì bạn để tắt sẽ giữ nguyên như cũ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "刷新看起来正确的详情。你保持关闭的内容将完全保持原样。"
          }
        }
      }

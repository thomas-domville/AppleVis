    "Search across forum topics, app directory listings, and resources. Results appear as you type.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search across forum topics, app directory listings, and resources. Results appear as you type."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca en foros, apps y recursos. Los resultados aparecen mientras escribes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherchez dans les forums, apps et ressources. Les résultats apparaissent pendant la saisie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Suche in Foren, Apps und Ressourcen. Ergebnisse erscheinen während der Eingabe."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesquise em fóruns, apps e recursos. Os resultados aparecem enquanto você digita."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerca tra forum, app e risorse. I risultati appaiono mentre digiti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォーラム、アプリ、リソースを検索。入力すると結果が表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포럼, 앱, 리소스를 검색합니다. 입력하는 동안 결과가 표시됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoek door forums, apps en bronnen. Resultaten verschijnen terwijl je typt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "搜索论坛话题、应用和资源，输入即显示结果。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابحث في المنتديات والتطبيقات والموارد. تظهر النتائج أثناء الكتابة."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोरम विषयों, ऐप्स और संसाधनों में खोजें। टाइप करते समय परिणाम दिखते हैं।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در موضوعات انجمن، برنامه‌ها و منابع جستجو کنید. نتایج هنگام تایپ نمایش داده می‌شوند."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поиск по темам форума, каталогу приложений и ресурсам. Результаты появляются при вводе."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Forum konularında, uygulama dizininde ve kaynaklarda arama yapın. Yazarken sonuçlar görünür."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szukaj w tematach forum, katalogu aplikacji i zasobach. Wyniki pojawiają się podczas pisania."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sök bland forumämnen, appkatalogen och resurser. Resultat visas medan du skriver."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חפש בנושאי פורום, קטלוג אפליקציות ומשאבים. התוצאות מופיעות בזמן הקלדה."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cari di topik forum, direktori aplikasi, dan sumber daya. Hasil muncul saat Anda mengetik."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tìm kiếm trong các chủ đề diễn đàn, danh mục ứng dụng và tài nguyên. Kết quả xuất hiện khi bạn gõ."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пошук по темах форуму, каталозі програм і ресурсах. Результати з'являються при введенні."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αναζήτηση σε θέματα φόρουμ, κατάλογο εφαρμογών και πόρους. Τα αποτελέσματα εμφανίζονται κατά την πληκτρολόγηση."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ค้นหาในหัวข้อฟอรัม ไดเรกทอรีแอป และทรัพยากร ผลลัพธ์จะแสดงขณะที่คุณพิมพ์"
          }
        }
      }
    },

    "Pitch Correction. On automatically. AppleVis keeps voices sounding natural at faster playback speeds." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تصحيح النغمة. مفعّل تلقائيًا. يحافظ AppleVis على صوت طبيعي للأصوات حتى عند سرعات تشغيل أسرع."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tonhöhenkorrektur. Automatisch aktiviert. AppleVis sorgt dafür, dass Stimmen auch bei höheren Wiedergabegeschwindigkeiten natürlich klingen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Διόρθωση Τόνου. Ενεργοποιείται αυτόματα. Το AppleVis διατηρεί τις φωνές φυσικές σε ταχύτερες ταχύτητες αναπαραγωγής."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corrección de tono. Se activa automáticamente. AppleVis mantiene las voces sonando naturales a velocidades de reproducción más rápidas."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اصلاح زیر و بمی صدا. به‌طور خودکار روشن است. AppleVis صداها را حتی در سرعت‌های پخش بالاتر طبیعی نگه می‌دارد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Correction de la hauteur. Activée automatiquement. AppleVis conserve un rendu vocal naturel même à des vitesses de lecture plus rapides."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תיקון גובה צליל. פועל אוטומטית. AppleVis שומרת על צליל טבעי לקולות גם במהירויות השמעה מהירות יותר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पिच सुधार। स्वचालित रूप से चालू। AppleVis तेज़ प्लेबैक गति पर भी आवाज़ों को स्वाभाविक बनाए रखता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koreksi Pitch. Aktif secara otomatis. AppleVis menjaga suara tetap terdengar alami pada kecepatan pemutaran yang lebih cepat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Correzione tono. Attivata automaticamente. AppleVis mantiene le voci naturali anche a velocità di riproduzione più elevate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ピッチ補正。自動的にオンになります。AppleVis は、再生速度を上げても音声が自然に聞こえるようにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "음정 보정. 자동으로 켜집니다. AppleVis는 재생 속도를 높여도 음성을 자연스럽게 유지합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toonhoogtecorrectie. Automatisch aan. AppleVis zorgt ervoor dat stemmen natuurlijk blijven klinken bij hogere afspeelsnelheden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Korekcja wysokości tonu. Włączana automatycznie. AppleVis sprawia, że głosy brzmią naturalnie nawet przy szybszym odtwarzaniu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Correção de tom. Ativada automaticamente. A AppleVis mantém as vozes soando naturais em velocidades de reprodução mais rápidas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коррекция высоты тона. Включается автоматически. AppleVis сохраняет естественное звучание голосов при повышенной скорости воспроизведения."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tonhöjdskorrigering. På automatiskt. AppleVis håller röster naturliga även vid snabbare uppspelningshastigheter."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การแก้ไขระดับเสียง เปิดโดยอัตโนมัติ AppleVis ทำให้เสียงพูดฟังดูเป็นธรรมชาติแม้ที่ความเร็วเล่นสูงขึ้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perde Düzeltme. Otomatik olarak açık. AppleVis, daha hızlı oynatma hızlarında bile seslerin doğal kalmasını sağlar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Корекція висоти тону. Автоматично увімкнено. AppleVis зберігає природне звучання голосів навіть при вищій швидкості відтворення."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Điều chỉnh cao độ. Tự động bật. AppleVis giữ cho giọng nói nghe tự nhiên ở tốc độ phát nhanh hơn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音调修正。自动开启。即使播放速度更快，AppleVis 也能让声音保持自然。"
          }
        }
      }
    },

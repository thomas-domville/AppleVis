        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מודיע לך כאשר דיון חדש מתפרסם בכל מקום ב-AppleVis."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब AppleVis पर कहीं भी नई चर्चा पोस्ट की जाती है तो सूचित करता है।"
          }
        },
        "id" : {
          "stringUnit" : {

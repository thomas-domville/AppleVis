    "Apple Related covers Apple products and platforms — iPhone, Mac, Apple Watch, apps, and more." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يشمل \"المتعلق بـ Apple\" منتجات ومنصات Apple — iPhone وMac وApple Watch والتطبيقات والمزيد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple-bezogen umfasst Apple-Produkte und -Plattformen – iPhone, Mac, Apple Watch, Apps und mehr."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το «Σχετικό με Apple» καλύπτει προϊόντα και πλατφόρμες Apple — iPhone, Mac, Apple Watch, εφαρμογές και άλλα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Relacionado con Apple» abarca los productos y plataformas de Apple: iPhone, Mac, Apple Watch, apps y más."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"مرتبط با اپل\" شامل محصولات و پلتفرم‌های اپل می‌شود — آیفون، مک، اپل واچ، برنامه‌ها و موارد دیگر."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Apple » couvre les produits et plateformes Apple : iPhone, Mac, Apple Watch, applications, et plus encore."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"קשור ל-Apple\" כולל מוצרים ופלטפורמות של Apple — iPhone, Mac, Apple Watch, אפליקציות ועוד."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Apple से संबंधित\" में Apple के उत्पाद और प्लेटफ़ॉर्म शामिल हैं — iPhone, Mac, Apple Watch, ऐप्स, और अधिक।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Terkait Apple\" mencakup produk dan platform Apple — iPhone, Mac, Apple Watch, aplikasi, dan lainnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Apple\" comprende i prodotti e le piattaforme Apple: iPhone, Mac, Apple Watch, app e altro ancora."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「Apple関連」にはiPhone、Mac、Apple Watch、アプリなど、Appleの製品とプラットフォームが含まれます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Apple 관련\"에는 iPhone, Mac, Apple Watch, 앱 등 Apple 제품 및 플랫폼이 포함됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple-gerelateerd omvat Apple-producten en -platforms — iPhone, Mac, Apple Watch, apps en meer."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kategoria związana z Apple obejmuje produkty i platformy Apple — iPhone, Mac, Apple Watch, aplikacje i inne."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Relacionado à Apple\" abrange produtos e plataformas da Apple — iPhone, Mac, Apple Watch, apps e muito mais."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Связанное с Apple» охватывает продукты и платформы Apple — iPhone, Mac, Apple Watch, приложения и многое другое."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple-relaterat omfattar Apple-produkter och -plattformar — iPhone, Mac, Apple Watch, appar och mer."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"เกี่ยวกับ Apple\" ครอบคลุมผลิตภัณฑ์และแพลตฟอร์มของ Apple เช่น iPhone, Mac, Apple Watch, แอป และอื่น ๆ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Apple ile İlgili\" iPhone, Mac, Apple Watch, uygulamalar ve daha fazlası gibi Apple ürün ve platformlarını kapsar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Пов'язане з Apple» охоплює продукти та платформи Apple — iPhone, Mac, Apple Watch, додатки й інше."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Liên quan đến Apple\" bao gồm các sản phẩm và nền tảng của Apple — iPhone, Mac, Apple Watch, ứng dụng và hơn thế nữa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Apple 相关”涵盖 Apple 产品和平台 — iPhone、Mac、Apple Watch、应用等。"
          }
        }
      }

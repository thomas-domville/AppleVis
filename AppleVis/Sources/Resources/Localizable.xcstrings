          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آخرین قسمت پادکست AppleVis پخش‌شده را از جایی که متوقف کرده‌اید از سر می‌گیرد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reprend le dernier épisode de podcast AppleVis lu à l'endroit où vous vous étiez arrêté."

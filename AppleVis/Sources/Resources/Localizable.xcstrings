    "Boils down long threads and articles into a quick summary, so you can decide whether it's worth reading in full." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يلخص المواضيع والمقالات الطويلة في ملخص سريع، حتى تتمكن من تقرير ما إذا كانت تستحق القراءة كاملةً."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fasst lange Threads und Artikel in einer kurzen Zusammenfassung zusammen, damit du entscheiden kannst, ob es sich lohnt, sie vollständig zu lesen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Συμπυκνώνει μεγάλα νήματα και άρθρα σε μια γρήγορη περίληψη, ώστε να αποφασίσετε αν αξίζει να τα διαβάσετε ολόκληρα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resume hilos y artículos largos en un resumen rápido, para que puedas decidir si vale la pena leerlos por completo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "موضوعات و مقالات طولانی را در یک خلاصهٔ سریع فشرده می‌کند تا بتوانید تصمیم بگیرید که آیا ارزش خواندن کامل را دارد یا نه."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Condense les longs fils de discussion et articles en un résumé rapide, afin que vous puissiez décider s'ils valent la peine d'être lus en entier."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מצמצם דיונים ומאמרים ארוכים לסיכום מהיר, כדי שתוכל להחליט אם כדאי לקרוא אותם במלואם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लंबे थ्रेड और लेखों को एक त्वरित सारांश में संक्षिप्त करता है, ताकि आप तय कर सकें कि इसे पूरा पढ़ना उचित है या नहीं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merangkum utas dan artikel panjang menjadi ringkasan singkat, sehingga Anda dapat memutuskan apakah layak dibaca secara lengkap."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Condensa lunghe discussioni e articoli in un breve riepilogo, così puoi decidere se vale la pena leggerli per intero."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "長いスレッドや記事を要約し、全文を読む価値があるかどうかを素早く判断できるようにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "긴 게시글과 기사를 간단히 요약해 전체를 읽을 가치가 있는지 판단할 수 있게 해줍니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vat lange threads en artikelen samen in een snelle samenvatting, zodat je kunt beslissen of het de moeite waard is om ze volledig te lezen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skraca długie wątki i artykuły do krótkiego podsumowania, dzięki czemu możesz zdecydować, czy warto przeczytać je w całości."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resume tópicos e artigos longos em um resumo rápido, para que você decida se vale a pena ler por completo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сжимает длинные обсуждения и статьи в краткую сводку, чтобы вы могли решить, стоит ли читать их полностью."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kokar ner långa trådar och artiklar till en snabb sammanfattning, så att du kan avgöra om det är värt att läsa i sin helhet."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สรุปกระทู้และบทความยาวๆ ให้เป็นบทสรุปสั้นๆ เพื่อให้คุณตัดสินใจได้ว่าคุ้มค่าที่จะอ่านฉบับเต็มหรือไม่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uzun konuları ve makaleleri hızlı bir özete indirger, böylece tamamını okumaya değip değmeyeceğine karar verebilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Стискає довгі обговорення та статті в короткий підсумок, щоб ви могли вирішити, чи варто читати повністю."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tóm gọn các luồng thảo luận và bài viết dài thành bản tóm tắt nhanh, giúp bạn quyết định có nên đọc toàn bộ hay không."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将长篇讨论串和文章浓缩为简要摘要，帮助您判断是否值得通读全文。"
          }
        }
      }
    },

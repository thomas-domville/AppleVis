    "Replays the guided tour of Home, Discover, For You, and Profile & Settings." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعيد تشغيل الجولة الإرشادية للرئيسية، واستكشف، ولك، والملف الشخصي والإعدادات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Startet den geführten Rundgang durch Home, Entdecken, Für dich und Profil & Einstellungen erneut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επαναλαμβάνει την καθοδηγούμενη περιήγηση στην Αρχική, το Ανακαλύψτε, το Για Εσάς, και το Προφίλ & Ρυθμίσεις."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repite el recorrido guiado por Inicio, Descubrir, Para ti, y Perfil y ajustes."

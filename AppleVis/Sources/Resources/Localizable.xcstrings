    "The AppleVis App Directory is a community resource. Please read and confirm the following before adding an app." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دليل تطبيقات AppleVis هو مورد مجتمعي. يرجى قراءة وتأكيد ما يلي قبل إضافة تطبيق."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das AppleVis-App-Verzeichnis ist eine Community-Ressource. Bitte lies Folgendes und bestätige es, bevor du eine App hinzufügst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο Κατάλογος Εφαρμογών AppleVis είναι πόρος της κοινότητας. Παρακαλώ διαβάστε και επιβεβαιώστε τα ακόλουθα πριν προσθέσετε μια εφαρμογή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El directorio de apps de AppleVis es un recurso comunitario. Lee y confirma lo siguiente antes de añadir una app."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فهرست برنامه‌های AppleVis منبعی جامعه‌محور است. لطفاً قبل از افزودن برنامه، موارد زیر را بخوانید و تأیید کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le répertoire d'applis AppleVis est une ressource communautaire. Veuillez lire et confirmer ce qui suit avant d'ajouter une appli."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ספריית האפליקציות של AppleVis היא משאב קהילתי. אנא קרא ואשר את הדברים הבאים לפני הוספת אפליקציה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleVis ऐप निर्देशिका एक सामुदायिक संसाधन है। ऐप जोड़ने से पहले कृपया निम्नलिखित पढ़ें और पुष्टि करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Direktori Aplikasi AppleVis adalah sumber daya komunitas. Harap baca dan konfirmasi hal berikut sebelum menambahkan aplikasi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La directory delle app di AppleVis è una risorsa della comunità. Leggi e conferma quanto segue prima di aggiungere un'app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleVis アプリディレクトリはコミュニティのリソースです。アプリを追加する前に、以下をお読みになり確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleVis 앱 디렉터리는 커뮤니티 자원입니다. 앱을 추가하기 전에 다음을 읽고 확인해 주세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De AppleVis App Directory is een communitybron. Lees en bevestig het volgende voordat je een app toevoegt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Katalog Aplikacji AppleVis to zasób społecznościowy. Przeczytaj i potwierdź poniższe przed dodaniem aplikacji."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O diretório de apps da AppleVis é um recurso da comunidade. Leia e confirme o seguinte antes de adicionar um app."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каталог приложений AppleVis — это ресурс сообщества. Пожалуйста, прочитайте и подтвердите следующее перед добавлением приложения."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleVis Appkatalog är en gemenskapsresurs. Läs och bekräfta följande innan du lägger till en app."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไดเรกทอรีแอป AppleVis เป็นแหล่งข้อมูลของชุมชน โปรดอ่านและยืนยันสิ่งต่อไปนี้ก่อนเพิ่มแอป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleVis Uygulama Dizini bir topluluk kaynağıdır. Bir uygulama eklemeden önce lütfen aşağıdakileri okuyun ve onaylayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каталог додатків AppleVis — це ресурс спільноти. Будь ласка, прочитайте та підтвердьте наведене нижче перед додаванням застосунку."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Danh mục ứng dụng AppleVis là tài nguyên cộng đồng. Vui lòng đọc và xác nhận những điều sau trước khi thêm ứng dụng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleVis 应用目录是一项社区资源。添加应用前，请阅读并确认以下内容。"
          }
        }
      }
    },

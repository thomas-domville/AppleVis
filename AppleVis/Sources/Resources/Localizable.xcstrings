        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نکات کوتاه زمینه‌ای و یادآوری‌های دوستانه را در جایی که می‌توانند در زمان صرفه‌جویی کنند نمایش می‌دهد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",

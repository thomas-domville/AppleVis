    "The AppleVis app was shaped by people who cared deeply about making the community easier, faster, and more enjoyable to use." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شكّل تطبيق AppleVis أشخاصٌ اهتموا بعمق بجعل المجتمع أسهل وأسرع وأمتع في الاستخدام."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die AppleVis-App wurde von Menschen gestaltet, denen es sehr am Herzen lag, die Community einfacher, schneller und angenehmer nutzbar zu machen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η εφαρμογή AppleVis διαμορφώθηκε από ανθρώπους που νοιάζονταν πραγματικά να κάνουν την κοινότητα πιο εύκολη, γρήγορη και ευχάριστη στη χρήση."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La app de AppleVis fue creada por personas a las que les importaba de verdad que la comunidad fuera más fácil, rápida y agradable de usar."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برنامهٔ AppleVis را کسانی شکل دادند که واقعاً دغدغهٔ آسان‌تر، سریع‌تر و دلپذیرتر کردن استفاده از جامعه را داشتند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'appli AppleVis a été façonnée par des personnes qui tenaient profondément à rendre la communauté plus simple, plus rapide et plus agréable à utiliser."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "האפליקציה של AppleVis עוצבה על ידי אנשים שהיה חשוב להם מאוד להפוך את הקהילה לפשוטה, מהירה ונעימה יותר לשימוש."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleVis ऐप को उन लोगों ने आकार दिया जो समुदाय को आसान, तेज़ और ज़्यादा सुखद बनाने की गहरी परवाह करते थे।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikasi AppleVis dibentuk oleh orang-orang yang sangat peduli untuk membuat komunitas lebih mudah, lebih cepat, dan lebih menyenangkan digunakan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'app AppleVis è stata plasmata da persone che tenevano davvero a rendere la community più semplice, veloce e piacevole da usare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleVis アプリは、コミュニティをもっと簡単に、速く、楽しく使えるようにしたいと心から願う人たちによって形づくられました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleVis 앱은 커뮤니티를 더 쉽고, 빠르고, 즐겁게 사용할 수 있도록 깊이 고민한 사람들이 만들었습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De AppleVis-app is gevormd door mensen die er veel om gaven de community makkelijker, sneller en prettiger in gebruik te maken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikację AppleVis kształtowali ludzie, którym bardzo zależało, by korzystanie ze społeczności było prostsze, szybsze i przyjemniejsze."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O app AppleVis foi moldado por pessoas que se importavam de verdade em tornar a comunidade mais fácil, rápida e agradável de usar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложение AppleVis создавали люди, которым было по-настоящему важно, чтобы пользоваться сообществом было проще, быстрее и приятнее."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleVis-appen formades av människor som brydde sig djupt om att göra communityn enklare, snabbare och trevligare att använda."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แอป AppleVis สร้างขึ้นโดยผู้คนที่ใส่ใจอย่างยิ่งในการทำให้ชุมชนใช้งานง่ายขึ้น เร็วขึ้น และสนุกขึ้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleVis uygulaması, topluluğu kullanmayı daha kolay, daha hızlı ve daha keyifli hâle getirmeyi gerçekten önemseyen kişiler tarafından şekillendirildi."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Додаток AppleVis створювали люди, для яких було справді важливо, щоб користуватися спільнотою було простіше, швидше й приємніше."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ứng dụng AppleVis được tạo nên bởi những người thực sự quan tâm đến việc giúp cộng đồng dễ dùng, nhanh và dễ chịu hơn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleVis 应用由一群真心希望让社区更易用、更快捷、更愉快的人打造而成。"
          }
        }
      }
    },

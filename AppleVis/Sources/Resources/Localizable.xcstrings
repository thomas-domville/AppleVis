          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oculta categorias de fórum não relacionadas à Apple na tela Início."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скрывает не связанные с Apple категории форума на «Главной»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Döljer icke-Apple-forumkategorier från Hem."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ซ่อนหมวดหมู่ฟอรัมที่ไม่ใช่ของ Apple จากหน้าแรก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ana Sayfa'dan Apple dışı forum kategorilerini gizler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приховує категорії форуму, не пов'язані з Apple, з «Головної»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ẩn các danh mục diễn đàn không liên quan đến Apple khỏi Trang chủ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从“主页”中隐藏非 Apple 相关的论坛分类。"
          }
        }
      }
    },
    "Hides the New view, summary, and badges. Home still works normally otherwise." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يخفي عرض الجديد والملخص والشارات. تعمل الرئيسية بشكل طبيعي في كل شيء آخر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blendet die Ansicht „Neu\", die Übersicht und die Abzeichen aus. Ansonsten funktioniert Start ganz normal weiter."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αποκρύπτει την προβολή Νέα, τη σύνοψη και τα σήματα. Η Αρχική συνεχίζει να λειτουργεί κανονικά κατά τα άλλα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oculta la vista Nuevo, el resumen y las insignias. Por lo demás, Inicio sigue funcionando con normalidad."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نمای جدید، خلاصه، و نشان‌ها را پنهان می‌کند. صفحهٔ خانه در بقیهٔ موارد مثل همیشه کار می‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masque la vue Nouveau, le résumé et les badges. Accueil continue de fonctionner normalement pour le reste."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מסתיר את תצוגת החדשים, הסיכום, ותגי המידע. בית ממשיך לפעול כרגיל בכל השאר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नया व्यू, सारांश, और बैज छिपा देता है। बाकी सब में होम सामान्य रूप से काम करता रहेगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menyembunyikan tampilan Baru, ringkasan, dan lencana. Beranda tetap berfungsi normal selain itu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nasconde la vista Nuovi, il riepilogo e i badge. Per il resto, Home continua a funzionare normalmente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「新着」ビュー、まとめ、バッジが非表示になります。それ以外のホームの動作は変わりません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새 글 보기, 요약, 배지가 숨겨집니다. 그 외에는 홈이 평소대로 작동합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbergt de weergave Nieuw, de samenvatting en de badges. Home werkt verder gewoon normaal."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukrywa widok Nowe, podsumowanie i odznaki. Poza tym Strona główna działa normalnie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oculta a visualização Novo, o resumo e os selos. Fora isso, o Início continua funcionando normalmente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скрывает вид «Новые», сводку и значки. В остальном «Главная» работает как обычно."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Döljer vyn Nya, sammanfattningen och märkena. I övrigt fungerar Hem som vanligt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ซ่อนมุมมองใหม่ สรุป และป้ายต่างๆ หน้าหลักยังคงทำงานได้ตามปกติในส่วนอื่น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeni görünümünü, özeti ve rozetleri gizler. Ana Sayfa bunun dışında normal şekilde çalışmaya devam eder."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приховує перегляд «Нові», підсумок і значки. У всьому іншому «Головна» працює як завжди."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ẩn chế độ xem Mới, tóm tắt, và huy hiệu. Trang chủ vẫn hoạt động bình thường ở những phần khác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隐藏新帖视图、摘要和徽章。主页的其他功能照常使用。"
          }
        }
      }
    },

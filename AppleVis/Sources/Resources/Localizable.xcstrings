    "Shows short contextual tips and friendly reminders where they can save time." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعرض نصائح سياقية قصيرة وتذكيرات ودية حيث يمكنها توفير الوقت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",

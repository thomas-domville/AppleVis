    "NEW means the item itself was posted since your last visit." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«جديد» تعني أن العنصر نفسه نُشر منذ زيارتك الأخيرة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NEU bedeutet, dass das Element selbst seit deinem letzten Besuch veröffentlicht wurde."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το ΝΕΟ σημαίνει ότι το ίδιο το στοιχείο δημοσιεύτηκε μετά την τελευταία σας επίσκεψη."

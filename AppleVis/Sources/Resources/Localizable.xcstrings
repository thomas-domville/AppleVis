        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المواضيع التي تتابعها. محفوظة محلياً ومزامنة عبر iCloud."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वे विषय जिन्हें आप फ़ॉलो कर रहे हैं। iCloud के माध्यम से सिंक।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "موضوعاتی که دنبال می‌کنید. به صورت محلی ذخیره شده و از طریق iCloud همگام‌سازی می‌شود."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Темы, за которыми вы следите. Сохранены локально и синхронизированы через iCloud."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Takip ettiğiniz konular. Yerel olarak kaydedilir ve iCloud ile senkronize edilir."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tematy, które obserwujesz. Zapisane lokalnie i synchronizowane przez iCloud."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ämnen du följer. Sparas lokalt och synkroniseras via iCloud."
          }

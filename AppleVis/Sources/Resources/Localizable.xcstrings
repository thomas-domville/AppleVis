        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "נושאים שאינם קשורים ל-Apple כוללים Windows, Android, טכנולוגיית בית חכם ודיונים כלליים על טכנולוגיה מסייעת."
          }
        },
        "hi" : {
          "stringUnit" : {

          "stringUnit" : {
            "state" : "translated",
            "value" : "ซ่อนมุมมองใหม่ สรุป และป้ายต่างๆ หน้าหลักยังคงทำงานได้ตามปกติในส่วนอื่น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeni görünümünü, özeti ve rozetleri gizler. Ana Sayfa bunun dışında normal şekilde çalışmaya devam eder."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приховує перегляд «Нові», підсумок і значки. У всьому іншому «Головна» працює як завжди."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ẩn chế độ xem Mới, tóm tắt, và huy hiệu. Trang chủ vẫn hoạt động bình thường ở những phần khác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隐藏新帖视图、摘要和徽章。主页的其他功能照常使用。"
          }
        }
      }
    },

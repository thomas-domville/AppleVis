    "This draft may sound frustrated or sharp. A calmer tone can help others respond helpfully." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قد تبدو هذه المسودة محبطة أو حادة. تساعد النبرة الأهدأ الآخرين على الرد بطريقة مفيدة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Entwurf könnte frustriert oder scharf klingen. Ein ruhigerer Ton hilft anderen, hilfreich zu antworten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτό το προσχέδιο μπορεί να ακούγεται εκνευρισμένο ή απότομο. Ένας πιο ήρεμος τόνος βοηθά τους άλλους να απαντήσουν χρήσιμα."
          }

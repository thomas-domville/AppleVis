          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproduz um som para momentos que valem a pena notar — salvar, downloads concluídos, notificações e reprodução/pausa de podcast."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Воспроизводит звук в примечательные моменты — сохранение, завершение загрузок, уведомления, а также воспроизведение и пауза подкаста."
          }

    "Appends your app version and iOS version to help diagnose the issue." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُرفق إصدار تطبيقك وإصدار iOS للمساعدة في تشخيص المشكلة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügt deine App- und iOS-Version hinzu, um bei der Diagnose des Problems zu helfen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προσαρτά την έκδοση της εφαρμογής σας και την έκδοση iOS για να βοηθήσει στη διάγνωση του προβλήματος."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade la versión de tu app y de iOS para ayudar a diagnosticar el problema."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نسخهٔ برنامه و نسخهٔ iOS شما را برای کمک به تشخیص مشکل پیوست می‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute la version de votre appli et d'iOS pour aider à diagnostiquer le problème."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מצרף את גרסת האפליקציה וגרסת ה-iOS שלך כדי לסייע באבחון הבעיה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "समस्या के निदान में मदद के लिए आपके ऐप संस्करण और iOS संस्करण को जोड़ता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",

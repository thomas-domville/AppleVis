          "stringUnit" : {
            "state" : "translated",
            "value" : "टैब बदलने, पिकर परिवर्तन, स्क्रीन खोलने, और सूची रिफ़्रेश के लिए ध्वनि बजाता है。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memutar suara untuk pergantian tab, perubahan pemilih, membuka layar, dan penyegaran daftar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riproduce un suono per il cambio di scheda, le modifiche al selettore, l'apertura di schermate e gli aggiornamenti degli elenchi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タブの切り替え、ピッカーの変更、画面表示、リストの更新でサウンドを再生します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "탭 전환, 선택기 변경, 화면 열기, 목록 새로 고침을 위한 소리를 재생합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speelt een geluid af voor tabbladwisselingen, kiezerwijzigingen, schermen openen en lijstvernieuwingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odtwarza dźwięk podczas przełączania kart, zmian selektora, otwierania ekranów i odświeżania list."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproduz um som para troca de abas, mudanças de seletor, abertura de telas e atualizações de listas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Воспроизводит звук при переключении вкладок, изменениях в выборах, открытии экранов и обновлении списков."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spelar upp ett ljud för fliksbyten, väljarändringar, öppning av skärmar och listuppdateringar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เล่นเสียงสำหรับการสลับแท็บ การเปลี่ยนตัวเลือก การเปิดหน้าจอ และการรีเฟรชลิสต์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sekme değiştirme, seçici değişiklikleri, ekran açma ve liste yenilemeleri için ses çalar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відтворює звук під час перемикання вкладок, змін у селекторах, відкриття екранів і оновлення списків."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",

            "state" : "translated",
            "value" : "آخرین قسمت پخش‌شده را از جایی که متوقف شدید ادامه می‌دهد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reprend le dernier épisode écouté là où vous vous étiez arrêté."

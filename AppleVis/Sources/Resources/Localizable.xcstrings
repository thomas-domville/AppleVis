          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오프라인 상태입니다. 추천을 보려면 Wi-Fi 또는 셀룰러에 연결하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",

    "Search the App Store for the app you want to add, or enter its details manually if you can't find it." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ابحث في App Store عن التطبيق الذي تريد إضافته، أو أدخل تفاصيله يدويًا إذا لم تجده."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suche im App Store nach der App, die du hinzufügen möchtest, oder gib ihre Daten manuell ein, falls du sie nicht findest."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αναζητήστε στο App Store την εφαρμογή που θέλετε να προσθέσετε, ή εισαγάγετε τα στοιχεία της χειροκίνητα αν δεν τη βρίσκετε."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Busca en la App Store la app que quieres añadir, o introduce sus datos manualmente si no la encuentras."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برنامه‌ای که می‌خواهید اضافه کنید را در App Store جستجو کنید، یا اگر آن را پیدا نکردید، جزئیات آن را به‌صورت دستی وارد کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recherchez dans l'App Store l'application que vous souhaitez ajouter, ou saisissez ses informations manuellement si vous ne la trouvez pas."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "חפש ב-App Store את האפליקציה שברצונך להוסיף, או הזן את פרטיה ידנית אם אינך מוצא אותה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जो ऐप आप जोड़ना चाहते हैं उसे App Store में खोजें, या यदि आपको नहीं मिलता है तो उसका विवरण मैन्युअल रूप से दर्ज करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cari di App Store aplikasi yang ingin Anda tambahkan, atau masukkan detailnya secara manual jika Anda tidak dapat menemukannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cerca nell'App Store l'app che vuoi aggiungere, oppure inserisci i suoi dati manualmente se non la trovi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "追加したいアプリをApp Storeで検索するか、見つからない場合は詳細を手動で入力してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "추가하려는 앱을 App Store에서 검색하거나, 찾을 수 없는 경우 세부 정보를 직접 입력하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoek in de App Store naar de app die je wilt toevoegen, of voer de gegevens handmatig in als je hem niet kunt vinden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyszukaj w App Store aplikację, którą chcesz dodać, lub wprowadź jej dane ręcznie, jeśli jej nie znajdziesz."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pesquise na App Store o app que deseja adicionar, ou informe seus dados manualmente se não conseguir encontrá-lo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Найдите в App Store приложение, которое хотите добавить, или введите его данные вручную, если не можете найти его."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sök i App Store efter appen du vill lägga till, eller ange dess uppgifter manuellt om du inte hittar den."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ค้นหาแอปที่คุณต้องการเพิ่มใน App Store หรือป้อนรายละเอียดด้วยตนเองหากคุณหาไม่พบ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eklemek istediğiniz uygulamayı App Store'da arayın veya bulamıyorsanız bilgilerini elle girin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Знайдіть в App Store застосунок, який хочете додати, або введіть його дані вручну, якщо не можете його знайти."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tìm kiếm ứng dụng bạn muốn thêm trên App Store, hoặc nhập thông tin chi tiết theo cách thủ công nếu bạn không tìm thấy."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 App Store 中搜索您想添加的应用,如果找不到,请手动输入其详细信息。"
          }
        }
      }
    },

    "You're offline, so search can't reach AppleVis right now. Reconnect and try again." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أنت غير متصل، لذا لا يمكن للبحث الوصول إلى AppleVis الآن. أعد الاتصال وحاول مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",

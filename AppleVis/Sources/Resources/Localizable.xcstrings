    "Raises the keyboard the moment you open Search, so you can start typing right away." : {
      "comment" : "A description of the text that appears under the toggle in the `Search` section of the `GeneralSettingsView`.",
      "extractionState" : "manual",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعرض لوحة المفاتيح لحظة فتح البحث، حتى تتمكن من البدء بالكتابة فورًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt die Tastatur sofort an, wenn du die Suche öffnest, damit du direkt mit dem Tippen beginnen kannst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ανασηκώνει το πληκτρολόγιο τη στιγμή που ανοίγετε την Αναζήτηση, ώστε να μπορείτε να αρχίσετε να πληκτρολογείτε αμέσως."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra el teclado en cuanto abres Buscar, para que puedas empezar a escribir de inmediato."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لحظه‌ای که جستجو را باز می‌کنید، صفحه‌کلید را نشان می‌دهد تا بلافاصله شروع به تایپ کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche le clavier dès que vous ouvrez Recherche, afin que vous puissiez commencer à taper immédiatement."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מעלה את המקלדת ברגע שאתה פותח את החיפוש, כך שתוכל להתחיל להקליד מיד."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जिस क्षण आप खोज खोलते हैं कीबोर्ड उठाता है, ताकि आप तुरंत टाइप करना शुरू कर सकें。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menampilkan keyboard saat Anda membuka Pencarian, sehingga Anda dapat langsung mulai mengetik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra la tastiera nel momento in cui apri Cerca, così puoi iniziare subito a digitare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「検索」を開いた瞬間にキーボードを表示し、すぐに入力を開始できるようにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "검색을 여는 순간 키보드를 표시해 바로 입력을 시작할 수 있게 합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toont het toetsenbord zodra je Zoeken opent, zodat je meteen kunt beginnen met typen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wysuwa klawiaturę w momencie otwarcia Wyszukiwania, dzięki czemu możesz od razu zacząć pisać."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exibe o teclado no momento em que você abre a Busca, para que possa começar a digitar imediatamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывает клавиатуру сразу же при открытии поиска, чтобы вы могли сразу начать печатать."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visar tangentbordet i samma stund du öppnar Sök, så att du kan börja skriva direkt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เปิดแป้นพิมพ์ทันทีที่คุณเปิดการค้นหา เพื่อให้คุณเริ่มพิมพ์ได้ทันที"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arama'yı açtığınız anda klavyeyi yükselterek hemen yazmaya başlamanızı sağlar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Піднімає клавіатуру одразу після відкриття пошуку, щоб ви могли одразу почати вводити текст."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiện bàn phím ngay khi bạn mở Tìm kiếm, để bạn có thể bắt đầu gõ ngay lập tức."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在您打开搜索的瞬间弹出键盘，方便您立即输入。"
          }
        }
      }
    },

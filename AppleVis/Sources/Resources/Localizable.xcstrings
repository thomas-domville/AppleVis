      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعمل الميزات الذكية المدعومة بالذكاء الاصطناعي على جهازك باستخدام Apple Intelligence. لا يُرسل المحتوى إلى خوادم خارجية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KI-gestützte intelligente Funktionen laufen mit Apple Intelligence auf deinem Gerät. Inhalte werden nicht an externe Server gesendet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι έξυπνες λειτουργίες με ΤΝ εκτελούνται στη συσκευή σας με το Apple Intelligence. Το περιεχόμενο δεν στέλνεται σε εξωτερικούς διακομιστές."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las funciones inteligentes con IA se ejecutan en tu dispositivo con Apple Intelligence. El contenido no se envía a servidores externos."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ویژگی‌های هوشمند مبتنی بر هوش مصنوعی با Apple Intelligence روی دستگاه شما اجرا می‌شوند. محتوا به سرورهای خارجی فرستاده نمی‌شود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les fonctionnalités intelligentes basées sur l'IA s'exécutent sur votre appareil avec Apple Intelligence. Le contenu n'est pas envoyé à des serveurs externes."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תכונות חכמות מבוססות בינה מלאכותית פועלות במכשיר שלך באמצעות Apple Intelligence. התוכן לא נשלח לשרתים חיצוניים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI आधारित स्मार्ट सुविधाएं Apple Intelligence के ज़रिए आपके डिवाइस पर चलती हैं। सामग्री बाहरी सर्वर पर नहीं भेजी जाती।"

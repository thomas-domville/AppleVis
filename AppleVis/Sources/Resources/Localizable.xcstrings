          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speelt de begeleide rondleiding door Start, Ontdek, Voor jou, en Profiel en instellingen opnieuw af."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uruchamia ponownie wycieczkę z przewodnikiem po Stronie głównej, Odkrywaj, Dla Ciebie oraz Profilu i ustawieniach."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",

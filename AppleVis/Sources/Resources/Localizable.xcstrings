        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sama aplikacja AppleVis nie jest open source. Cały kod aplikacji jest objęty prawami autorskimi AppleVis i jej współtwórców."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A própria AppleVis não é de código aberto. Todo o código do app tem direitos autorais da AppleVis e de seus colaboradores."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Само приложение AppleVis не является открытым исходным кодом. Весь код приложения защищён авторским правом AppleVis и его участников."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",

        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Burada ve orada beliren kısa, samimi ipuçları — sizi rahatsız etmek için değil, bir adım tasarruf ettirmek için zamanlanmıştır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Короткі, дружні поради, які з'являються то тут, то там — підібрані так, щоб зекономити вам крок, а не набридати."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Những mẹo ngắn gọn, thân thiện xuất hiện đây đó — được canh thời điểm để giúp bạn tiết kiệm một bước, không phải để làm phiền."

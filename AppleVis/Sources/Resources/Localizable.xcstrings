          "stringUnit" : {
            "state" : "translated",
            "value" : "تور راهنمای کوتاه صفحهٔ اصلی، کشف کنید، برای شما، جستجو، نمایه و تنظیمات را دوباره پخش می‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revoit la courte visite guidée d'Accueil, Découvrir, Pour vous, Recherche, Profil et Réglages."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מפעיל מחדש את הסיור המודרך הקצר של הבית, גילוי, בשבילך, חיפוש, פרופיל והגדרות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "होम, खोजें, आपके लिए, खोज, प्रोफ़ाइल, और सेटिंग्स के छोटे निर्देशित टूर को दोबारा चलाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memutar ulang tur berpandu singkat Beranda, Jelajahi, Untuk Anda, Pencarian, Profil, dan Pengaturan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rivede il breve tour guidato di Home, Scopri, Per te, Cerca, Profilo e Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホーム、見つける、あなたへ、検索、プロフィール、設定の短いガイド付きツアーを再生します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "홈, 둘러보기, 나를 위한, 검색, 프로필, 설정에 대한 짧은 안내 투어를 다시 재생합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Herhaalt de korte begeleide rondleiding van Start, Ontdekken, Voor jou, Zoeken, Profiel en Instellingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odtwarza ponownie krótki samouczek dotyczący Strony głównej, Odkrywaj, Dla Ciebie, Wyszukiwania, Profilu i Ustawień."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repete o breve tour guiado de Início, Descobrir, Para você, Busca, Perfil e Configurações."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заново показывает короткий обзор с подсказками для «Главная», «Обзор», «Для вас», «Поиск», «Профиль» и «Настройки»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spelar upp den korta guidade rundturen av Hem, Upptäck, För dig, Sök, Profil och Inställningar igen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เล่นทัวร์แนะนำสั้นๆ ของหน้าแรก ค้นพบ สำหรับคุณ ค้นหา โปรไฟล์ และการตั้งค่าอีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ana Sayfa, Keşfet, Sizin İçin, Arama, Profil ve Ayarlar'ın kısa rehberli turunu tekrar oynatır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повторно відтворює короткий керований тур «Головна», «Огляд», «Для вас», «Пошук», «Профіль» і «Налаштування»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phát lại hướng dẫn ngắn có chỉ dẫn về Trang chủ, Khám phá, Dành cho bạn, Tìm kiếm, Hồ sơ và Cài đặt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重新播放“主页”“发现”“为您推荐”“搜索”“个人资料”和“设置”的简短引导导览。"
          }
        }
      }
    },

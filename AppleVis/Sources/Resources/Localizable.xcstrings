    "Raises the keyboard the moment you open Search, so you can start typing right away." : {
      "comment" : "A description of the text that appears under the toggle in the `Search` section of the `GeneralSettingsView`.",
      "extractionState" : "manual",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعرض لوحة المفاتيح لحظة فتح البحث، حتى تتمكن من البدء بالكتابة فورًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt die Tastatur sofort an, wenn du die Suche öffnest, damit du direkt mit dem Tippen beginnen kannst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ανασηκώνει το πληκτρολόγιο τη στιγμή που ανοίγετε την Αναζήτηση, ώστε να μπορείτε να αρχίσετε να πληκτρολογείτε αμέσως."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra el teclado en cuanto abres Buscar, para que puedas empezar a escribir de inmediato."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لحظه‌ای که جستجو را باز می‌کنید، صفحه‌کلید را نشان می‌دهد تا بلافاصله شروع به تایپ کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche le clavier dès que vous ouvrez Recherche, afin que vous puissiez commencer à taper immédiatement."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מעלה את המקלדת ברגע שאתה פותח את החיפוש, כך שתוכל להתחיל להקליד מיד."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जिस क्षण आप खोज खोलते हैं कीबोर्ड उठाता है, ताकि आप तुरंत टाइप करना शुरू कर सकें。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menampilkan keyboard saat Anda membuka Pencarian, sehingga Anda dapat langsung mulai mengetik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",

          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti avvisa quando viene pubblicata una nuova discussione in qualsiasi punto di AppleVis."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleVis 上のどこかで新しいディスカッションが投稿されると通知します。"
          }
        },
        "ko" : {
          "stringUnit" : {

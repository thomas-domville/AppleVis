        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleVis पोस्ट अंग्रेज़ी में होनी चाहिए। कृपया पोस्ट करने से पहले अनुवाद करें या अपने ड्राफ़्ट को अंग्रेज़ी में संपादित करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Postingan AppleVis harus dalam bahasa Inggris. Gunakan Terjemahkan atau edit draf Anda dalam bahasa Inggris sebelum memposting."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I post di AppleVis devono essere in inglese. Usa Traduci o modifica la bozza in inglese prima di pubblicare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleVis への投稿は英語である必要があります。投稿前に「翻訳」を使用するか、下書きを英語で編集してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleVis 게시물은 영어로 작성해야 합니다. 게시하기 전에 번역 기능을 사용하거나 초안을 영어로 수정하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleVis-berichten moeten in het Engels zijn. Gebruik Vertalen of bewerk je concept in het Engels voordat je plaatst."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wpisy na AppleVis muszą być w języku angielskim. Użyj funkcji Tłumacz lub edytuj szkic w języku angielskim przed opublikowaniem."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As publicações da AppleVis devem estar em inglês. Use Traduzir ou edite seu rascunho em inglês antes de publicar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Публикации AppleVis должны быть на английском языке. Пожалуйста, воспользуйтесь переводом или отредактируйте черновик на английском перед публикацией."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inlägg på AppleVis måste vara på engelska. Använd Översätt eller redigera ditt utkast på engelska innan du publicerar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "โพสต์ AppleVis ต้องเป็นภาษาอังกฤษ โปรดใช้การแปลหรือแก้ไขร่างของคุณเป็นภาษาอังกฤษก่อนโพสต์"

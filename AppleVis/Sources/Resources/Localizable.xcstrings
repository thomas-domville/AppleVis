    "Tour paused. Resume anytime from the Resume Tour button." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم إيقاف الجولة مؤقتًا. استأنفها في أي وقت من زر إعادة تشغيل الجولة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tour pausiert. Setze sie jederzeit über die Schaltfläche „Tour fortsetzen“ fort."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η περιήγηση σε παύση. Συνεχίστε όποτε θέλετε από το κουμπί Συνέχιση Περιήγησης."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recorrido pausado. Reanúdalo cuando quieras desde el botón Reanudar recorrido."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تور متوقف شد. هر زمان از دکمهٔ ازسرگیری تور آن را ادامه دهید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visite en pause. Reprenez-la à tout moment via le bouton Reprendre la visite."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הסיור מושהה. חדש אותו בכל עת דרך כפתור המשך סיור."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "टूर रोका गया। कभी भी टूर फिर से शुरू करें बटन से इसे फिर से शुरू करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tur dijeda. Lanjutkan kapan saja dari tombol Lanjutkan Tur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tour in pausa. Riprendilo quando vuoi dal pulsante Riprendi il tour."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ツアーを一時停止しました。「ツアーを再開」ボタンからいつでも再開できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "투어가 일시 중지되었어요. '투어 재개' 버튼으로 언제든 다시 시작하세요."
          }
        },

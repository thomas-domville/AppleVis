    "Push notifications are blocked in iOS Settings — these won't arrive until allowed above." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إشعارات الدفع محظورة في إعدادات iOS — لن تصل حتى يُسمح بها أعلاه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Push-Benachrichtigungen sind in den iOS-Einstellungen blockiert – diese kommen erst an, wenn sie oben erlaubt werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι ειδοποιήσεις push είναι αποκλεισμένες στις Ρυθμίσεις iOS — αυτές δεν θα φτάσουν έως ότου επιτραπούν παραπάνω."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las notificaciones push están bloqueadas en la Configuración de iOS: no llegarán hasta que se permitan arriba."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اعلان‌های فوری در تنظیمات iOS مسدود هستند — تا زمانی که در بالا اجازه داده نشود، نمی‌رسند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les notifications push sont bloquées dans les réglages iOS — elles n'arriveront pas tant qu'elles ne seront pas autorisées ci-dessus."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "התראות דחיפה חסומות בהגדרות iOS — אלה לא יגיעו עד שיותרו למעלה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS सेटिंग्स में पुश सूचनाएं अवरुद्ध हैं — जब तक ऊपर अनुमति नहीं दी जाती, ये नहीं आएंगी。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notifikasi push diblokir di Pengaturan iOS — ini tidak akan sampai sampai diizinkan di atas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le notifiche push sono bloccate nelle Impostazioni iOS: non arriveranno finché non vengono consentite sopra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プッシュ通知は iOS の設定でブロックされています。上で許可するまで届きません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS 설정에서 푸시 알림이 차단되어 있습니다 — 위에서 허용해야 도착합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pushmeldingen zijn geblokkeerd in iOS-instellingen — deze komen niet aan totdat ze hierboven zijn toegestaan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Powiadomienia push są zablokowane w Ustawieniach iOS — nie dotrą, dopóki nie zostaną dozwolone powyżej."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As notificações push estão bloqueadas nos Ajustes do iOS — elas não chegarão até serem permitidas acima."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Push-уведомления заблокированы в настройках iOS — они не будут поступать, пока не будут разрешены выше."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Push-aviseringar är blockerade i iOS-inställningar — dessa kommer inte fram förrän de tillåts ovan."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การแจ้งเตือนแบบพุชถูกบล็อกในการตั้งค่า iOS — จะไม่มาถึงจนกว่าจะได้รับอนุญาตด้านบน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anlık bildirimler iOS Ayarları'nda engellenmiş — yukarıda izin verilmedikçe bunlar ulaşmayacak."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Push-сповіщення заблоковано в Налаштуваннях iOS — вони не надходитимуть, доки не будуть дозволені вище."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thông báo đẩy bị chặn trong Cài đặt iOS — những thông báo này sẽ không đến cho đến khi được cho phép ở trên."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "推送通知在 iOS 设置中被阻止——除非在上方允许，否则将不会送达。"
          }
        }
      }
    },

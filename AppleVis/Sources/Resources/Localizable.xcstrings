    "Showing saved content from %@. Pull down to refresh when online.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Showing saved content from %@. Pull down to refresh when online."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrando contenido guardado de hace %@. Desliza hacia abajo para actualizar cuando estés en línea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affichage du contenu sauvegardé il y a %@. Tirez vers le bas pour actualiser quand vous serez en ligne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeige gespeicherten Inhalt von vor %@. Nach unten ziehen zum Aktualisieren."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Exibindo conteúdo salvo de %@ atrás. Puxe para baixo para atualizar quando estiver online."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Visualizzazione contenuti salvati di %@ fa. Scorri verso il basso per aggiornare quando sei online."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@前に保存したコンテンツを表示中。オンラインになったら下に引っ張って更新してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 전에 저장된 콘텐츠를 표시 중. 온라인 상태에서 아래로 당겨 새로 고침하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opgeslagen inhoud van %@ geleden wordt weergegeven. Trek omlaag om te vernieuwen wanneer je online bent."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在显示%@前保存的内容。联网后下拉刷新。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم عرض المحتوى المحفوظ منذ %@. اسحب للأسفل للتحديث عند الاتصال بالإنترنت."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ पहले सहेजी गई सामग्री दिखाई जा रही है। ऑनलाइन होने पर रिफ्रेश के लिए नीचे खींचें।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "محتوای ذخیره‌شده از %@ پیش نمایش داده می‌شود. وقتی آنلاین شدید به پایین بکشید تا به‌روزرسانی شود."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывается сохранённый контент от %@. Потяните вниз для обновления при наличии сети."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tarihli önbelleğe alınan içerik gösteriliyor. Bağlantı olduğunda yenilemek için aşağı çekin."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyświetlana jest zawartość z pamięci podręcznej z %@. Pociągnij w dół, aby odświeżyć, gdy będzie dostępna sieć."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visar cachad innehåll från %@. Dra nedåt för att uppdatera när nätverk är tillgängligt."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מציג תוכן שנשמר במטמון מ-%@. משוך למטה לרענון כשיש רשת."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menampilkan konten cache dari %@. Tarik ke bawah untuk menyegarkan saat jaringan tersedia."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang hiển thị nội dung được lưu từ %@. Kéo xuống để làm mới khi có mạng."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відображається збережений вміст від %@. Потягніть вниз для оновлення за наявності мережі."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εμφανίζεται αποθηκευμένο περιεχόμενο από %@. Σύρετε προς τα κάτω για ανανέωση όταν υπάρχει δίκτυο."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงเนื้อหาที่แคชจาก %@ ดึงลงเพื่อรีเฟรชเมื่อมีเครือข่าย"
          }
        }
      }
    },

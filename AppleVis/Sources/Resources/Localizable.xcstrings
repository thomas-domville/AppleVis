    "Double tap to include or skip this detail." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انقر مرتين لتضمين هذا التفصيل أو تخطيه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doppeltippen, um dieses Detail einzubeziehen oder zu überspringen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πατήστε δύο φορές για να συμπεριλάβετε ή να παραλείψετε αυτό το στοιχείο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",

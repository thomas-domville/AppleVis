          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tùy chọn này chỉ thay đổi những gì bạn đọc — AppleVis vẫn được viết và kiểm duyệt bằng tiếng Anh, và đăng bài vẫn cần dùng tiếng Anh như trước nay."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",

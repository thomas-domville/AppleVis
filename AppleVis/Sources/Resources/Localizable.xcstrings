          "stringUnit": {
            "state": "translated",
            "value": "Sujets que vous suivez. Enregistrés localement et synchronisés via iCloud."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Themen, denen du folgst. Lokal gespeichert und über iCloud synchronisiert."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tópicos que você segue. Salvos localmente e sincronizados via iCloud."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Argomenti che segui. Salvati localmente e sincronizzati via iCloud."
          }
        },

    "Processes the audio to make voices stand out more clearly against music or background noise." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعالج الصوت لجعل الأصوات أكثر وضوحًا مقابل الموسيقى أو الضجيج الخلفي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verarbeitet das Audio, damit sich Stimmen deutlicher von Musik oder Hintergrundgeräuschen abheben."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επεξεργάζεται τον ήχο ώστε οι φωνές να ξεχωρίζουν πιο καθαρά από τη μουσική ή τον θόρυβο περιβάλλοντος."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Procesa el audio para que las voces destaquen más claramente sobre la música o el ruido de fondo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صدا را پردازش می‌کند تا صداها در برابر موسیقی یا نویز پس‌زمینه واضح‌تر برجسته شوند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traite l'audio pour que les voix ressortent plus clairement sur la musique ou le bruit de fond."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מעבד את השמע כדי שהקולות יבלטו בבירור יותר על רקע מוזיקה או רעש רקע."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "संगीत या पृष्ठभूमि शोर के मुकाबले आवाज़ों को अधिक स्पष्ट रूप से उभारने के लिए ऑडियो को प्रोसेस करता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memproses audio agar suara lebih menonjol dengan jelas dibandingkan musik atau kebisingan latar belakang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elabora l'audio per far risaltare le voci più chiaramente rispetto a musica o rumore di fondo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音楽や背景ノイズに対して声がより明確に際立つよう、オーディオを処理します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "음악이나 배경 소음 속에서도 음성이 더 뚜렷하게 들리도록 오디오를 처리합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwerkt de audio zodat stemmen duidelijker opvallen tegenover muziek of achtergrondgeluid."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przetwarza dźwięk, aby głosy wyraźniej wyróżniały się na tle muzyki lub hałasu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Processa o áudio para fazer as vozes se destacarem mais claramente contra música ou ruído de fundo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обрабатывает звук так, чтобы голоса выделялись более чётко на фоне музыки или шума."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bearbetar ljudet så att röster framträder tydligare mot musik eller bakgrundsljud."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ประมวลผลเสียงเพื่อให้เสียงพูดโดดเด่นชัดเจนขึ้นเมื่อเทียบกับเพลงหรือเสียงรบกวนพื้นหลัง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seslerin müzik veya arka plan gürültüsüne karşı daha net öne çıkması için sesi işler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обробляє звук так, щоб голоси чіткіше виділялися на тлі музики чи фонового шуму."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xử lý âm thanh để giọng nói nổi bật rõ ràng hơn so với nhạc nền hoặc tiếng ồn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "处理音频，使人声在音乐或背景噪音中更加清晰突出。"
          }
        }
      }
    },

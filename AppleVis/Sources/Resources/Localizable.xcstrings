    "Revisit the guided tour of Home, Discover, For You, and Profile & Settings, organized chapter by chapter." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أعد زيارة الجولة الإرشادية للرئيسية، واستكشف، ولك، والملف الشخصي والإعدادات، منظمة فصلًا تلو الآخر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sieh dir den geführten Rundgang durch Home, Entdecken, Für dich und Profil & Einstellungen erneut an, kapitelweise organisiert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επισκεφθείτε ξανά την καθοδηγούμενη περιήγηση στην Αρχική, το Ανακαλύψτε, το Για Εσάς, και το Προφίλ & Ρυθμίσεις, οργανωμένη κεφάλαιο προς κεφάλαιο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuelve a ver el recorrido guiado por Inicio, Descubrir, Para ti, y Perfil y ajustes, organizado capítulo por capítulo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تور راهنمای صفحهٔ اصلی، کاوش، برای شما، و نمایه و تنظیمات را دوباره مرور کنید، که فصل به فصل سازمان‌دهی شده است."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revisitez la visite guidée d'Accueil, Découvrir, Pour vous, et Profil et réglages, organisée chapitre par chapitre."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בקר מחדש בסיור המודרך בבית, גלה, בשבילך, ופרופיל והגדרות, המאורגן פרק אחר פרק."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "होम, डिस्कवर, फ़ॉर यू, और प्रोफ़ाइल और सेटिंग्स के निर्देशित टूर को फिर से देखें, जो अध्याय दर अध्याय व्यवस्थित है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunjungi kembali tur berpandu Beranda, Jelajahi, For You, dan Profil & Pengaturan, yang diatur per bab."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rivisita il tour guidato di Home, Scopri, Per te, e Profilo e impostazioni, organizzato capitolo per capitolo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Home、Discover、For You、プロフィールと設定のガイド付きツアーを、章ごとに整理された形でもう一度見てみましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Home, Discover, For You, 프로필 및 설정의 안내 투어를 챕터별로 정리해서 다시 살펴보세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bekijk de begeleide rondleiding door Start, Ontdek, Voor jou, en Profiel en instellingen opnieuw, georganiseerd hoofdstuk voor hoofdstuk."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Powróć do wycieczki z przewodnikiem po Stronie głównej, Odkrywaj, Dla Ciebie oraz Profilu i ustawieniach, uporządkowanej rozdział po rozdziale."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reveja o tour guiado de Início, Descobrir, Para Você, e Perfil e Configurações, organizado capítulo por capítulo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пересмотрите экскурсию по «Главной», «Обзору», «Для вас» и «Профилю и настройкам», организованную по главам."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se om den guidade rundturen genom Hem, Upptäck, För dig, och Profil och inställningar, organiserad kapitel för kapitel."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ทบทวนทัวร์แนะนำสำหรับโฮม ดิสคัฟเวอร์ ฟอร์ยู และโปรไฟล์และการตั้งค่า ซึ่งจัดเรียงเป็นบทต่าง ๆ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ana Sayfa, Keşfet, Sizin İçin ve Profil ve Ayarlar'ın, bölüm bölüm düzenlenmiş rehberli turunu tekrar gözden geçirin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перегляньте знову керований тур «Головною», «Оглядом», «Для вас» і «Профілем і налаштуваннями», організований за розділами."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xem lại chuyến tham quan có hướng dẫn về Trang chủ, Khám phá, Dành cho bạn, và Hồ sơ & Cài đặt, được tổ chức theo từng chương."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重新查看首页、发现、为你推荐，以及个人资料与设置的引导导览，按章节组织。"
          }
        }
      }
    },
    "Rewinds a few seconds when you resume a paused episode, so you get context instead of picking up mid-sentence." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقوم بالترجيع بضع ثوانٍ عند استئناف حلقة موقوفة مؤقتًا، حتى تحصل على السياق بدلاً من البدء في منتصف الجملة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spult beim Fortsetzen einer pausierten Folge ein paar Sekunden zurück, damit du Kontext bekommst, statt mitten im Satz weiterzumachen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επαναφέρει μερικά δευτερόλεπτα όταν συνεχίζετε ένα επεισόδιο σε παύση, ώστε να αποκτήσετε πλαίσιο αντί να συνεχίσετε στη μέση μιας πρότασης."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retrocede unos segundos al reanudar un episodio en pausa, para que tengas contexto en lugar de retomar a mitad de una frase."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هنگام از سرگیری قسمت متوقف‌شده چند ثانیه عقب می‌رود تا به‌جای شروع از وسط جمله، زمینه را دریافت کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recule de quelques secondes lorsque vous reprenez un épisode en pause, afin d'avoir du contexte plutôt que de reprendre au milieu d'une phrase."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מריץ אחורה כמה שניות כשאתה מחדש פרק שהושהה, כדי שתקבל הקשר במקום להמשיך מאמצע המשפט."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रुके हुए एपिसोड को फिर से शुरू करने पर कुछ सेकंड पीछे जाता है, ताकि आपको वाक्य के बीच से शुरू करने के बजाय संदर्भ मिले。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memundurkan beberapa detik saat Anda melanjutkan episode yang dijeda, sehingga Anda mendapatkan konteks alih-alih melanjutkan di tengah kalimat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riavvolge di qualche secondo quando riprendi un episodio in pausa, così ottieni il contesto invece di riprendere a metà frase."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一時停止したエピソードを再開すると数秒巻き戻し、文の途中からではなく文脈を把握できるようにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일시 중지된 에피소드를 재개할 때 몇 초 되감아 문장 중간부터가 아니라 맥락을 파악할 수 있게 합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spoelt een paar seconden terug wanneer je een gepauzeerde aflevering hervat, zodat je context krijgt in plaats van midden in een zin verder te gaan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przewija kilka sekund do tyłu po wznowieniu wstrzymanego odcinka, dzięki czemu masz kontekst zamiast wznawiania w połowie zdania."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retrocede alguns segundos ao retomar um episódio pausado, para que você tenha contexto em vez de retomar no meio de uma frase."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Немного перематывает назад при возобновлении приостановленного эпизода, чтобы вы вспомнили контекст, а не начали с середины предложения."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spolar tillbaka några sekunder när du återupptar ett pausat avsnitt, så att du får sammanhang istället för att fortsätta mitt i en mening."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ย้อนกลับสองสามวินาทีเมื่อคุณเล่นตอนที่หยุดชั่วคราวต่อ เพื่อให้คุณได้บริบทแทนที่จะเริ่มกลางประโยค"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duraklatılmış bir bölümü sürdürdüğünüzde birkaç saniye geri sararak, cümlenin ortasından değil bağlamla devam etmenizi sağlar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перемотує на кілька секунд назад, коли ви відновлюєте призупинений епізод, щоб ви отримали контекст, а не продовжили посеред речення."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tua lại vài giây khi bạn tiếp tục một tập đã tạm dừng, để bạn có ngữ cảnh thay vì tiếp tục giữa câu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "恢复暂停的单集时回退几秒，让您获得上下文，而不是从句子中间开始。"
          }
        }
      }
    },

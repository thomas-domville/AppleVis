    "Short, friendly tips that pop up here and there — timed to save you a step, not to nag." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نصائح قصيرة وودية تظهر هنا وهناك — مُوقّتة لتوفير خطوة عليك، وليس للإزعاج."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kurze, freundliche Tipps, die hier und da erscheinen – so getimt, dass sie dir einen Schritt ersparen, nicht um dich zu nerven."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σύντομες, φιλικές συμβουλές που εμφανίζονται εδώ κι εκεί — χρονισμένες για να σας εξοικονομήσουν ένα βήμα, όχι για να σας ενοχλούν."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consejos breves y amigables que aparecen aquí y allá, pensados para ahorrarte un paso, no para molestarte."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نکات کوتاه و دوستانه‌ای که اینجا و آنجا ظاهر می‌شوند — زمان‌بندی‌شده برای صرفه‌جویی در یک قدم، نه برای مزاحمت."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De courtes astuces sympathiques qui apparaissent ici et là — programmées pour vous faire gagner une étape, pas pour vous ennuyer."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "טיפים קצרים וידידותיים שקופצים פה ושם — מתוזמנים כדי לחסוך לך שלב, לא להטריד."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "छोटे, मैत्रीपूर्ण टिप्स जो यहां-वहां दिखाई देते हैं — आपको एक कदम बचाने के लिए समयबद्ध, तंग करने के लिए नहीं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tip singkat dan ramah yang muncul di sana-sini — diatur waktunya untuk menghemat langkah Anda, bukan untuk mengganggu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suggerimenti brevi e amichevoli che appaiono qua e là, pensati per farti risparmiare un passaggio, non per infastidirti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あちこちに表示される短くフレンドリーなヒント。1 つの手順を省くタイミングで表示され、しつこく表示されることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여기저기 나타나는 짧고 친근한 팁 — 귀찮게 하려는 게 아니라 시간을 절약해 드리기 위한 것입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Korte, vriendelijke tips die hier en daar verschijnen — getimed om je een stap te besparen, niet om te zeuren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Krótkie, przyjazne wskazówki, które pojawiają się tu i tam — zaplanowane tak, aby oszczędzić Ci krok, a nie naprzykrzać się."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dicas curtas e amigáveis que aparecem aqui e ali — cronometradas para poupar um passo, não para incomodar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Короткие, дружелюбные советы, которые появляются то тут, то там — специально подобраны, чтобы сэкономить вам шаг, а не докучать."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Korta, vänliga tips som dyker upp här och där — tajmade för att spara dig ett steg, inte för att tjata."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เคล็ดลับสั้นๆ ที่เป็นมิตรซึ่งปรากฏขึ้นเป็นครั้งคราว — จับเวลาให้ช่วยประหยัดขั้นตอนให้คุณ ไม่ใช่เพื่อรบกวน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Burada ve orada beliren kısa, samimi ipuçları — sizi rahatsız etmek için değil, bir adım tasarruf ettirmek için zamanlanmıştır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Короткі, дружні поради, які з'являються то тут, то там — підібрані так, щоб зекономити вам крок, а не набридати."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Những mẹo ngắn gọn, thân thiện xuất hiện đây đó — được canh thời điểm để giúp bạn tiết kiệm một bước, không phải để làm phiền."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "简短友好的小贴士会时不时出现——它们出现的时机是为了帮您省一步，而不是打扰您。"
          }
        }
      }
    },
    "Shortens quiet pauses between words." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",

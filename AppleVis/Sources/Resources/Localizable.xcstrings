    "Use your AppleVis website email and password.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use your AppleVis website email and password."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa el correo y contraseña de tu cuenta de AppleVis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez l'e-mail et le mot de passe de votre compte AppleVis."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende die E-Mail-Adresse und das Passwort deines AppleVis-Kontos."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Use o e-mail e a senha da sua conta AppleVis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa l'email e la password del tuo account AppleVis."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AppleVisウェブサイトのメールとパスワードを使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AppleVis 웹사이트 이메일과 비밀번호를 사용하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik het e-mailadres en wachtwoord van je AppleVis-account."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请使用您的AppleVis网站电子邮件和密码。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم البريد الإلكتروني وكلمة المرور الخاصة بحسابك على AppleVis."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने AppleVis वेबसाइट ईमेल और पासवर्ड का उपयोग करें।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "از ایمیل و رمز عبور حساب AppleVis خود استفاده کنید."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте email и пароль от сайта AppleVis."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "AppleVis web sitenizdeki e-posta ve şifrenizi kullanın."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj adresu e-mail i hasła ze strony AppleVis."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Använd din e-post och ditt lösenord från AppleVis webbplats."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השתמש בדואר האלקטרוני והסיסמה מאתר AppleVis."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan email dan kata sandi dari situs web AppleVis Anda."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sử dụng email và mật khẩu từ trang web AppleVis của bạn."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовуйте email і пароль від сайту AppleVis."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χρησιμοποιήστε το email και τον κωδικό από τον ιστότοπο AppleVis."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้อีเมลและรหัสผ่านจากเว็บไซต์ AppleVis ของคุณ"
          }
        }
      }
    },

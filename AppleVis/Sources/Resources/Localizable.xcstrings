          "stringUnit": {
            "state": "translated",
            "value": "Los ajustes están agrupados para que los usuarios de VoiceOver no tengan que deslizar por una larga lista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les réglages sont regroupés pour que les utilisateurs de VoiceOver n'aient pas à balayer une longue liste."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einstellungen sind gruppiert, damit VoiceOver-Nutzer nicht durch eine lange Liste wischen müssen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As configurações são agrupadas para que os usuários do VoiceOver não precisem deslizar por uma longa lista."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le impostazioni sono raggruppate per facilitare la navigazione con VoiceOver."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "VoiceOverユーザーが長いリストをスワイプしなくて済むよう、設定はグループ化されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "VoiceOver 사용자가 긴 목록을 스와이프하지 않도록 설정이 그룹화되어 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Instellingen zijn gegroepeerd zodat VoiceOver-gebruikers niet door een lange lijst hoeven te vegen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置已分组，以便VoiceOver用户无需在长列表中滑动。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإعدادات مجمّعة حتى لا يضطر مستخدمو VoiceOver إلى التمرير خلال قائمة طويلة."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सेटिंग्स को समूहीकृत किया गया है ताकि VoiceOver उपयोगकर्ताओं को लंबी सूची में स्वाइप न करना पड़े।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تنظیمات گروه‌بندی شده‌اند تا کاربران VoiceOver مجبور به پیمایش در یک لیست طولانی نباشند."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройки сгруппированы, чтобы пользователям VoiceOver не приходилось листать длинный список переключателей."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "VoiceOver kullanıcılarının uzun bir geçiş listesinde gezinmesi gerekmemesi için ayarlar gruplandırılmıştır."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustawienia są pogrupowane, aby użytkownicy VoiceOver nie musieli przewijać długiej listy przełączników."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inställningar är grupperade så att VoiceOver-användare inte behöver navigera genom en lång lista med reglage."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההגדרות מקובצות כדי שמשתמשי VoiceOver לא יצטרכו לנווט ברשימה ארוכה של מתגים."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengaturan dikelompokkan agar pengguna VoiceOver tidak perlu menavigasi daftar sakelar yang panjang."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cài đặt được nhóm lại để người dùng VoiceOver không cần điều hướng qua danh sách chuyển đổi dài."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Налаштування згруповано, щоб користувачам VoiceOver не доводилося гортати довгий список перемикачів."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι ρυθμίσεις είναι ομαδοποιημένες ώστε οι χρήστες VoiceOver να μην χρειάζεται να πλοηγηθούν σε μια μακρά λίστα διακοπτών."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การตั้งค่าถูกจัดกลุ่มเพื่อให้ผู้ใช้ VoiceOver ไม่ต้องนำทางผ่านรายการสวิตช์ยาว"
          }
        }
      }
    },

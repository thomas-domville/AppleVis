          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleVis vraagt leden de forums niet te gebruiken om hun eigen podcast, YouTube-kanaal, website, nieuwsbrief of andere bron te promoten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleVis prosi członków, by nie używali forów do promowania własnego podcastu, kanału YouTube, strony internetowej, newslettera ani innych zasobów."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O AppleVis pede que os membros não usem os fóruns para promover o próprio podcast, canal do YouTube, site, newsletter ou outro recurso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleVis просит участников не использовать форумы для продвижения своего подкаста, канала на YouTube, сайта, рассылки или другого ресурса."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleVis ber medlemmarna att inte använda forumen för att marknadsföra sin egen podd, YouTube-kanal, webbplats, sitt nyhetsbrev eller annan resurs."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleVis ขอให้สมาชิกไม่ใช้ฟอรัมเพื่อโปรโมตพอดแคสต์ ช่อง YouTube เว็บไซต์ จดหมายข่าว หรือแหล่งข้อมูลอื่นของตนเอง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleVis, üyelerden forumları kendi podcast'lerini, YouTube kanallarını, web sitelerini, bültenlerini veya başka kaynaklarını tanıtmak için kullanmamalarını ister."
          }

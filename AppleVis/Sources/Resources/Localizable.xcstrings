          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleVis сохраняет естественное звучание голосов при более высокой скорости воспроизведения."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleVis håller röster naturliga även vid snabbare uppspelningshastigheter."

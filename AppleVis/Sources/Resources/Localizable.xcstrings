          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パスワードをお忘れの場合は、AppleVis のウェブサイトで再設定できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "비밀번호를 잊으셨다면 AppleVis 웹사이트에서 재설정할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je je wachtwoord bent vergeten, kun je het opnieuw instellen op de AppleVis-website."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",

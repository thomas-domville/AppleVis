    "Sends a private message through AppleVis. Your email address is not shared unless they reply." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يرسل رسالة خاصة عبر AppleVis. لا تتم مشاركة عنوان بريدك الإلكتروني إلا إذا ردّوا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sendet eine private Nachricht über AppleVis. Deine E-Mail-Adresse wird nur geteilt, wenn sie antworten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Στέλνει ένα ιδιωτικό μήνυμα μέσω του AppleVis. Η διεύθυνση email σας δεν κοινοποιείται εκτός αν απαντήσουν."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envía un mensaje privado a través de AppleVis. Tu dirección de correo electrónico no se comparte a menos que respondan."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پیامی خصوصی از طریق AppleVis ارسال می‌کند. آدرس ایمیل شما به‌اشتراک گذاشته نمی‌شود مگر اینکه پاسخ دهند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoie un message privé via AppleVis. Votre adresse e-mail n'est pas partagée sauf s'ils répondent."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שולח הודעה פרטית דרך AppleVis. כתובת האימייל שלך אינה משותפת אלא אם כן הם משיבים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleVis के माध्यम से एक निजी संदेश भेजता है। जब तक वे उत्तर नहीं देते, आपका ईमेल पता साझा नहीं किया जाता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengirim pesan pribadi melalui AppleVis. Alamat email Anda tidak dibagikan kecuali mereka membalas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invia un messaggio privato tramite AppleVis. Il tuo indirizzo email non viene condiviso a meno che non rispondano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleVis 経由でプライベートメッセージを送信します。相手が返信しない限り、メールアドレスは共有されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleVis를 통해 비공개 메시지를 보냅니다. 상대방이 답장하지 않는 한 이메일 주소는 공유되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verstuurt een privébericht via AppleVis. Je e-mailadres wordt niet gedeeld tenzij ze antwoorden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wysyła prywatną wiadomość przez AppleVis. Twój adres e-mail nie jest udostępniany, chyba że odpowiedzą."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envia uma mensagem privada pela AppleVis. Seu endereço de e-mail não é compartilhado a menos que respondam."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отправляет личное сообщение через AppleVis. Ваш адрес электронной почты не передаётся, пока собеседник не ответит."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skickar ett privat meddelande via AppleVis. Din e-postadress delas inte om de inte svarar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ส่งข้อความส่วนตัวผ่าน AppleVis ที่อยู่อีเมลของคุณจะไม่ถูกแชร์เว้นแต่พวกเขาจะตอบกลับ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleVis üzerinden özel bir mesaj gönderir. Yanıt vermedikleri sürece e-posta adresiniz paylaşılmaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Надсилає приватне повідомлення через AppleVis. Вашу електронну адресу не буде розголошено, доки вони не дадуть відповідь."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gửi tin nhắn riêng qua AppleVis. Địa chỉ email của bạn không được chia sẻ trừ khi họ trả lời."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过 AppleVis 发送私信。除非对方回复，否则不会分享您的电子邮件地址。"
          }
        }
      }
    },

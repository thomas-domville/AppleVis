    "%@. Double-tap to open player." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. اضغط مرتين لفتح المشغّل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Doppeltippen, um den Player zu öffnen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Πατήστε δύο φορές για να ανοίξετε τον player."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Toca dos veces para abrir el reproductor."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. برای باز کردن پخش‌کننده دوبار ضربه بزنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Touchez deux fois pour ouvrir le lecteur."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. הקש הקשה כפולה כדי לפתוח את הנגן."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. प्लेयर खोलने के लिए डबल-टैप करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Ketuk dua kali untuk membuka pemutar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Tocca due volte per aprire il player."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@。ダブルタップしてプレーヤーを開きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. 두 번 탭하여 플레이어를 엽니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Dubbeltik om de speler te openen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Stuknij dwukrotnie, aby otworzyć odtwarzacz."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Toque duas vezes para abrir o player."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Дважды коснитесь, чтобы открыть плеер."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Dubbeltryck för att öppna spelaren."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",

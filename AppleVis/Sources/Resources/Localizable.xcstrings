    "Continues using AppleVis without signing in. You can review the agreement again later." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستمر في استخدام AppleVis دون تسجيل الدخول. يمكنك مراجعة الاتفاقية مرة أخرى لاحقًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutzt AppleVis weiter, ohne dich anzumelden. Du kannst die Vereinbarung später erneut ansehen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Συνεχίζει τη χρήση του AppleVis χωρίς σύνδεση. Μπορείτε να δείτε ξανά τη συμφωνία αργότερα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continúa usando AppleVis sin iniciar sesión. Puedes revisar el acuerdo de nuevo más tarde."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بدون ورود، استفاده از AppleVis را ادامه می‌دهد. می‌توانید بعداً دوباره توافقنامه را مرور کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continue à utiliser AppleVis sans se connecter. Vous pourrez consulter à nouveau l'accord plus tard."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ממשיך להשתמש ב-AppleVis בלי להתחבר. תוכל/י לעיין שוב בהסכם מאוחר יותר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "साइन इन किए बिना AppleVis का उपयोग जारी रखता है। आप बाद में समझौते की फिर से समीक्षा कर सकते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melanjutkan penggunaan AppleVis tanpa masuk. Anda dapat meninjau perjanjian lagi nanti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continua a usare AppleVis senza accedere. Potrai rivedere l'accordo di nuovo in seguito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サインインせずにAppleVisの利用を続けます。この規約は後でもう一度確認できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로그인하지 않고 AppleVis 사용을 계속합니다. 나중에 다시 동의 내용을 확인할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",

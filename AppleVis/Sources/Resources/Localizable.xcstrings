          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wskazówka Apple Intelligence: wybierz dowolny wpisany tekst, aby sprawdzić, przepisać, skrócić lub przetłumaczyć go za pomocą Writing Tools."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dica do Apple Intelligence: selecione qualquer texto para corrigi-lo, reescrevê-lo ou traduzi-lo com Writing Tools."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Совет Apple Intelligence: выберите любой введённый текст, чтобы проверить, переписать, сократить или перевести его с помощью Writing Tools."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence-tips: välj skriven text för att kontrollera, skriva om, korta ner eller översätta med Writing Tools."

    "Apple Intelligence tip: select any text you type to proofread, rewrite, shorten, or translate it using Writing Tools." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تلميح Apple Intelligence: حدد أي نص لمراجعته أو إعادة كتابته أو ترجمته باستخدام Writing Tools."
          }
        },
        "de" : {
          "stringUnit" : {

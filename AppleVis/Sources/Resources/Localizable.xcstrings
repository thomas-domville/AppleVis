        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence ipucu: Yazma Araçları ile denetlemek, yeniden yazmak, kısaltmak veya çevirmek için herhangi bir girdi metnini seçin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",

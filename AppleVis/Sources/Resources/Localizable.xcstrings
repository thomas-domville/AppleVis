    "Pauses playback on its own after the time you pick — handy for drifting off without an episode playing all night." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يوقف التشغيل مؤقتًا تلقائيًا بعد الوقت الذي تختاره — مفيد للنوم دون تشغيل حلقة طوال الليل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausiert die Wiedergabe von selbst nach der gewählten Zeit – praktisch, um einzuschlafen, ohne dass eine Folge die ganze Nacht läuft."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Θέτει την αναπαραγωγή σε παύση από μόνη της μετά τον χρόνο που επιλέγετε — χρήσιμο για να αποκοιμηθείτε χωρίς να παίζει ένα επεισόδιο όλη τη νύχτα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausa la reproducción automáticamente después del tiempo que elijas, útil para quedarte dormido sin que un episodio suene toda la noche."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پس از مدت انتخاب‌شده، پخش را خودش متوقف می‌کند — برای به خواب رفتن بدون پخش قسمت تا صبح مفید است."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met la lecture en pause automatiquement après la durée choisie — pratique pour s'endormir sans qu'un épisode joue toute la nuit."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "משהה את ההשמעה בעצמו לאחר הזמן שבחרת — שימושי כדי להירדם מבלי שפרק ינגן כל הלילה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके द्वारा चुने गए समय के बाद अपने आप प्लेबैक रोक देता है — रातभर एपिसोड चलाए बिना सोने के लिए उपयोगी।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menjeda pemutaran secara otomatis setelah waktu yang Anda pilih — berguna untuk tertidur tanpa episode diputar sepanjang malam."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mette in pausa la riproduzione da sola dopo il tempo scelto: utile per addormentarsi senza che un episodio suoni tutta la notte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択した時間が経過すると再生を自動的に一時停止します。エピソードが一晩中再生され続けることなく眠りにつくのに便利です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택한 시간이 지나면 자동으로 재생을 일시 중지합니다 — 밤새 에피소드가 재생되지 않고 잠들 때 유용합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onderbreekt het afspelen automatisch na de gekozen tijd — handig om in slaap te vallen zonder dat een aflevering de hele nacht speelt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wstrzymuje odtwarzanie samodzielnie po wybranym czasie — przydatne do zasypiania bez odtwarzania odcinka całą noc."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausa a reprodução sozinha após o tempo escolhido — útil para adormecer sem um episódio tocando a noite toda."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Автоматически приостанавливает воспроизведение по истечении выбранного времени — удобно для засыпания без проигрывания эпизода всю ночь."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausar uppspelningen automatiskt efter den tid du väljer — praktiskt för att somna utan att ett avsnitt spelas hela natten."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หยุดการเล่นเองหลังจากเวลาที่คุณเลือก — มีประโยชน์สำหรับการเผลอหลับโดยไม่มีตอนเล่นตลอดคืน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seçtiğiniz sürenin ardından oynatmayı kendiliğinden duraklatır — bütün gece bir bölüm oynatmadan uykuya dalmak için kullanışlıdır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Автоматично призупиняє відтворення після обраного вами часу — зручно, щоб заснути без відтворення епізоду всю ніч."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tự động tạm dừng phát sau khoảng thời gian bạn chọn — hữu ích để ngủ quên mà không có tập phát cả đêm."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在所选时间后自动暂停播放——适合入睡时使用，避免整晚播放。"
          }
        }
      }
    },

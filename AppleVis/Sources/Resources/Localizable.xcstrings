          "stringUnit" : {
            "state" : "translated",
            "value" : "وقتی کسی پاسخ دهد به شما اطلاع می‌دهد. می‌توانید هر زمان از خود موضوع دنبال‌کردن را لغو کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avertit lorsque quelqu'un répond. Vous pouvez ne plus suivre à tout moment depuis le sujet lui-même."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מודיע לך כאשר מישהו משיב. תוכל להפסיק לעקוב בכל עת מהנושא עצמו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब कोई उत्तर देता है तो सूचित करता है। आप विषय से कभी भी अनफ़ॉलो कर सकते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memberi tahu Anda saat seseorang membalas. Anda dapat berhenti mengikuti kapan saja dari topik itu sendiri."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti avvisa quando qualcuno risponde. Puoi smettere di seguire in qualsiasi momento direttamente dall'argomento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "返信があると通知します。トピック自体からいつでもフォローを解除できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "누군가 답장을 하면 알려줍니다. 주제 자체에서 언제든지 팔로우를 취소할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meldt je wanneer iemand reageert. Je kunt op elk moment ontvolgen vanuit het onderwerp zelf."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Powiadamia Cię, gdy ktoś odpowiada. Możesz przestać obserwować w dowolnym momencie bezpośrednio z wątku."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notifica você quando alguém responde. Você pode deixar de seguir a qualquer momento a partir do próprio tópico."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уведомляет вас, когда кто-то отвечает. Вы можете отписаться в любое время прямо в теме."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meddelar dig när någon svarar. Du kan sluta följa när som helst direkt från själva ämnet."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แจ้งเตือนคุณเมื่อมีคนตอบกลับ คุณสามารถเลิกติดตามได้ทุกเมื่อจากตัวหัวข้อเอง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biri yanıt verdiğinde sizi bilgilendirir. Konunun kendisinden istediğiniz zaman takibi bırakabilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повідомляє вас, коли хтось відповідає. Ви можете скасувати підписку будь-коли прямо з теми."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thông báo cho bạn khi ai đó trả lời. Bạn có thể bỏ theo dõi bất cứ lúc nào ngay từ chủ đề đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当有人回复时通知您。您可以随时在话题本身中取消关注。"
          }
        }
      }
    },

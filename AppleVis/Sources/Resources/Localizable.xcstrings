    "This removes all episodes from your queue. Downloaded episodes will not be deleted." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يؤدي هذا إلى إزالة جميع الحلقات من قائمة الانتظار الخاصة بك. لن يتم حذف الحلقات التي تم تنزيلها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch werden alle Folgen aus deiner Warteschlange entfernt. Heruntergeladene Folgen werden nicht gelöscht."

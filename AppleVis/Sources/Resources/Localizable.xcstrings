    "Swipe up or down to choose how far back to count recommendations." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسحب لأعلى أو لأسفل لاختيار المدة التي تُحسب فيها التوصيات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Streiche nach oben oder unten, um festzulegen, wie weit zurück Empfehlungen gezählt werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σαρώστε προς τα πάνω ή κάτω για να επιλέξετε πόσο πίσω θα μετρώνται οι συστάσεις."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desliza hacia arriba o hacia abajo para elegir hasta cuándo contar las recomendaciones."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای انتخاب اینکه توصیه‌ها از چه زمانی شمرده شوند، به بالا یا پایین بکشید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balayez vers le haut ou le bas pour choisir jusqu’où remonter dans les recommandations."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "החלק למעלה או למטה כדי לבחור כמה זמן אחורה לספור המלצות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कितने पीछे तक की अनुशंसाएँ गिनी जाएँ, यह चुनने के लिए ऊपर या नीचे स्वाइप करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gesek ke atas atau ke bawah untuk memilih seberapa jauh rekomendasi dihitung."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scorri in alto o in basso per scegliere quanto indietro contare i consigli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上下にスワイプして、どこまでさかのぼっておすすめを数えるかを選びます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "위나 아래로 쓸어서 추천을 얼마나 이전까지 셀지 선택합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veeg omhoog of omlaag om te kiezen hoe ver terug aanbevelingen worden geteld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przesuń w górę lub w dół, aby wybrać, jak daleko wstecz liczyć polecenia."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deslize para cima ou para baixo para escolher até quando contar as recomendações."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Смахните вверх или вниз, чтобы выбрать, за какой срок считать рекомендации."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svep uppåt eller nedåt för att välja hur långt tillbaka rekommendationer räknas."
          }

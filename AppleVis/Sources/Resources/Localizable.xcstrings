        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将删除%@的缓存内容。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيؤدي هذا إلى إزالة %@ من المحتوى المخزَّن مؤقتاً."

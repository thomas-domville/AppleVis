    "Cached articles and metadata older than this will be automatically removed." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستتم إزالة المقالات والبيانات الوصفية المخزنة مؤقتًا الأقدم من هذا تلقائيًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zwischengespeicherte Artikel und Metadaten, die älter als dieser Zeitraum sind, werden automatisch entfernt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα προσωρινά αποθηκευμένα άρθρα και μεταδεδομένα παλαιότερα από αυτό θα καταργηθούν αυτόματα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los artículos y metadatos en caché más antiguos que este período se eliminarán automáticamente."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مقالات و ابرداده‌های ذخیره‌شدهٔ موقتی که قدیمی‌تر از این باشند، به‌طور خودکار حذف خواهند شد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les articles et métadonnées mis en cache plus anciens que cette période seront automatiquement supprimés."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מאמרים ומטא-נתונים שמורים במטמון שישנים יותר מכך יוסרו אוטומטית."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इससे पुराने कैश किए गए लेख और मेटाडेटा स्वचालित रूप से हटा दिए जाएंगे।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artikel dan metadata cache yang lebih lama dari ini akan otomatis dihapus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli articoli e i metadati memorizzati nella cache più vecchi di questo periodo verranno rimossi automaticamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この期間より古いキャッシュされた記事とメタデータは自動的に削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기간보다 오래된 캐시된 기사와 메타데이터는 자동으로 제거됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gecachte artikelen en metadata die ouder zijn dan dit, worden automatisch verwijderd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zbuforowane artykuły i metadane starsze niż ten okres zostaną automatycznie usunięte."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artigos e metadados em cache mais antigos do que isso serão removidos automaticamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кешированные статьи и метаданные старше этого срока будут автоматически удалены."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cachade artiklar och metadata äldre än detta tas bort automatiskt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บทความและข้อมูลเมตาในแคชที่เก่ากว่านี้จะถูกลบโดยอัตโนมัติ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bundan daha eski önbelleğe alınmış makaleler ve meta veriler otomatik olarak kaldırılacak."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кешовані статті та метадані, старіші за цей період, буде автоматично видалено."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bài viết và siêu dữ liệu đã lưu vào bộ nhớ đệm cũ hơn khoảng thời gian này sẽ tự động bị xóa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "早于此时长的缓存文章和元数据将被自动移除。"
          }
        }
      }
    },
    "Cached articles and metadata will be removed. Content will reload from the server on next view." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستتم إزالة المقالات والبيانات الوصفية المخزنة مؤقتًا. ستتم إعادة تحميل المحتوى من الخادم عند العرض التالي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",

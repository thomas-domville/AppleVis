    "Notifies you when someone replies. You can unfollow anytime from the topic itself." : {
      "comment" : "A hint for the user on how to unfollow a topic.",
      "extractionState" : "manual",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُخطرك عند رد شخص ما. يمكنك إلغاء المتابعة في أي وقت من الموضوع نفسه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",

    "AppleVis itself is not open source. All app code is copyright AppleVis and its contributors." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleVis نفسها ليست مفتوحة المصدر. جميع أكواد التطبيق محمية بحقوق نشر لـ AppleVis والمساهمين فيها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleVis selbst ist nicht Open Source. Der gesamte App-Code unterliegt dem Urheberrecht von AppleVis und seinen Mitwirkenden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το ίδιο το AppleVis δεν είναι ανοιχτού κώδικα. Όλος ο κώδικας της εφαρμογής έχει πνευματικά δικαιώματα του AppleVis και των συνεισφερόντων του."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleVis en sí no es de código abierto. Todo el código de la app tiene copyright de AppleVis y sus colaboradores."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خود AppleVis متن‌باز نیست. تمام کد برنامه دارای حق نشر متعلق به AppleVis و همکارانش است."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleVis elle-même n'est pas open source. Tout le code de l'appli est protégé par le droit d'auteur d'AppleVis et de ses contributeurs."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleVis עצמה אינה קוד פתוח. כל קוד האפליקציה מוגן בזכויות יוצרים של AppleVis והתורמים לה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleVis स्वयं ओपन सोर्स नहीं है। सभी ऐप कोड AppleVis और उसके योगदानकर्ताओं का कॉपीराइट है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleVis sendiri bukan sumber terbuka. Semua kode aplikasi berhak cipta AppleVis dan kontributornya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleVis stessa non è open source. Tutto il codice dell'app è protetto da copyright di AppleVis e dei suoi collaboratori."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleVis 自体はオープンソースではありません。アプリのコードはすべて AppleVis およびその貢献者の著作物です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleVis 자체는 오픈 소스가 아닙니다. 모든 앱 코드의 저작권은 AppleVis와 기여자에게 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleVis zelf is geen open source. Alle app-code valt onder het auteursrecht van AppleVis en zijn medewerkers."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sama aplikacja AppleVis nie jest open source. Cały kod aplikacji jest objęty prawami autorskimi AppleVis i jej współtwórców."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A própria AppleVis não é de código aberto. Todo o código do app tem direitos autorais da AppleVis e de seus colaboradores."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Само приложение AppleVis не является открытым исходным кодом. Весь код приложения защищён авторским правом AppleVis и его участников."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleVis i sig är inte öppen källkod. All appkod är upphovsrättsskyddad av AppleVis och dess bidragsgivare."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตัว AppleVis เองไม่ใช่ซอฟต์แวร์โอเพนซอร์ส โค้ดแอปทั้งหมดเป็นลิขสิทธิ์ของ AppleVis และผู้ร่วมให้ข้อมูล"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleVis'in kendisi açık kaynak değildir. Tüm uygulama kodu AppleVis ve katkıda bulunanlarının telif hakkına sahiptir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сам AppleVis не є проєктом із відкритим кодом. Увесь код застосунку захищено авторським правом AppleVis та його учасників."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bản thân AppleVis không phải mã nguồn mở. Toàn bộ mã ứng dụng thuộc bản quyền của AppleVis và những người đóng góp."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleVis 本身并非开源。所有应用代码的版权均归 AppleVis 及其贡献者所有。"
          }
        }
      }
    },
    "AppleVis keeps voices sounding natural at faster playback speeds." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحافظ AppleVis على صوت طبيعي للأصوات حتى عند سرعات تشغيل أسرع."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleVis sorgt dafür, dass Stimmen auch bei höheren Wiedergabegeschwindigkeiten natürlich klingen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το AppleVis διατηρεί τις φωνές φυσικές σε ταχύτερες ταχύτητες αναπαραγωγής."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleVis mantiene las voces sonando naturales a velocidades de reproducción más rápidas."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleVis صداها را حتی در سرعت‌های پخش بالاتر طبیعی نگه می‌دارد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleVis conserve un rendu vocal naturel même à des vitesses de lecture plus rapides."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleVis שומרת על צליל טבעי לקולות גם במהירויות השמעה מהירות יותר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleVis तेज़ प्लेबैक गति पर भी आवाज़ों को स्वाभाविक बनाए रखता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleVis menjaga suara tetap terdengar alami pada kecepatan pemutaran yang lebih cepat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleVis mantiene le voci naturali anche a velocità di riproduzione più elevate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleVis は、再生速度を上げても音声が自然に聞こえるようにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleVis는 재생 속도를 높여도 음성이 자연스럽게 들리도록 유지합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleVis zorgt ervoor dat stemmen natuurlijk blijven klinken bij hogere afspeelsnelheden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleVis sprawia, że głosy brzmią naturalnie nawet przy szybszym odtwarzaniu."
          }
        },
        "pt" : {
          "stringUnit" : {

    "Setup Focuses Welcome First" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الإعداد يركّز أولًا على الترحيب"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einrichtung setzt den Fokus zuerst auf Willkommen"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η ρύθμιση εστιάζει πρώτα στο Καλώς ορίσατε"
          }
        },
        "es" : {
          "stringUnit" : {

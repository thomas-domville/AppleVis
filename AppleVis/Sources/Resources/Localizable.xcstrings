          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phát âm thanh cho những khoảnh khắc đáng chú ý — lưu, tải xuống hoàn tất, thông báo, và phát/tạm dừng podcast."

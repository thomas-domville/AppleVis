          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. إذا نسيت كلمة المرور، يمكنك إعادة تعيينها على موقع AppleVis."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Wenn du dein Passwort vergessen hast, kannst du es auf der AppleVis-Website zurücksetzen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Αν έχετε ξεχάσει τον κωδικό πρόσβασής σας, μπορείτε να τον επαναφέρετε στον ιστότοπο του AppleVis."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Si olvidaste tu contraseña, puedes restablecerla en el sitio web de AppleVis."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. اگر رمز عبور خود را فراموش کرده‌اید، می‌توانید آن را در وب‌سایت AppleVis بازنشانی کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Si vous avez oublié votre mot de passe, vous pouvez le réinitialiser sur le site AppleVis."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. אם שכחת את הסיסמה שלך, תוכל לאפס אותה באתר AppleVis."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. यदि आप अपना पासवर्ड भूल गए हैं, तो आप इसे AppleVis वेबसाइट पर रीसेट कर सकते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Jika Anda lupa kata sandi, Anda dapat mengaturnya ulang di situs web AppleVis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Se hai dimenticato la password, puoi reimpostarla sul sito web di AppleVis."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@。パスワードをお忘れの場合は、AppleVis のウェブサイトで再設定できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. 비밀번호를 잊으셨다면 AppleVis 웹사이트에서 재설정할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Als je je wachtwoord bent vergeten, kun je het opnieuw instellen op de AppleVis-website."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Jeśli zapomniałeś hasła, możesz je zresetować na stronie AppleVis."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Se você esqueceu sua senha, pode redefini-la no site da AppleVis."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Если вы забыли пароль, вы можете сбросить его на сайте AppleVis."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Om du har glömt ditt lösenord kan du återställa det på AppleVis webbplats."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ หากคุณลืมรหัสผ่าน คุณสามารถรีเซ็ตได้ที่เว็บไซต์ AppleVis"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Şifrenizi unuttuysanız AppleVis web sitesinden sıfırlayabilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Якщо ви забули пароль, можете скинути його на сайті AppleVis."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Nếu bạn quên mật khẩu, bạn có thể đặt lại trên trang web AppleVis."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@。如果您忘记了密码，可以在 AppleVis 网站上重置。"
          }
        }
      }
    },

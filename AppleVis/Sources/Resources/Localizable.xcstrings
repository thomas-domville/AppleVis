        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleVis'in kendisi açık kaynak değildir. Tüm uygulama kodu AppleVis ve katkıda bulunanlarının telif hakkına sahiptir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сам AppleVis не є проєктом із відкритим кодом. Увесь код застосунку захищено авторським правом AppleVis та його учасників."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bản thân AppleVis không phải mã nguồn mở. Toàn bộ mã ứng dụng thuộc bản quyền của AppleVis và những người đóng góp."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleVis 本身并非开源。所有应用代码的版权均归 AppleVis 及其贡献者所有。"
          }
        }
      }
    },
    "AppleVis keeps voices sounding natural at faster playback speeds." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحافظ AppleVis على صوت طبيعي للأصوات حتى عند سرعات تشغيل أسرع."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleVis sorgt dafür, dass Stimmen auch bei höheren Wiedergabegeschwindigkeiten natürlich klingen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το AppleVis διατηρεί τις φωνές φυσικές σε ταχύτερες ταχύτητες αναπαραγωγής."

        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дані, синхронізовані через iCloud, захищені наскрізним шифруванням Apple. AppleVis не може їх прочитати."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dữ liệu đồng bộ qua iCloud dùng mã hóa đầu cuối của Apple. AppleVis không thể đọc được."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {

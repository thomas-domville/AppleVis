    "Makes voices clearer and more prominent." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يجعل الأصوات أكثر وضوحًا وبروزًا."

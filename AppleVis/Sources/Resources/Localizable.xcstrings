    "A tab-by-tab walkthrough of Home, Discover, For You, and Profile & Settings — go at your own pace, and skip or pause anytime." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جولة تفصيلية عبر تبويبات الرئيسية، واستكشف، ولك، والملف الشخصي والإعدادات — سر بوتيرتك الخاصة، وتخطَّ أو أوقف مؤقتًا في أي وقت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Rundgang Tab für Tab durch Home, Entdecken, Für dich und Profil & Einstellungen – gehe in deinem eigenen Tempo vor und überspringe oder pausiere jederzeit."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μια περιήγηση καρτέλα προς καρτέλα στην Αρχική, το Ανακαλύψτε, το Για Εσάς, και το Προφίλ & Ρυθμίσεις — προχωρήστε με τον δικό σας ρυθμό, και παραλείψτε ή κάντε παύση όποτε θέλετε."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un recorrido pestaña por pestaña por Inicio, Descubrir, Para ti, y Perfil y ajustes — avanza a tu propio ritmo, y omite o pausa cuando quieras."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مروری برگه‌به‌برگه بر صفحهٔ اصلی، کاوش، برای شما، و نمایه و تنظیمات — با سرعت خودتان پیش بروید و هر وقت خواستید رد کنید یا متوقف کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une visite onglet par onglet d'Accueil, Découvrir, Pour vous, et Profil et réglages — allez à votre propre rythme, et passez ou mettez en pause à tout moment."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "סיור לשונית אחר לשונית בבית, גלה, בשבילך, ופרופיל והגדרות — התקדם בקצב שלך, ודלג או השהה בכל עת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "होम, डिस्कवर, फ़ॉर यू, और प्रोफ़ाइल और सेटिंग्स का टैब-दर-टैब वॉकथ्रू — अपनी गति से आगे बढ़ें, और कभी भी स्किप या पॉज़ करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panduan tab demi tab untuk Beranda, Jelajahi, For You, dan Profil & Pengaturan — jalani dengan kecepatan Anda sendiri, dan lewati atau jeda kapan saja."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un percorso scheda per scheda tra Home, Scopri, Per te, e Profilo e impostazioni — procedi al tuo ritmo, e salta o metti in pausa quando vuoi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Home、Discover、For You、そしてプロフィールと設定を1つずつ巡るタブごとのガイドです。自分のペースで進み、いつでもスキップしたり一時停止したりできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Home, Discover, For You, 프로필 및 설정을 탭별로 살펴보는 안내예요 — 원하는 속도로 진행하고, 언제든 건너뛰거나 일시 중지할 수 있어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een tabblad-voor-tabblad rondleiding door Start, Ontdek, Voor jou, en Profiel en instellingen — ga in je eigen tempo, en sla over of pauzeer wanneer je wilt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przewodnik po kartach Strona główna, Odkrywaj, Dla Ciebie oraz Profil i ustawienia — poruszaj się we własnym tempie i pomijaj lub wstrzymuj w dowolnym momencie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um passo a passo aba por aba de Início, Descobrir, Para Você, e Perfil e Configurações — vá no seu próprio ritmo, e pule ou pause quando quiser."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пошаговый обзор вкладок «Главная», «Обзор», «Для вас» и «Профиль и настройки» — двигайтесь в своём темпе и пропускайте или приостанавливайте в любой момент."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En genomgång flik för flik av Hem, Upptäck, För dig, och Profil och inställningar — gå i din egen takt, och hoppa över eller pausa när som helst."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คำแนะนำทีละแท็บสำหรับโฮม ดิสคัฟเวอร์ ฟอร์ยู และโปรไฟล์และการตั้งค่า — ทำตามจังหวะของคุณเอง และข้ามหรือหยุดชั่วคราวได้ทุกเมื่อ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ana Sayfa, Keşfet, Sizin İçin ve Profil ve Ayarlar'ı sekme sekme anlatan bir tur — kendi hızınızda ilerleyin, istediğiniz zaman atlayın veya duraklatın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Покроковий огляд вкладок «Головна», «Огляд», «Для вас» і «Профіль і налаштування» — рухайтесь у своєму темпі, пропускайте чи призупиняйте будь-коли."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hướng dẫn từng tab một cho Trang chủ, Khám phá, Dành cho bạn, và Hồ sơ & Cài đặt — đi theo tốc độ của riêng bạn, và bỏ qua hoặc tạm dừng bất cứ lúc nào."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "逐个标签页介绍首页、发现、为你推荐，以及个人资料与设置——按你自己的节奏进行，随时可以跳过或暂停。"
          }
        }
      }
    },

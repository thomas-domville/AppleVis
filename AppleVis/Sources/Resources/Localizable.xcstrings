        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store から名前で自動的に照合されました。AppleVis による確認はまだです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",

    "Save a topic, app, guide, blog post, or episode and it'll show up here so you can find it again." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "احفظ موضوعًا أو تطبيقًا أو دليلًا أو منشور مدونة أو حلقة، وستظهر هنا لتتمكن من العثور عليها مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speichere ein Thema, eine App, einen Leitfaden, einen Blogbeitrag oder eine Folge, und sie erscheinen hier, damit du sie wiederfindest."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αποθηκεύστε ένα θέμα, μια εφαρμογή, έναν οδηγό, μια ανάρτηση ιστολογίου ή ένα επεισόδιο και θα εμφανιστεί εδώ, ώστε να μπορείτε να το βρείτε ξανά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda un tema, una app, una guía, una entrada de blog o un episodio, y aparecerá aquí para que puedas encontrarlo de nuevo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "موضوع، برنامه، راهنما، پست وبلاگ یا قسمتی را ذخیره کنید تا اینجا نمایش داده شود و بتوانید دوباره آن را پیدا کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrez un sujet, une appli, un guide, un article de blog ou un épisode, et il apparaîtra ici pour que vous puissiez le retrouver facilement."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שמור נושא, אפליקציה, מדריך, פוסט בבלוג או פרק, והוא יופיע כאן כדי שתוכל למצוא אותו שוב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोई विषय, ऐप, गाइड, ब्लॉग पोस्ट या एपिसोड सहेजें और वह यहां दिखाई देगा ताकि आप उसे दोबारा ढूंढ सकें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simpan topik, aplikasi, panduan, postingan blog, atau episode, dan akan muncul di sini agar kamu bisa menemukannya lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salva un argomento, un'app, una guida, un articolo del blog o un episodio e comparirà qui, così potrai ritrovarlo facilmente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トピック、アプリ、ガイド、ブログ記事、エピソードのいずれかを保存すると、ここに表示されるので、あとで見つけやすくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "토픽, 앱, 가이드, 블로그 게시물, 에피소드 중 원하는 항목을 저장하면 여기에 표시되어 다시 쉽게 찾을 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sla een onderwerp, app, gids, blogbericht of aflevering op, en het verschijnt hier zodat je het later terugvindt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisz wątek, aplikację, poradnik, wpis na blogu lub odcinek, a pojawi się tutaj, abyś mógł łatwo go znaleźć."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salve um tópico, um app, um guia, uma postagem do blog ou um episódio, e ele aparecerá aqui para você encontrar de novo facilmente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохраните тему, приложение, руководство, запись блога или эпизод — и он появится здесь, чтобы вы могли легко найти его снова."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spara ett ämne, en app, en guide, ett blogginlägg eller ett avsnitt, så visas det här så att du hittar det igen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บันทึกหัวข้อ แอป คู่มือ บทความบล็อก หรือตอนใดก็ได้ แล้วรายการนั้นจะแสดงที่นี่เพื่อให้คุณค้นหาได้อีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir konuyu, uygulamayı, rehberi, blog yazısını veya bölümü kaydedin; tekrar bulabilmeniz için burada görünecektir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Збережіть тему, застосунок, посібник, запис блогу або епізод — і він з'явиться тут, щоб ви могли легко знайти його знову."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lưu một chủ đề, ứng dụng, hướng dẫn, bài viết blog hoặc tập, nội dung đó sẽ xuất hiện ở đây để bạn dễ dàng tìm lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存一个话题、应用、指南、博客文章或单集，它就会出现在这里，方便你以后再次找到它。"

    "Home shows what's new since your last visit." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعرض الشاشة الرئيسية الجديد منذ زيارتك الأخيرة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Startseite zeigt, was seit deinem letzten Besuch neu ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η Αρχική δείχνει τι νέο υπάρχει από την τελευταία σας επίσκεψη."
          }
        },
        "es" : {
          "stringUnit" : {

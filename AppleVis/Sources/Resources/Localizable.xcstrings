          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O AppleVis coleta seu e-mail e nome de usuário para sua conta, além de um token push do dispositivo para notificações."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleVis собирает ваш адрес электронной почты и имя пользователя для учётной записи, а также push-токен устройства для уведомлений."
          }
        },
        "sv" : {
          "stringUnit" : {

    "Lets other signed-in members send you a private message without seeing your email address. Site staff can still reach you either way." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يسمح للأعضاء الآخرين المسجلين الدخول بإرسال رسالة خاصة لك دون رؤية عنوان بريدك الإلكتروني. لا يزال بإمكان موظفي الموقع الوصول إليك بأي حال."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ermöglicht anderen angemeldeten Mitgliedern, dir eine private Nachricht zu senden, ohne deine E-Mail-Adresse zu sehen. Das Site-Team kann dich in jedem Fall weiterhin erreichen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιτρέπει σε άλλα συνδεδεμένα μέλη να σας στέλνουν ιδιωτικό μήνυμα χωρίς να βλέπουν τη διεύθυνση email σας. Το προσωπικό του ιστότοπου μπορεί ακόμα να επικοινωνήσει μαζί σας ούτως ή άλλως."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que otros miembros con sesión iniciada te envíen un mensaje privado sin ver tu dirección de correo electrónico. El personal del sitio aún puede contactarte de cualquier forma."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "به سایر اعضای واردشده اجازه می‌دهد بدون دیدن آدرس ایمیل شما، پیام خصوصی برای شما ارسال کنند. کارکنان سایت در هر صورت همچنان می‌توانند با شما تماس بگیرند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permet à d'autres membres connectés de vous envoyer un message privé sans voir votre adresse e-mail. Le personnel du site peut toujours vous contacter de toute façon."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מאפשר לחברים אחרים המחוברים לשלוח לך הודעה פרטית מבלי לראות את כתובת האימייל שלך. צוות האתר עדיין יכול להגיע אליך בכל מקרה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अन्य साइन-इन सदस्यों को आपका ईमेल पता देखे बिना आपको निजी संदेश भेजने देता है। साइट स्टाफ फिर भी आप तक पहुंच सकता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memungkinkan anggota lain yang masuk mengirimi Anda pesan pribadi tanpa melihat alamat email Anda. Staf situs tetap dapat menghubungi Anda dengan cara apa pun."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consente ad altri membri connessi di inviarti un messaggio privato senza vedere il tuo indirizzo email. Lo staff del sito può comunque contattarti in entrambi i casi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サインイン中の他のメンバーが、あなたのメールアドレスを見ることなくプライベートメッセージを送信できるようにします。サイトのスタッフはいずれにせよ連絡を取ることができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로그인한 다른 회원이 이메일 주소를 보지 않고도 개인 메시지를 보낼 수 있게 합니다. 사이트 관리자는 어느 쪽이든 여전히 연락할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiermee kunnen andere ingelogde leden je een privébericht sturen zonder je e-mailadres te zien. Sitepersoneel kan je hoe dan ook nog steeds bereiken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umożliwia innym zalogowanym członkom wysyłanie do Ciebie prywatnej wiadomości bez widzenia Twojego adresu e-mail. Personel witryny nadal może się z Tobą skontaktować w każdym przypadku."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que outros membros conectados enviem uma mensagem privada a você sem ver seu endereço de e-mail. A equipe do site ainda pode entrar em contato de qualquer forma."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Позволяет другим авторизованным участникам отправлять вам личные сообщения, не видя ваш адрес электронной почты. Сотрудники сайта в любом случае могут связаться с вами."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Låter andra inloggade medlemmar skicka ett privat meddelande till dig utan att se din e-postadress. Webbplatsens personal kan ändå nå dig på annat sätt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อนุญาตให้สมาชิกที่ลงชื่อเข้าใช้คนอื่นส่งข้อความส่วนตัวถึงคุณโดยไม่เห็นที่อยู่อีเมลของคุณ เจ้าหน้าที่เว็บไซต์ยังคงติดต่อคุณได้ไม่ว่ากรณีใด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diğer oturum açmış üyelerin e-posta adresinizi görmeden size özel mesaj göndermesine izin verir. Site personeli her durumda size ulaşabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дозволяє іншим авторизованим учасникам надсилати вам приватне повідомлення, не бачачи вашу електронну адресу. Персонал сайту все одно може зв'язатися з вами в будь-якому разі."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cho phép các thành viên đã đăng nhập khác gửi tin nhắn riêng cho bạn mà không thấy địa chỉ email của bạn. Nhân viên trang web vẫn có thể liên hệ với bạn dù bằng cách nào."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许其他已登录成员在不看到您电子邮件地址的情况下向您发送私信。网站工作人员在任何情况下仍可联系到您。"
          }
        }
      }
    },

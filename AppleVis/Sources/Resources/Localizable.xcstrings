    "Applies processing to make voices clearer and more prominent." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يطبق معالجة لجعل الأصوات أكثر وضوحًا وبروزًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wendet Verarbeitung an, um Stimmen klarer und präsenter zu machen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εφαρμόζει επεξεργασία για να κάνει τις φωνές πιο καθαρές και ευδιάκριτες."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplica procesamiento para hacer que las voces sean más claras y prominentes."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پردازشی اعمال می‌کند تا صداها واضح‌تر و برجسته‌تر شوند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applique un traitement pour rendre les voix plus claires et plus présentes."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מיישם עיבוד כדי להפוך את הקולות לברורים ובולטים יותר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आवाज़ों को स्पष्ट और अधिक प्रमुख बनाने के लिए प्रोसेसिंग लागू करता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menerapkan pemrosesan untuk membuat suara lebih jelas dan menonjol."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applica un'elaborazione per rendere le voci più chiare e prominenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "処理を適用して、声をより明瞭で際立たせます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "음성을 더 명확하고 두드러지게 처리합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Past verwerking toe om stemmen duidelijker en prominenter te maken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",

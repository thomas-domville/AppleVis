    "Images and embedded image links are not allowed in AppleVis posts. Please remove the image reference before posting." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يُسمح بالصور وروابط الصور المضمنة في منشورات AppleVis. يرجى إزالة مرجع الصورة قبل النشر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilder und eingebettete Bildlinks sind in AppleVis-Beiträgen nicht erlaubt. Bitte entferne den Bildverweis vor dem Veröffentlichen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι εικόνες και οι ενσωματωμένοι σύνδεσμοι εικόνων δεν επιτρέπονται στις αναρτήσεις AppleVis. Παρακαλώ καταργήστε την αναφορά εικόνας πριν τη δημοσίευση."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se permiten imágenes ni enlaces de imágenes incrustadas en las publicaciones de AppleVis. Elimina la referencia a la imagen antes de publicar."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تصاویر و پیوندهای تصویر جاسازی‌شده در پست‌های AppleVis مجاز نیستند. لطفاً قبل از ارسال، ارجاع تصویر را حذف کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les images et les liens d'images intégrées ne sont pas autorisés dans les publications AppleVis. Veuillez supprimer la référence à l'image avant de publier."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תמונות וקישורי תמונות מוטמעות אינם מותרים בפוסטים ב-AppleVis. אנא הסר את ההפניה לתמונה לפני הפרסום."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleVis पोस्ट में छवियों और एम्बेडेड छवि लिंक की अनुमति नहीं है। कृपया पोस्ट करने से पहले छवि संदर्भ हटा दें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gambar dan tautan gambar tersemat tidak diizinkan dalam postingan AppleVis. Harap hapus referensi gambar sebelum memposting."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Immagini e link a immagini incorporate non sono consentiti nei post di AppleVis. Rimuovi il riferimento all'immagine prima di pubblicare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleVis の投稿には画像や埋め込み画像リンクを使用できません。投稿前に画像の参照を削除してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleVis 게시물에는 이미지나 삽입된 이미지 링크를 사용할 수 없습니다. 게시하기 전에 이미지 참조를 제거해 주세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afbeeldingen en ingesloten afbeeldingslinks zijn niet toegestaan in AppleVis-berichten. Verwijder de afbeeldingsverwijzing voordat je plaatst."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obrazy i osadzone linki do obrazów nie są dozwolone w postach na AppleVis. Usuń odniesienie do obrazu przed opublikowaniem."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imagens e links de imagem incorporados não são permitidos em postagens da AppleVis. Remova a referência à imagem antes de publicar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изображения и встроенные ссылки на изображения не допускаются в публикациях AppleVis. Пожалуйста, удалите ссылку на изображение перед публикацией."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilder och inbäddade bildlänkar är inte tillåtna i AppleVis-inlägg. Ta bort bildreferensen innan du publicerar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่อนุญาตให้ใช้รูปภาพและลิงก์รูปภาพฝังตัวในโพสต์ AppleVis โปรดลบการอ้างอิงรูปภาพก่อนโพสต์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleVis gönderilerinde resimlere ve gömülü resim bağlantılarına izin verilmez. Lütfen paylaşmadan önce resim referansını kaldırın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зображення та вбудовані посилання на зображення не дозволені в публікаціях AppleVis. Будь ласка, видаліть посилання на зображення перед публікацією."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không cho phép hình ảnh và liên kết hình ảnh nhúng trong bài đăng AppleVis. Vui lòng xóa tham chiếu hình ảnh trước khi đăng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleVis 帖子中不允许使用图片或嵌入图片链接。请在发布前移除图片引用。"
          }
        }
      }
    },

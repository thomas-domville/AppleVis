        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleVis просить учасників не використовувати форуми для просування власного подкасту, каналу на YouTube, сайту, розсилки чи іншого ресурсу."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleVis đề nghị thành viên không dùng diễn đàn để quảng bá podcast, kênh YouTube, trang web, bản tin hoặc tài nguyên khác của riêng mình."

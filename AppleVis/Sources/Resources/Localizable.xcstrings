          "stringUnit": {
            "state": "translated",
            "value": "フォロー中のトピック。ローカルに保存しiCloudで同期。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "팔로우 중인 주제. 로컬 저장 및 iCloud 동기화."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Onderwerpen die je volgt. Lokaal opgeslagen en gesynchroniseerd via iCloud."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您关注的话题，本地保存并通过iCloud同步。"

    "You can change these settings anytime later in Settings." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكنك تغيير هذه الإعدادات في أي وقت لاحقًا من الإعدادات."

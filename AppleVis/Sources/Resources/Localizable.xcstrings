    "Dismisses this reminder without resuming the tour. You can still replay it later from Profile." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يغلق هذا التذكير دون استئناف الجولة. لا يزال بإمكانك إعادة تشغيلها لاحقًا من الملف الشخصي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwirft diese Erinnerung, ohne die Tour fortzusetzen. Du kannst sie später trotzdem über „Profil“ erneut abspielen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Απορρίπτει αυτήν την υπενθύμιση χωρίς να συνεχίσει την ξενάγηση. Μπορείτε ακόμα να την επαναλάβετε αργότερα από το Προφίλ."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descarta este recordatorio sin reanudar el recorrido. Aún puedes reproducirlo más tarde desde Perfil."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این یادآوری را بدون از سرگیری تور نادیده می‌گیرد. همچنان می‌توانید بعداً آن را از نمایه دوباره پخش کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ignore ce rappel sans reprendre la visite guidée. Vous pouvez toujours la revoir plus tard depuis Profil."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מתעלם מתזכורת זו מבלי לחדש את הסיור. תוכל עדיין לשחק אותו שוב מאוחר יותר מהפרופיל."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "टूर फिर से शुरू किए बिना इस रिमाइंडर को खारिज करता है। आप इसे बाद में प्रोफ़ाइल से फिर से चला सकते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menutup pengingat ini tanpa melanjutkan tur. Anda tetap dapat memutarnya lagi nanti dari Profil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ignora questo promemoria senza riprendere il tour. Puoi comunque rivederlo più tardi da Profilo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ツアーを再開せずにこのリマインダーを閉じます。後で「プロフィール」からもう一度再生できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "둘러보기를 재개하지 않고 이 알림을 닫습니다. 나중에 프로필에서 다시 재생할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sluit deze herinnering zonder de rondleiding te hervatten. Je kunt deze later nog steeds afspelen vanuit Profiel."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zamyka to przypomnienie bez wznawiania samouczka. Nadal możesz odtworzyć go później z Profilu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dispensa este lembrete sem retomar o tour. Você ainda pode reproduzi-lo depois em Perfil."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Закрывает это напоминание без возобновления обзора. Вы всё ещё можете просмотреть его позже в разделе «Профиль»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avfärdar denna påminnelse utan att återuppta rundturen. Du kan fortfarande spela upp den senare från Profil."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปิดการเตือนนี้โดยไม่ดำเนินทัวร์ต่อ คุณยังสามารถเล่นซ้ำได้ภายหลังจากโปรไฟล์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turu devam ettirmeden bu hatırlatıcıyı kapatır. Daha sonra Profil'den tekrar oynatabilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Закриває це нагадування без відновлення туру. Ви все ще можете відтворити його пізніше з розділу «Профіль»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bỏ qua lời nhắc này mà không tiếp tục hướng dẫn. Bạn vẫn có thể phát lại sau từ Hồ sơ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭此提醒而不继续导览。您稍后仍可从“个人资料”重新播放。"
          }
        }
      }
    },

    "Apple Intelligence: select text you type to proofread, rewrite, shorten, or translate using Writing Tools.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence: select text you type to proofread, rewrite, shorten, or translate using Writing Tools."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence: selecciona el texto que escribes para corregir, reescribir o traducir con Writing Tools."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence : sélectionnez votre texte pour le corriger, le réécrire ou le traduire avec Writing Tools."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence: Markiere Text zum Korrigieren, Umschreiben oder Übersetzen mit Writing Tools."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence: selecione o texto para corrigir, reescrever ou traduzir com Writing Tools."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence: seleziona il testo per correggerlo, riscriverlo o tradurlo con Writing Tools."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence：入力したテキストを選択して、Writing Toolsで校正、書き直し、翻訳できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence: 입력한 텍스트를 선택해 Writing Tools로 교정, 재작성, 번역하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence: selecteer tekst om te corrigeren, herschrijven of vertalen met Writing Tools."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence：选择您输入的文本，使用Writing Tools进行校对、改写或翻译。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence: حدد النص الذي تكتبه لمراجعته أو إعادة كتابته أو ترجمته باستخدام Writing Tools."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence: जो टेक्स्ट टाइप करें उसे चुनें और Writing Tools से प्रूफरीड, फिर से लिखें या अनुवाद करें।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence: متنی را که تایپ می‌کنید انتخاب کنید تا با Writing Tools ویرایش، بازنویسی یا ترجمه شود."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence: выберите введённый текст, чтобы проверить, переписать или перевести его с помощью Writing Tools."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence: Yazma Araçları ile yazılan metni denetlemek, yeniden yazmak veya çevirmek için herhangi bir girdi metnini seçin."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence: wybierz dowolny wpisany tekst, aby sprawdzić, przepisać lub przetłumaczyć go za pomocą Writing Tools."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence: välj skriven text för att kontrollera, skriva om eller översätta med Writing Tools."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence: בחר כל טקסט שהוקלד כדי לבדוק, לשכתב או לתרגם אותו עם Writing Tools."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence: pilih teks yang diketik untuk memeriksa, menulis ulang, atau menerjemahkannya dengan Writing Tools."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence: chọn bất kỳ văn bản đã nhập nào để kiểm tra, viết lại hoặc dịch bằng Writing Tools."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence: виберіть введений текст, щоб перевірити, переписати або перекласти його за допомогою Writing Tools."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence: επιλέξτε οποιοδήποτε πληκτρολογημένο κείμενο για να το ελέγξετε, να το ξαναγράψετε ή να το μεταφράσετε με τα Writing Tools."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence: เลือกข้อความที่พิมพ์เพื่อตรวจสอบ เขียนใหม่ หรือแปลด้วย Writing Tools"
          }
        }
      }
    },

    "Double-tap to adjust Voice Boost, Trim Silence, and equaliser settings." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط مرتين لضبط تعزيز الصوت وتقليم الصمت وإعدادات معادل الصوت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doppeltippen, um Stimmverstärkung, Stille kürzen und Equalizer-Einstellungen anzupassen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πατήστε δύο φορές για να προσαρμόσετε την Ενίσχυση Φωνής, την Περικοπή Σιωπής και τις ρυθμίσεις ισοσταθμιστή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca dos veces para ajustar Aumento de voz, Recortar silencios y los ajustes del ecualizador."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای تنظیم افزایش صدا، برش سکوت و تنظیمات اکولایزر دوبار ضربه بزنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez deux fois pour ajuster Amplification vocale, Réduction des silences et les réglages de l'égaliseur."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הקש הקשה כפולה כדי לכוונן את הגברת קול, קיצוץ שקט והגדרות האקולייזר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वॉइस बूस्ट, ट्रिम साइलेंस, और इक्वलाइज़र सेटिंग्स समायोजित करने के लिए डबल-टैप करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketuk dua kali untuk menyesuaikan Peningkat Suara, Pangkas Keheningan, dan pengaturan equalizer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca due volte per regolare Potenziamento voce, Taglia silenzi e le impostazioni dell'equalizzatore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダブルタップして、ボイスブースト、無音カット、イコライザー設定を調整します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "두 번 탭하여 음성 부스트, 무음 구간 제거, 이퀄라이저 설정을 조정합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dubbeltik om Stemversterking, Stilte bijsnijden en de equalizerinstellingen aan te passen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stuknij dwukrotnie, aby dostosować Wzmocnienie głosu, Przycinanie ciszy i ustawienia korektora."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque duas vezes para ajustar Reforço de voz, Cortar silêncio e as configurações do equalizador."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дважды коснитесь, чтобы настроить усиление голоса, обрезку тишины и параметры эквалайзера."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dubbeltryck för att justera Röstförstärkning, Trimma tystnad och equalizerinställningar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แตะสองครั้งเพื่อปรับเพิ่มเสียงพูด ตัดความเงียบ และการตั้งค่าอีควอไลเซอร์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ses Artırma, Sessizliği Kırp ve ekolayzer ayarlarını düzenlemek için iki kez dokunun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Двічі торкніться, щоб налаштувати підсилення голосу, обрізання тиші та параметри еквалайзера."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chạm hai lần để điều chỉnh Tăng cường giọng nói, Cắt khoảng lặng và cài đặt equalizer."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轻点两下调整人声增强、静音修剪和均衡器设置。"
          }
        }
      }
    },
    "Double-tap to cancel." : {
      "extractionState" : "manual",
      "localizations" : {

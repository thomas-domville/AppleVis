    "Masked text looks like \"s***\" instead of the word spelled out." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يظهر النص المنكّر مثل \"s***\" بدلاً من كتابة الكلمة كاملة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maskierter Text sieht aus wie „s***“ statt das Wort ausgeschrieben zu zeigen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το συγκαλυμμένο κείμενο μοιάζει με \"s***\" αντί για την ολόκληρη λέξη."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El texto enmascarado se ve como «s***» en lugar de la palabra escrita por completo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "متن ستاره‌دار به‌صورت \"s***\" نمایش داده می‌شود، نه کلمه‌ی کامل."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le texte masqué ressemble à « s*** » au lieu du mot écrit en entier."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "טקסט מוסתר נראה כמו \"s***\" במקום המילה כתובה במלואה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "छिपाया गया टेक्स्ट \"s***\" जैसा दिखता है, न कि पूरा लिखा हुआ शब्द।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teks yang disamarkan terlihat seperti \"s***\" alih-alih kata yang dieja penuh."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il testo mascherato appare come \"s***\" invece della parola scritta per intero."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "伏せ字にすると「s***」のように表示され、単語がそのまま表示されなくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가려진 텍스트는 단어를 그대로 표시하는 대신 \"s***\"처럼 보입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gemaskeerde tekst ziet eruit als \"s***\" in plaats van het woord voluit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zamaskowany tekst wygląda jak „s***” zamiast słowa napisanego w pełnym brzmieniu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O texto mascarado aparece como \"s***\" em vez da palavra escrita por completo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Замаскированный текст выглядит как «s***» вместо полностью написанного слова."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maskerad text ser ut som \"s***\" i stället för ordet utskrivet."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ข้อความที่ถูกซ่อนจะแสดงเป็น \"s***\" แทนที่จะสะกดคำเต็ม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gizlenen metin, kelimenin tam yazılması yerine \"s***\" gibi görünür."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Замаскований текст виглядає як «s***» замість повністю написаного слова."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Văn bản bị che trông giống như \"s***\" thay vì từ được viết đầy đủ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "被遮蔽的文字会显示为“s***”，而不是完整拼出该词。"
          }
        }
      }
    },

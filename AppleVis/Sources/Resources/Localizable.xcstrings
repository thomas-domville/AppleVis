    "Updates the AppleVis app title, description, App Store link, and current version from the App Store listing." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحدّث عنوان تطبيق AppleVis ووصفه ورابط App Store والإصدار الحالي من قائمة App Store."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktualisiert Titel, Beschreibung, App-Store-Link und aktuelle Version der AppleVis-App aus dem App-Store-Eintrag."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ενημερώνει τον τίτλο, την περιγραφή, τον σύνδεσμο App Store και την τρέχουσα έκδοση της εφαρμογής AppleVis από την καταχώριση του App Store."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actualiza el título, la descripción, el enlace de la App Store y la versión actual de la app AppleVis a partir de la ficha de la App Store."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عنوان برنامهٔ AppleVis، توضیحات، پیوند App Store و نسخهٔ فعلی را از فهرست App Store به‌روزرسانی می‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met à jour le titre, la description, le lien App Store et la version actuelle de l'appli AppleVis à partir de la fiche App Store."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מעדכן את כותרת אפליקציית AppleVis, התיאור, קישור ה-App Store והגרסה הנוכחית מרישום ה-App Store."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store लिस्टिंग से AppleVis ऐप का शीर्षक, विवरण, App Store लिंक, और वर्तमान संस्करण अपडेट करता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memperbarui judul aplikasi AppleVis, deskripsi, tautan App Store, dan versi saat ini dari listingan App Store."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiorna il titolo, la descrizione, il link dell'App Store e la versione attuale dell'app AppleVis dalla scheda dell'App Store."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store の掲載情報から、AppleVis アプリのタイトル、説明、App Store のリンク、現在のバージョンを更新します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store 목록에서 AppleVis 앱 제목, 설명, App Store 링크, 현재 버전을 업데이트합니다."
          }
        },
        "nl" : {

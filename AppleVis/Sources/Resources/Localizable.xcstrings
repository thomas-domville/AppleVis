          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gestisci download, contenuti nella cache e criteri di conservazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダウンロード、キャッシュコンテンツ、保持ポリシーを管理。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다운로드, 캐시된 콘텐츠, 보존 정책을 관리합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beheer downloads, gecachte inhoud en bewaarbeleid."
          }

    "Compares AppleVis's title, description, App Store link, and version against the App Store listing and lets you choose what to update." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقارن عنوان AppleVis والوصف ورابط App Store والإصدار بصفحة App Store، ويتيح لك اختيار ما تريد تحديثه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vergleicht AppleVis' Titel, Beschreibung, App Store-Link und Version mit dem App Store-Eintrag und lässt dich auswählen, was aktualisiert werden soll."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Συγκρίνει τον τίτλο, την περιγραφή, τον σύνδεσμο App Store και την έκδοση του AppleVis με την καταχώριση στο App Store και σας επιτρέπει να επιλέξετε τι θα ενημερωθεί."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compara el título, la descripción, el enlace de la App Store y la versión de AppleVis con la ficha de la App Store, y te permite elegir qué actualizar."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عنوان، توضیحات، پیوند App Store و نسخهٔ AppleVis را با فهرست App Store مقایسه می‌کند و به شما امکان می‌دهد انتخاب کنید چه چیزی به‌روزرسانی شود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compare le titre, la description, le lien App Store et la version d'AppleVis à la fiche de l'App Store, et vous permet de choisir ce qui doit être mis à jour."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "משווה את הכותרת, התיאור, הקישור ל-App Store והגרסה של AppleVis לרישום ב-App Store, ומאפשר לך לבחור מה לעדכן."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleVis के शीर्षक, विवरण, App Store लिंक और वर्शन की तुलना App Store लिस्टिंग से करता है, और आपको यह चुनने देता है कि क्या अपडेट करना है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Membandingkan judul, deskripsi, tautan App Store, dan versi AppleVis dengan listingan App Store, serta memungkinkan Anda memilih apa yang akan diperbarui."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confronta titolo, descrizione, link App Store e versione di AppleVis con la scheda dell'App Store e ti permette di scegliere cosa aggiornare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleVisのタイトル、説明、App Storeへのリンク、バージョンを現在のApp Storeの掲載情報と比較し、更新する項目を選択できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleVis의 제목, 설명, App Store 링크, 버전을 App Store 등록 정보와 비교하여 업데이트할 항목을 선택할 수 있게 해줍니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vergelijkt de titel, beschrijving, App Store-link en versie van AppleVis met de App Store-vermelding en laat je kiezen wat je wilt bijwerken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Porównuje tytuł, opis, link do App Store i wersję AppleVis z wpisem w App Store i pozwala wybrać, co zaktualizować."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compara o título, a descrição, o link da App Store e a versão do AppleVis com a ficha da App Store e permite que você escolha o que atualizar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сравнивает название, описание, ссылку на App Store и версию AppleVis с карточкой в App Store и позволяет выбрать, что обновить."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jämför AppleVis titel, beskrivning, App Store-länk och version med App Store-listningen och låter dig välja vad som ska uppdateras."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เปรียบเทียบชื่อ คำอธิบาย ลิงก์ App Store และเวอร์ชันของ AppleVis กับข้อมูลบน App Store และให้คุณเลือกสิ่งที่จะอัปเดต"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleVis'in başlığını, açıklamasını, App Store bağlantısını ve sürümünü App Store listesiyle karşılaştırır ve neyin güncelleneceğini seçmenizi sağlar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Порівнює назву, опис, посилання на App Store та версію AppleVis з описом в App Store і дає змогу вибрати, що оновити."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So sánh tiêu đề, mô tả, liên kết App Store và phiên bản của AppleVis với thông tin trên App Store, đồng thời cho phép bạn chọn nội dung cần cập nhật."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将 AppleVis 的标题、简介、App Store 链接和版本与当前的 App Store 页面进行比较，并让你选择要更新的内容。"
          }
        }
      }
    },

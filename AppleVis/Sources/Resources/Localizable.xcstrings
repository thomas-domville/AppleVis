    "Translates a search typed in another language so you still find the right results." : {
      "comment" : "A description of the feature that translates search queries in a different language so you can still find the right results.",
      "extractionState" : "manual",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يترجم بحثًا مكتوبًا بلغة أخرى حتى تظل تجد النتائج الصحيحة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Übersetzt eine in einer anderen Sprache eingegebene Suche, damit du trotzdem die richtigen Ergebnisse findest."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μεταφράζει μια αναζήτηση που πληκτρολογήθηκε σε άλλη γλώσσα ώστε να βρίσκετε και πάλι τα σωστά αποτελέσματα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traduce una búsqueda escrita en otro idioma para que igual encuentres los resultados correctos."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جستجویی که به زبان دیگری تایپ شده را ترجمه می‌کند تا همچنان نتایج درست را پیدا کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traduit une recherche saisie dans une autre langue afin que vous trouviez quand même les bons résultats."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מתרגם חיפוש שהוקלד בשפה אחרת כך שעדיין תמצא את התוצאות הנכונות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किसी अन्य भाषा में टाइप की गई खोज का अनुवाद करता है ताकि आप फिर भी सही परिणाम पा सकें。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menerjemahkan pencarian yang diketik dalam bahasa lain agar Anda tetap menemukan hasil yang tepat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traduce una ricerca digitata in un'altra lingua in modo che tu trovi comunque i risultati giusti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "別の言語で入力された検索を翻訳し、正しい結果を見つけられるようにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 언어로 입력한 검색어를 번역해 여전히 올바른 결과를 찾을 수 있게 합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vertaalt een zoekopdracht die in een andere taal is getypt, zodat je toch de juiste resultaten vindt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tłumaczy wyszukiwanie wpisane w innym języku, dzięki czemu nadal znajdziesz właściwe wyniki."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traduz uma busca digitada em outro idioma para que você ainda encontre os resultados certos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переводит поисковый запрос, введённый на другом языке, чтобы вы всё равно находили нужные результаты."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Översätter en sökning skriven på ett annat språk så att du ändå hittar rätt resultat."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แปลการค้นหาที่พิมพ์เป็นภาษาอื่นเพื่อให้คุณยังคงพบผลลัพธ์ที่ถูกต้อง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Başka bir dilde yazılan bir aramayı çevirerek doğru sonuçları bulmanızı sağlar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перекладає пошуковий запит, введений іншою мовою, щоб ви все одно знаходили потрібні результати."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dịch tìm kiếm được gõ bằng ngôn ngữ khác để bạn vẫn tìm thấy kết quả đúng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "翻译以其他语言输入的搜索内容，让您仍能找到正确的结果。"
          }
        }
      }

    "Subscribe to AppleVis updates or follow us on social media." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اشترك في تحديثات AppleVis أو تابعنا على وسائل التواصل الاجتماعي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",

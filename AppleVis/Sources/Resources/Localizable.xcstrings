          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleVis בדק במקור את גרסה %@. הנגישות עשויה להיות שונה בגרסה הנוכחית ב-App Store."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleVis ने मूल रूप से संस्करण %@ को परखा था। App Store के मौजूदा संस्करण में सुलभता अलग हो सकती है।"
          }
        },
        "id" : {
          "stringUnit" : {

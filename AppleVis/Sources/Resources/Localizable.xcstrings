            "value" : "ध्यान देने योग्य क्षणों के लिए ध्वनि बजाता है — सेव करना, डाउनलोड समाप्त होना, सूचनाएं, और पॉडकास्ट चलाना और रोकना。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memutar suara untuk momen yang layak diperhatikan — menyimpan, unduhan selesai, notifikasi, serta memutar dan menjeda podcast."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riproduce un suono per i momenti degni di nota: salvataggio, download completati, notifiche e riproduzione/pausa del podcast."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "注目に値する瞬間（保存、ダウンロード完了、通知、ポッドキャストの再生・一時停止）でサウンドを再生します。"
          }
        },
        "ko" : {

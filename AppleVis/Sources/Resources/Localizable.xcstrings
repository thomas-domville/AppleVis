    "You're offline. Connect to Wi-Fi or cellular to see your recommendations." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أنت غير متصل. اتصل بشبكة Wi-Fi أو الشبكة الخلوية لرؤية توصياتك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bist offline. Stelle eine WLAN- oder Mobilfunkverbindung her, um deine Empfehlungen zu sehen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Είστε εκτός σύνδεσης. Συνδεθείτε σε Wi-Fi ή δίκτυο κινητής για να δείτε τις προτάσεις σας."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No tienes conexión. Conéctate a Wi-Fi o a datos móviles para ver tus recomendaciones."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آفلاین هستید. برای دیدن توصیه‌هایتان به Wi-Fi یا شبکهٔ همراه وصل شوید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous êtes hors ligne. Connectez-vous au Wi-Fi ou au réseau cellulaire pour voir vos recommandations."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אתה במצב לא מקוון. התחבר ל-Wi-Fi או לרשת סלולרית כדי לראות את ההמלצות שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप ऑफ़लाइन हैं। अपनी अनुशंसाएं देखने के लिए Wi-Fi या सेल्युलर से कनेक्ट करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda sedang offline. Sambungkan ke Wi-Fi atau seluler untuk melihat rekomendasi Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sei offline. Connettiti al Wi-Fi o alla rete cellulare per vedere i tuoi consigli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",

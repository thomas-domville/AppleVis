    "Everything can be changed anytime in Settings." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن تغيير كل شيء في أي وقت من الإعدادات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles kann jederzeit in den Einstellungen geändert werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όλα μπορούν να αλλάξουν ανά πάσα στιγμή στις Ρυθμίσεις."

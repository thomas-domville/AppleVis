    "To everyone who has helped AppleVis become what it is: thank you." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لكل من ساعد AppleVis لتصبح ما هي عليه اليوم: شكرًا لكم."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An alle, die dazu beigetragen haben, dass AppleVis das geworden ist, was es heute ist: danke."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σε όλους όσους βοήθησαν το AppleVis να γίνει αυτό που είναι: σας ευχαριστούμε."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A todos los que han ayudado a AppleVis a convertirse en lo que es: gracias."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "از همهٔ کسانی که به AppleVis کمک کردند تا آنچه امروز هست شود: سپاسگزاریم."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À tous ceux qui ont aidé AppleVis à devenir ce qu'elle est : merci."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לכל מי שעזר ל-AppleVis להפוך למה שהיא: תודה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर उस व्यक्ति के लिए जिसने AppleVis को वह बनाने में मदद की जो वह है: धन्यवाद。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk semua orang yang telah membantu AppleVis menjadi seperti sekarang: terima kasih."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A tutti coloro che hanno aiutato AppleVis a diventare ciò che è: grazie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleVis を今のような姿にするために力を貸してくださったすべての方へ：ありがとうございます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleVis를 지금의 모습으로 만드는 데 도움을 준 모든 분들께 감사드립니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aan iedereen die AppleVis heeft geholpen te worden wat het is: bedankt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dla wszystkich, którzy pomogli AppleVis stać się tym, czym jest: dziękujemy."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A todos que ajudaram a AppleVis a se tornar o que é: obrigado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всем, кто помог AppleVis стать тем, чем он является: спасибо."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Till alla som har hjälpt AppleVis att bli det den är: tack."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ถึงทุกคนที่ช่วยให้ AppleVis เป็นอย่างที่เป็นอยู่ทุกวันนี้: ขอบคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleVis'in bugünkü haline gelmesine yardımcı olan herkese: teşekkürler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Усім, хто допоміг AppleVis стати тим, чим він є: дякуємо."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gửi đến tất cả những ai đã giúp AppleVis trở thành như ngày hôm nay: cảm ơn bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "感谢所有帮助 AppleVis 成为今天这样的人。"
          }
        }
      }
    },
    "To report an Apple accessibility bug, use Discover → Contribute → Submit a Bug Report." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "للإبلاغ عن خلل في إمكانية الوصول في Apple، استخدم استكشاف ← المساهمة ← إرسال تقرير خلل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um einen Apple-Barrierefreiheitsfehler zu melden, verwende Entdecken → Mitwirken → Fehlerbericht einreichen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Για να αναφέρετε ένα σφάλμα προσβασιμότητας Apple, χρησιμοποιήστε Ανακάλυψη → Συνεισφορά → Υποβολή Αναφοράς Σφάλματος."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para informar de un error de accesibilidad de Apple, usa Descubrir → Contribuir → Enviar un informe de error."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای گزارش باگ دسترس‌پذیری اپل، از کشف کنید ← مشارکت ← ارسال گزارش باگ استفاده کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour signaler un bogue d'accessibilité Apple, utilisez Découvrir → Contribuer → Envoyer un signalement de bogue."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כדי לדווח על באג נגישות של Apple, השתמש בגילוי ← תרומה ← שליחת דיווח באג."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple सुलभता बग की रिपोर्ट करने के लिए, खोजें → योगदान करें → बग रिपोर्ट सबमिट करें का उपयोग करें。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk melaporkan bug aksesibilitas Apple, gunakan Jelajahi → Berkontribusi → Kirim Laporan Bug."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per segnalare un bug di accessibilità Apple, usa Scopri → Contribuisci → Invia una segnalazione di bug."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple のアクセシビリティの不具合を報告するには、「見つける」→「貢献する」→「不具合報告を送信」を使用してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple 접근성 버그를 신고하려면 둘러보기 → 기여하기 → 버그 신고 제출을 사용하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om een Apple-toegankelijkheidsbug te melden, gebruik je Ontdekken → Bijdragen → Bugmelding indienen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby zgłosić błąd dostępności Apple, użyj Odkrywaj → Wnieś wkład → Zgłoś błąd."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para relatar um bug de acessibilidade da Apple, use Descobrir → Contribuir → Enviar um relatório de bug."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы сообщить об ошибке специальных возможностей Apple, используйте «Обзор» → «Внести вклад» → «Отправить отчёт об ошибке»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "För att rapportera en Apple-tillgänglighetsbugg, använd Upptäck → Bidra → Skicka in en felrapport."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หากต้องการรายงานบั๊กด้านการช่วยการเข้าถึงของ Apple ให้ใช้ค้นพบ → ร่วมสนับสนุน → ส่งรายงานบั๊ก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir Apple erişilebilirlik hatasını bildirmek için Keşfet → Katkıda Bulun → Hata Raporu Gönder'i kullanın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щоб повідомити про помилку доступності Apple, скористайтеся «Огляд» → «Зробити внесок» → «Надіслати звіт про помилку»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Để báo cáo lỗi trợ năng của Apple, hãy dùng Khám phá → Đóng góp → Gửi báo cáo lỗi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要报告 Apple 无障碍缺陷，请依次使用“发现”→“参与贡献”→“提交缺陷报告”。"
          }
        }
      }
    },

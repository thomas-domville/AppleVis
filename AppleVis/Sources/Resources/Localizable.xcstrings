            "value" : "बाद में खींचकर रीफ़्रेश करें, या व्यापक नज़ारे के लिए पिछला महीना आज़माएं。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarik untuk menyegarkan nanti, atau coba Bulan Lalu untuk tampilan yang lebih luas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tira per aggiornare più tardi, oppure prova Ultimo mese per una visione più ampia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "後で引っ張って更新するか、「先月」を試してより広い範囲を確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "나중에 당겨서 새로고침하거나, 더 넓은 범위를 보려면 지난달을 시도해 보세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trek later om te vernieuwen, of probeer Afgelopen maand voor een breder overzicht."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przeciągnij, aby odświeżyć później, lub wypróbuj Ostatni miesiąc dla szerszego widoku."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puxe para atualizar mais tarde, ou tente Mês passado para uma visão mais ampla."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Потяните для обновления позже или попробуйте «Прошедший месяц» для более широкого обзора."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dra för att uppdatera senare, eller prova Senaste månaden för en bredare bild."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ดึงเพื่อรีเฟรชในภายหลัง หรือลองเดือนที่แล้วเพื่อมุมมองที่กว้างขึ้น"

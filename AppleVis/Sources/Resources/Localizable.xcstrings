    "Non-Apple topics include Windows, Android, smart home tech, and general assistive technology discussions." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تشمل المواضيع غير المتعلقة بـ Apple: Windows وAndroid وتقنيات المنزل الذكي والنقاشات العامة حول التقنيات المساعدة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zu den Nicht-Apple-Themen zählen Windows, Android, Smart-Home-Technik und allgemeine Diskussionen über Hilfstechnologien."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα θέματα εκτός Apple περιλαμβάνουν Windows, Android, τεχνολογία έξυπνου σπιτιού και γενικές συζητήσεις για τεχνολογίες υποβοήθησης."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los temas ajenos a Apple incluyen Windows, Android, tecnología para el hogar inteligente y debates generales sobre tecnología de asistencia."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "موضوعات غیرمرتبط با اپل شامل ویندوز، اندروید، فناوری خانهٔ هوشمند و بحث‌های کلی دربارهٔ فناوری کمکی می‌شود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sujets non liés à Apple incluent Windows, Android, la domotique et les discussions générales sur les technologies d'assistance."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "נושאים שאינם קשורים ל-Apple כוללים Windows, Android, טכנולוגיית בית חכם ודיונים כלליים על טכנולוגיה מסייעת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "गैर-Apple विषयों में Windows, Android, स्मार्ट होम तकनीक, और सहायक तकनीक से जुड़ी सामान्य चर्चाएं शामिल हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Topik non-Apple mencakup Windows, Android, teknologi rumah pintar, dan diskusi umum tentang teknologi bantu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",

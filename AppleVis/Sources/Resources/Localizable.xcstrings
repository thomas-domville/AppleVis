    "Confirm the app's basic details, then describe its accessibility for AppleVis members." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أكّد التفاصيل الأساسية للتطبيق، ثم صف مدى إمكانية الوصول إليه لأعضاء AppleVis."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bestätige die grundlegenden Angaben zur App und beschreibe dann ihre Zugänglichkeit für AppleVis-Mitglieder."

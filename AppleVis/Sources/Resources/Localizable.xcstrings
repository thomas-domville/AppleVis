    "Downloads new episodes on their own, so they're ready to play offline before you even open them." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقوم بتنزيل الحلقات الجديدة تلقائيًا، لتكون جاهزة للتشغيل دون اتصال حتى قبل أن تفتحها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lädt neue Folgen von selbst herunter, sodass sie schon vor dem Öffnen offline abspielbar sind."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κατεβάζει νέα επεισόδια από μόνο του, ώστε να είναι έτοιμα για αναπαραγωγή εκτός σύνδεσης πριν καν τα ανοίξετε."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descarga los episodios nuevos automáticamente, listos para reproducirse sin conexión antes de que los abras."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قسمت‌های جدید را خودش دانلود می‌کند، بنابراین قبل از اینکه آن‌ها را باز کنید برای پخش آفلاین آماده هستند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Télécharge automatiquement les nouveaux épisodes, prêts à être écoutés hors ligne avant même que vous ne les ouvriez."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מוריד פרקים חדשים בעצמו, כך שהם מוכנים להשמעה במצב לא מקוון עוד לפני שאתה פותח אותם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नए एपिसोड अपने आप डाउनलोड करता है, ताकि खोलने से पहले ही वे ऑफ़लाइन चलाने के लिए तैयार हों।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengunduh episode baru dengan sendirinya, sehingga siap diputar secara offline bahkan sebelum Anda membukanya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scarica automaticamente i nuovi episodi, pronti per l'ascolto offline ancora prima di aprirli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しいエピソードを自動的にダウンロードし、開く前からオフライン再生の準備が整います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새 에피소드를 자동으로 다운로드하여 열기 전부터 오프라인 재생 준비가 됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Downloadt nieuwe afleveringen automatisch, zodat ze offline afspeelbaar zijn nog voordat je ze opent."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samodzielnie pobiera nowe odcinki, dzięki czemu są gotowe do odtwarzania offline, zanim jeszcze je otworzysz."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baixa novos episódios automaticamente, prontos para reprodução offline antes mesmo de você abri-los."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Автоматически загружает новые эпизоды, чтобы они были готовы к прослушиванию офлайн ещё до открытия."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laddar ner nya avsnitt på egen hand, så de är redo att spelas offline redan innan du öppnar dem."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ดาวน์โหลดตอนใหม่ด้วยตัวเอง จึงพร้อมเล่นแบบออฟไลน์ก่อนที่คุณจะเปิดด้วยซ้ำ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeni bölümleri kendiliğinden indirir, böylece siz onları açmadan önce çevrimdışı oynatmaya hazır olurlar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Автоматично завантажує нові епізоди, тож вони готові до офлайн-відтворення ще до відкриття."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tự động tải xuống các tập mới, để chúng sẵn sàng phát ngoại tuyến ngay cả trước khi bạn mở chúng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自动下载新单集，让您在打开之前就能离线播放。"
          }
        }
      }
    },
    "Downloads stay until deleted here. Cached content re-downloads automatically when you open each section." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبقى التنزيلات حتى يتم حذفها يدوياً. تُعاد جلب الذاكرة المؤقتة عند فتح كل قسم."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Downloads bleiben bis zur manuellen Löschung. Cache wird beim Öffnen jeder Sektion neu geladen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι λήψεις αποθηκεύονται μέχρι να τις διαγράψετε εδώ. Το περιεχόμενο cache επαναφορτώνεται κάθε φορά που ανοίγεται ένα τμήμα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Downloads stay until deleted here. Cached content re-downloads automatically when you open each section."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las descargas permanecen hasta que las elimines. El contenido en caché se vuelve a descargar al abrir cada sección."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دانلودها تا زمان حذف دستی نگهداری می‌شوند. حافظه پنهان هنگام باز کردن هر بخش مجدداً دانلود می‌شود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les téléchargements restent jusqu'à leur suppression. Le cache est retéléchargé à l'ouverture de chaque section."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הורדות נשמרות עד שתמחק אותן כאן. תוכן המטמון נטען מחדש בכל פעם שפותחים קטע."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डाउनलोड तब तक रहते हैं जब तक हटाए न जाएं। कैश प्रत्येक अनुभाग खोलने पर फिर से डाउनलोड होता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unduhan disimpan hingga Anda menghapusnya di sini. Konten cache dimuat ulang setiap kali bagian dibuka."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I download rimangono finché non vengono eliminati. La cache viene riscaricata all'apertura di ogni sezione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダウンロードは削除するまで保持されます。キャッシュは各セクションを開くと再ダウンロードされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다운로드는 삭제할 때까지 유지됩니다. 캐시는 각 섹션을 열 때 다시 다운로드됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Downloads blijven totdat ze worden verwijderd. Cache wordt opnieuw geladen bij het openen van elke sectie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pobrane pliki są przechowywane do momentu usunięcia tutaj. Zawartość pamięci podręcznej jest ponownie pobierana przy każdym otwarciu sekcji."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os downloads ficam até serem excluídos. O cache é recarregado ao abrir cada seção."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Загрузки хранятся до удаления здесь. Кэшированный контент загружается повторно при открытии каждого раздела."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nedladdningar sparas tills du raderar dem här. Cachad innehåll laddas om när varje avsnitt öppnas."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การดาวน์โหลดจะถูกเก็บไว้จนกว่าคุณจะลบที่นี่ เนื้อหาแคชจะโหลดใหม่ทุกครั้งที่เปิดส่วนนั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İndirmeler buradan silinene kadar saklanır. Önbelleğe alınan içerik her bölüm açıldığında yeniden indirilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Завантаження зберігаються до видалення тут. Кешований вміст завантажується повторно при відкритті кожного розділу."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tải xuống được lưu cho đến khi bạn xóa tại đây. Nội dung trong bộ nhớ đệm sẽ được tải lại mỗi khi mở phần."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下载内容在手动删除前会一直保留。缓存在打开每个部分时会重新下载。"
          }
        }
      }
    },

          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple以外のトピックには、Windows、Android、スマートホーム技術、支援技術全般に関する議論が含まれます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",

    "Non-English detection, compose rewrite/translation, search translation, and AI summaries all run on-device via Apple Intelligence." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعمل اكتشاف اللغة غير الإنجليزية وإعادة الصياغة/الترجمة أثناء الكتابة وترجمة البحث وملخصات الذكاء الاصطناعي جميعها على الجهاز عبر Apple Intelligence."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Erkennung nicht-englischer Sprache, das Umschreiben/Übersetzen beim Verfassen, die Suchübersetzung und die KI-Zusammenfassungen laufen alle direkt auf dem Gerät über Apple Intelligence."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο εντοπισμός μη αγγλικών, η επανασύνταξη/μετάφραση σύνταξης, η μετάφραση αναζήτησης και οι περιλήψεις AI εκτελούνται όλα στη συσκευή μέσω του Apple Intelligence."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La detección de idiomas distintos al inglés, la reescritura/traducción al redactar, la traducción de búsquedas y los resúmenes de IA se ejecutan en el dispositivo mediante Apple Intelligence."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تشخیص غیرانگلیسی، بازنویسی/ترجمهٔ حین نگارش، ترجمهٔ جستجو و خلاصه‌های هوش مصنوعی همگی روی دستگاه از طریق Apple Intelligence اجرا می‌شوند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La détection des langues autres que l'anglais, la réécriture/traduction lors de la composition, la traduction de recherche et les résumés IA s'exécutent tous sur l'appareil via Apple Intelligence."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "זיהוי שפה שאינה אנגלית, ניסוח מחדש/תרגום בעת חיבור, תרגום חיפוש וסיכומי בינה מלאכותית — כולם פועלים על המכשיר דרך Apple Intelligence."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "गैर-अंग्रेज़ी पहचान, कंपोज़ पुनर्लेखन/अनुवाद, खोज अनुवाद, और AI सारांश सभी Apple Intelligence के माध्यम से डिवाइस पर ही चलते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deteksi non-Inggris, penulisan ulang/terjemahan saat menyusun, terjemahan pencarian, dan ringkasan AI semuanya berjalan di perangkat melalui Apple Intelligence."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il rilevamento di lingue diverse dall'inglese, la riscrittura/traduzione durante la composizione, la traduzione delle ricerche e i riepiloghi IA vengono eseguiti tutti sul dispositivo tramite Apple Intelligence."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "英語以外の検出、作成中のリライト・翻訳、検索の翻訳、AI 要約はすべて、Apple Intelligence によりデバイス上で実行されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "비영어 감지, 작성 중 다시 쓰기/번역, 검색 번역, AI 요약은 모두 Apple Intelligence를 통해 기기에서 처리됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detectie van niet-Engelse tekst, herschrijven/vertalen tijdens het opstellen, zoekvertaling en AI-samenvattingen worden allemaal op het apparaat uitgevoerd via Apple Intelligence."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wykrywanie języka innego niż angielski, przeredagowanie/tłumaczenie podczas pisania, tłumaczenie wyszukiwania i podsumowania AI działają na urządzeniu za pośrednictwem Apple Intelligence."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A detecção de não inglês, reescrita/tradução ao compor, tradução de busca e resumos de IA são todos executados no dispositivo via Apple Intelligence."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Определение неанглийского языка, переработка/перевод при составлении, перевод поиска и ИИ-сводки — всё это выполняется прямо на устройстве через Apple Intelligence."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icke-engelsk detektering, omskrivning/översättning vid skrivande, sököversättning och AI-sammanfattningar körs alla på enheten via Apple Intelligence."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การตรวจจับภาษาที่ไม่ใช่ภาษาอังกฤษ การเขียนใหม่/แปลขณะเขียน การแปลการค้นหา และสรุป AI ทั้งหมดทำงานบนอุปกรณ์ผ่าน Apple Intelligence"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İngilizce olmayan dil algılama, yazarken yeniden yazma/çeviri, arama çevirisi ve yapay zeka özetlerinin tümü Apple Intelligence aracılığıyla cihaz üzerinde çalışır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Виявлення неанглійської мови, переписування/переклад під час складання, переклад пошуку та підсумки ШІ — усе це виконується на пристрої через Apple Intelligence."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phát hiện ngôn ngữ không phải tiếng Anh, viết lại/dịch khi soạn thảo, dịch tìm kiếm và tóm tắt AI đều chạy trên thiết bị thông qua Apple Intelligence."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "非英语检测、撰写时改写/翻译、搜索翻译和 AI 摘要均通过 Apple Intelligence 在设备本地运行。"
          }
        }
      }
    },

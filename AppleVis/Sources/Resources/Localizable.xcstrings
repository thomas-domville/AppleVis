    "Downloads new episodes on their own, so they're ready to play offline before you even open them." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقوم بتنزيل الحلقات الجديدة تلقائيًا، لتكون جاهزة للتشغيل دون اتصال حتى قبل أن تفتحها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lädt neue Folgen von selbst herunter, sodass sie schon vor dem Öffnen offline abspielbar sind."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κατεβάζει νέα επεισόδια από μόνο του, ώστε να είναι έτοιμα για αναπαραγωγή εκτός σύνδεσης πριν καν τα ανοίξετε."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descarga los episodios nuevos automáticamente, listos para reproducirse sin conexión antes de que los abras."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قسمت‌های جدید را خودش دانلود می‌کند، بنابراین قبل از اینکه آن‌ها را باز کنید برای پخش آفلاین آماده هستند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Télécharge automatiquement les nouveaux épisodes, prêts à être écoutés hors ligne avant même que vous ne les ouvriez."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מוריד פרקים חדשים בעצמו, כך שהם מוכנים להשמעה במצב לא מקוון עוד לפני שאתה פותח אותם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नए एपिसोड अपने आप डाउनलोड करता है, ताकि खोलने से पहले ही वे ऑफ़लाइन चलाने के लिए तैयार हों।"

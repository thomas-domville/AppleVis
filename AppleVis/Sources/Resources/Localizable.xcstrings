        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulamayı veya siteyi kontrol etmeden AppleVis güncellemelerini otomatik olarak almak için tercih ettiğiniz RSS okuyucusunda bu akışlardan herhangi birine abone olun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Підпишіться на будь-яку з цих стрічок у вашій улюбленій програмі RSS, щоб автоматично отримувати оновлення AppleVis, не перевіряючи застосунок чи сайт."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đăng ký bất kỳ nguồn cấp dữ liệu nào trong số này trong trình đọc RSS ưa thích của bạn để nhận cập nhật AppleVis tự động, mà không cần kiểm tra ứng dụng hoặc trang web."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在您喜欢的 RSS 阅读器中订阅这些订阅源，即可自动接收 AppleVis 更新，无需查看应用或网站。"
          }
        }
      }
    },

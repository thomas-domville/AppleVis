    "Removes downloaded episodes once you've finished them, to keep them from piling up and using storage." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يزيل الحلقات التي تم تنزيلها بعد الانتهاء منها، لمنعها من التراكم واستهلاك مساحة التخزين."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entfernt heruntergeladene Folgen, sobald du sie beendet hast, damit sie sich nicht ansammeln und Speicherplatz belegen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Καταργεί τα ληφθέντα επεισόδια μόλις τα ολοκληρώσετε, ώστε να μην συσσωρεύονται και να μην καταλαμβάνουν χώρο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina los episodios descargados una vez que los terminas, para evitar que se acumulen y ocupen espacio."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قسمت‌های بارگیری‌شده را پس از اتمام حذف می‌کند تا انباشته نشوند و فضا اشغال نکنند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime les épisodes téléchargés une fois que vous les avez terminés, pour éviter qu'ils ne s'accumulent et occupent de l'espace."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מסיר פרקים שהורדו לאחר שסיימת אותם, כדי למנוע מהם להצטבר ולתפוס אחסון."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डाउनलोड किए गए एपिसोड समाप्त हो जाने पर हटाता है, ताकि वे जमा न हों और संग्रहण न लें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menghapus episode yang diunduh setelah Anda menyelesaikannya, agar tidak menumpuk dan memakan penyimpanan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rimuove gli episodi scaricati una volta terminati, per evitare che si accumulino e occupino spazio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再生を終えたダウンロード済みエピソードを削除し、蓄積してストレージを使い切ることを防ぎます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다운로드된 에피소드를 다 들은 후 제거해 저장 공간이 쌓이지 않게 합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwijdert gedownloade afleveringen zodra je ze hebt afgerond, zodat ze zich niet opstapelen en opslag gebruiken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usuwa pobrane odcinki po ich ukończeniu, aby zapobiec ich nagromadzeniu i zajmowaniu pamięci."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remove episódios baixados assim que você os termina, para evitar que se acumulem e ocupem armazenamento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удаляет загруженные эпизоды после их прослушивания, чтобы они не накапливались и не занимали место."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tar bort nedladdade avsnitt när du är klar med dem, för att hindra dem från att hopa sig och ta upp lagringsutrymme."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลบตอนที่ดาวน์โหลดเมื่อคุณฟังจบแล้ว เพื่อไม่ให้สะสมและใช้พื้นที่จัดเก็บ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bittiğinde indirilen bölümleri kaldırarak birikip depolama alanı kullanmalarını önler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Видаляє завантажені епізоди після прослуховування, щоб вони не накопичувались і не займали місце."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xóa các tập đã tải xuống sau khi bạn nghe xong, để tránh chúng tích tụ và chiếm dung lượng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在听完后移除已下载的单集，避免堆积占用存储空间。"
          }
        }
      }
    },

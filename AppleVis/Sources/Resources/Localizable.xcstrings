    "See a short, skippable walkthrough of Home, Discover, For You, Search, Profile, and Settings." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شاهد جولة قصيرة يمكن تخطيها للشاشة الرئيسية والاستكشاف ومن أجلك والبحث والملف الشخصي والإعدادات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sieh dir eine kurze, überspringbare Einführung zu Home, Entdecken, Für dich, Suche, Profil und Einstellungen an."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δείτε μια σύντομη, παραλείψιμη περιήγηση των Αρχική, Ανακάλυψη, Για Εσάς, Αναζήτηση, Προφίλ και Ρυθμίσεις."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mira un breve recorrido, que puedes omitir, de Inicio, Descubrir, Para ti, Buscar, Perfil y Configuración."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یک راهنمای کوتاه و قابل رد کردن از صفحهٔ اصلی، کشف کنید، برای شما، جستجو، نمایه و تنظیمات را ببینید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consultez une courte visite guidée, ignorable, d'Accueil, Découvrir, Pour vous, Recherche, Profil et Réglages."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "צפה בהדרכה קצרה וניתנת לדילוג על הבית, גילוי, בשבילך, חיפוש, פרופיל והגדרות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "होम, खोजें, आपके लिए, खोज, प्रोफ़ाइल, और सेटिंग्स का एक छोटा, छोड़ा जा सकने वाला वॉकथ्रू देखें。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",

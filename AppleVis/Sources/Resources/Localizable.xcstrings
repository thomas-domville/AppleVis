    "You're continuing as a guest, so these stay dimmed — sign in anytime to turn them on." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أنت تتابع كضيف، لذا تبقى هذه معطّلة — سجّل الدخول في أي وقت لتفعيلها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du machst als Gast weiter, daher bleibt das abgeblendet — melde dich jederzeit an, um es zu aktivieren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Συνεχίζετε ως επισκέπτης, οπότε αυτά παραμένουν αχνά — συνδεθείτε ανά πάσα στιγμή για να τα ενεργοποιήσετε."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estás continuando como invitado, así que esto permanece atenuado — inicia sesión en cualquier momento para activarlo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شما به‌عنوان مهمان ادامه می‌دهید، بنابراین این‌ها کم‌رنگ باقی می‌مانند — هر زمان برای روشن کردنشان وارد شوید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous continuez en tant qu'invité, donc ceci reste grisé — connectez-vous à tout moment pour l'activer."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "את/ה ממשיך/ה כאורח/ת, לכן אלו נשארים מעומעמים — התחבר/י בכל עת כדי להפעיל אותם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप गेस्ट के रूप में जारी रख रहे हैं, इसलिए ये धुंधले बने रहेंगे — इन्हें चालू करने के लिए कभी भी साइन इन करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda melanjutkan sebagai tamu, jadi ini tetap redup — masuk kapan saja untuk mengaktifkannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stai continuando come ospite, quindi questi restano disattivati — accedi in qualsiasi momento per attivarli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゲストとして続けているため、これらは淡色表示のままです——いつでもサインインすればオンにできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "게스트로 계속 진행 중이므로 이 항목들은 흐리게 표시된 상태로 유지됩니다 — 언제든지 로그인하면 켤 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je gaat verder als gast, dus dit blijft gedimd — log op elk moment in om het aan te zetten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontynuujesz jako gość, więc te opcje pozostają wyszarzone — zaloguj się w dowolnym momencie, aby je włączyć."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você está continuando como convidado, então isso fica esmaecido — faça login a qualquer momento para ativá-lo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы продолжаете как гость, поэтому эти пункты остаются приглушёнными — войдите в любое время, чтобы включить их."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du fortsätter som gäst, så det här förblir nedtonat — logga in när som helst för att slå på det."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณกำลังดำเนินการต่อในฐานะแขก ดังนั้นสิ่งเหล่านี้จะยังคงเป็นสีจาง — ลงชื่อเข้าใช้ได้ทุกเมื่อเพื่อเปิดใช้งาน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Misafir olarak devam ediyorsunuz, bu yüzden bunlar soluk kalır — açmak için istediğiniz zaman oturum açabilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ви продовжуєте як гість, тому ці пункти залишаються тьмяними — увійдіть будь-коли, щоб увімкнути їх."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn đang tiếp tục với tư cách khách, vì vậy các mục này vẫn bị làm mờ — hãy đăng nhập bất cứ lúc nào để bật chúng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你正以访客身份继续，因此这些选项会保持灰显——随时登录即可开启它们。"
          }
        }
      }
    },

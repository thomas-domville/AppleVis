    "Add your email so our editorial team can reply, then tell us about your post and write or import your draft." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أدخل بريدك الإلكتروني حتى يتمكن فريقنا التحريري من الرد، ثم أخبرنا عن منشورك واكتب مسودتك أو استوردها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib deine E-Mail-Adresse an, damit unser Redaktionsteam antworten kann, erzähl uns dann von deinem Beitrag und schreibe oder importiere deinen Entwurf."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δώστε το email σας ώστε η συντακτική μας ομάδα να μπορεί να απαντήσει, μετά πείτε μας για την ανάρτησή σας και γράψτε ή εισαγάγετε το προσχέδιό σας."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indica tu correo para que nuestro equipo editorial pueda responderte, cuéntanos sobre tu publicación y escribe o importa tu borrador."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ایمیل خود را وارد کنید تا تیم سردبیری ما بتواند پاسخ دهد، سپس دربارهٔ پست خود به ما بگویید و پیش‌نویس خود را بنویسید یا وارد کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indiquez votre e-mail pour que notre équipe éditoriale puisse vous répondre, puis parlez-nous de votre article et rédigez ou importez votre brouillon."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הזן את האימייל שלך כדי שצוות המערכת שלנו יוכל להשיב, ואז ספר לנו על הפוסט שלך וכתוב או ייבא את הטיוטה שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपना ईमेल दें ताकि हमारी संपादकीय टीम जवाब दे सके, फिर अपनी पोस्ट के बारे में बताएं और अपना ड्राफ़्ट लिखें या आयात करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masukkan email Anda agar tim editorial kami dapat membalas, lalu ceritakan tentang postingan Anda dan tulis atau impor draf Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inserisci la tua email per permettere al nostro team editoriale di risponderti, poi parlaci del tuo articolo e scrivi o importa la tua bozza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "編集チームが返信できるようメールアドレスを入力し、投稿について教えてから、下書きを作成またはインポートしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "편집팀이 답장할 수 있도록 이메일을 입력한 다음, 게시물에 대해 알려주고 초안을 작성하거나 가져오세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geef je e-mailadres op zodat ons redactieteam kan reageren, vertel ons dan over je bericht en schrijf of importeer je concept."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podaj swój e-mail, aby nasz zespół redakcyjny mógł odpowiedzieć, a następnie opowiedz nam o swoim wpisie i napisz lub zaimportuj szkic."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Informe seu e-mail para que nossa equipe editorial possa responder, depois nos conte sobre sua postagem e escreva ou importe seu rascunho."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Укажите свой email, чтобы наша редакция могла ответить, затем расскажите о своей публикации и напишите или импортируйте черновик."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ange din e-post så att vår redaktion kan svara, berätta sedan om ditt inlägg och skriv eller importera ditt utkast."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใส่อีเมลของคุณเพื่อให้ทีมบรรณาธิการของเราตอบกลับได้ จากนั้นบอกเราเกี่ยวกับโพสต์ของคุณและเขียนหรือนำเข้าฉบับร่างของคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Editör ekibimizin yanıt verebilmesi için e-postanızı girin, ardından yazınız hakkında bize bilgi verin ve taslağınızı yazın veya içe aktarın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вкажіть свою електронну пошту, щоб наша редакція могла відповісти, потім розкажіть про свій допис і напишіть або імпортуйте чернетку."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thêm email của bạn để đội ngũ biên tập có thể phản hồi, sau đó cho chúng tôi biết về bài viết của bạn và viết hoặc nhập bản nháp."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请填写您的邮箱以便编辑团队回复,然后告诉我们您的文章内容,并撰写或导入您的草稿。"
          }
        }
      }
    },

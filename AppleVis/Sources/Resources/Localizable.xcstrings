    "Reports this warning to the AppleVis editorial team as a possible false positive." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُبلغ هذا التحذير إلى فريق التحرير في AppleVis باعتباره إنذارًا كاذبًا محتملًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meldet diese Warnung als möglichen Fehlalarm an das AppleVis-Redaktionsteam."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αναφέρει αυτήν την προειδοποίηση στη συντακτική ομάδα του AppleVis ως πιθανό ψευδώς θετικό αποτέλεσμα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Informa esta advertencia al equipo editorial de AppleVis como un posible falso positivo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این هشدار را به‌عنوان یک هشدار کاذب احتمالی به تیم سردبیری AppleVis گزارش می‌دهد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Signale cet avertissement à l'équipe éditoriale d'AppleVis comme un possible faux positif."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מדווח על אזהרה זו לצוות המערכת של AppleVis כאזעקת שווא אפשרית."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस चेतावनी को संभावित गलत सकारात्मक परिणाम के रूप में AppleVis संपादकीय टीम को रिपोर्ट करता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melaporkan peringatan ini ke tim editorial AppleVis sebagai kemungkinan positif palsu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segnala questo avviso al team editoriale di AppleVis come possibile falso positivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この警告を誤検知の可能性としてAppleVis編集チームに報告します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 경고를 잘못된 감지일 가능성으로 AppleVis 편집팀에 신고합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meldt deze waarschuwing bij het redactieteam van AppleVis als mogelijk foutief positief."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zgłasza to ostrzeżenie zespołowi redakcyjnemu AppleVis jako możliwy fałszywy alarm."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reporta este aviso à equipe editorial da AppleVis como um possível falso positivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сообщает об этом предупреждении редакции AppleVis как о возможном ложном срабатывании."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rapporterar den här varningen till AppleVis redaktion som en möjlig felaktig varning."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รายงานคำเตือนนี้ไปยังทีมบรรณาธิการของ AppleVis ว่าอาจเป็นการแจ้งเตือนที่ผิดพลาด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu uyarıyı olası bir yanlış pozitif olarak AppleVis editör ekibine bildirir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повідомляє про це попередження редакційній команді AppleVis як про можливе хибне спрацювання."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Báo cáo cảnh báo này cho đội ngũ biên tập AppleVis như một khả năng cảnh báo sai."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将此警告作为可能的误报报告给 AppleVis 编辑团队。"
          }
        }
      }
    },
    "Required, minimum 20 characters. Share what it's actually like to use this app with VoiceOver or other accessibility features — what works well, what doesn't, and anything another blind or low vision user would want to know before trying it." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مطلوب، 20 حرفًا كحد أدنى. شارك كيف تكون تجربة استخدام هذا التطبيق فعليًا مع VoiceOver أو ميزات إمكانية الوصول الأخرى — ما الذي يعمل بشكل جيد، وما الذي لا يعمل، وأي شيء قد يرغب مستخدم كفيف أو ضعيف البصر آخر في معرفته قبل تجربته."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erforderlich, mindestens 20 Zeichen. Beschreibe, wie es wirklich ist, diese App mit VoiceOver oder anderen Bedienungshilfen zu nutzen — was gut funktioniert, was nicht, und alles, was eine andere blinde oder sehbehinderte Person wissen möchte, bevor sie die App ausprobiert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",

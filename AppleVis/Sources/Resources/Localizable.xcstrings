    "Resumes the last-played AppleVis podcast episode from where you left off." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستأنف آخر حلقة من بودكاست AppleVis تم تشغيلها من حيث توقفت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setzt die zuletzt abgespielte AppleVis-Podcast-Folge dort fort, wo du aufgehört hast."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",

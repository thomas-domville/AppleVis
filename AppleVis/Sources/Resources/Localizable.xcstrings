        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce brouillon pourrait paraître agacé ou sec. Un ton plus calme aide les autres à répondre utilement."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הטיוטה הזו עלולה להישמע מתוסכלת או חדה. טון רגוע יותר עוזר לאחרים להגיב באופן מועיל."

        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "موضوعات غیرمرتبط با اپل شامل ویندوز، اندروید، فناوری خانهٔ هوشمند و بحث‌های کلی دربارهٔ فناوری کمکی می‌شود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sujets non liés à Apple incluent Windows, Android, la domotique et les discussions générales sur les technologies d'assistance."

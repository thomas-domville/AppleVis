    "Welcome back to AppleVis. Returning to where you left off." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مرحبًا بعودتك إلى AppleVis. تعود إلى حيث توقفت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Willkommen zurück bei AppleVis. Du machst dort weiter, wo du aufgehört hast."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Καλώς ήρθατε ξανά στο AppleVis. Συνεχίζετε από εκεί που σταματήσατε."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bienvenido de nuevo a AppleVis. Vuelves donde lo dejaste."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دوباره به AppleVis خوش آمدید. به جایی که مانده بودید برمی‌گردید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bon retour sur AppleVis. Vous reprenez là où vous vous étiez arrêté."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ברוכים השבים ל-AppleVis. חוזרים למקום שבו עצרתם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleVis पर फिर से स्वागत है। आप वहीं लौट रहे हैं जहाँ आपने छोड़ा था।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selamat datang kembali di AppleVis. Kembali ke tempat terakhir Anda berhenti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bentornato su AppleVis. Riprendi da dove avevi lasciato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleVis へおかえりなさい。前回の続きから始めます。"

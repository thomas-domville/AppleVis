        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu uygulamayı kendim kullandım ve erişilebilirliğini anlatabilirim. Yalnızca App Store açıklamasına dayanmıyorum."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Я сам користувався цим додатком і можу описати його доступність. Я спираюся не лише на опис в App Store."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tôi đã tự dùng ứng dụng này và có thể mô tả trợ năng của nó. Tôi không chỉ dựa vào mô tả trên App Store."

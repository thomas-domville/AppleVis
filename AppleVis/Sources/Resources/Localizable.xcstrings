    "Uses your device's own default alert tone when a notification arrives. Preview unavailable due to iOS system restrictions." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم نغمة التنبيه الافتراضية لجهازك عند وصول إشعار. المعاينة غير متاحة بسبب قيود iOS."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwendet den Standard-Hinweiston deines Geräts, wenn eine Benachrichtigung eintrifft. Wegen Einschränkungen von iOS ist keine Vorschau möglich."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χρησιμοποιεί τον προεπιλεγμένο ήχο ειδοποίησης της συσκευής σας όταν φτάνει μια ειδοποίηση. Η προεπισκόπηση δεν είναι διαθέσιμη λόγω περιορισμών του iOS."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa el tono de alerta predeterminado de tu dispositivo cuando llega una notificación. Vista previa no disponible por restricciones de iOS."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هنگام رسیدن اعلان از صدای هشدار پیش‌فرض دستگاه شما استفاده می‌کند. به دلیل محدودیت‌های iOS پیش‌نمایش در دسترس نیست."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilise la tonalité d'alerte par défaut de votre appareil à l'arrivée d'une notification. Aperçu indisponible en raison des restrictions d'iOS."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "משתמש בצליל ההתראה המוגדר כברירת מחדל במכשיר כשמגיעה התראה. תצוגה מקדימה לא זמינה בגלל מגבלות iOS."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सूचना आने पर आपके डिवाइस की डिफ़ॉल्ट अलर्ट टोन का उपयोग करता है। iOS की सीमाओं के कारण पूर्वावलोकन उपलब्ध नहीं है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menggunakan nada peringatan default perangkat Anda saat notifikasi masuk. Pratinjau tidak tersedia karena batasan iOS."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa il tono di avviso predefinito del dispositivo quando arriva una notifica. Anteprima non disponibile per le restrizioni di iOS."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通知が届いたときに、デバイスのデフォルトの通知音を使います。iOS の制限により、プレビューは利用できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "알림이 오면 기기의 기본 알림음을 사용합니다. iOS 제한으로 미리 듣기를 사용할 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruikt de standaardwaarschuwingstoon van je apparaat wanneer er een melding binnenkomt. Voorbeeld niet beschikbaar door beperkingen van iOS."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Używa domyślnego dźwięku alertu urządzenia, gdy przychodzi powiadomienie. Podgląd niedostępny z powodu ograniczeń iOS."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa o toque de alerta padrão do seu dispositivo quando chega uma notificação. Prévia indisponível devido a restrições do iOS."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Использует стандартный звук оповещения вашего устройства при получении уведомления. Предпрослушивание недоступно из-за ограничений iOS."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Använder enhetens standardsignal när en avisering kommer. Förhandslyssning är inte tillgänglig på grund av begränsningar i iOS."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้เสียงเตือนเริ่มต้นของอุปกรณ์เมื่อมีการแจ้งเตือน ไม่มีตัวอย่างเสียงเนื่องจากข้อจำกัดของ iOS"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir bildirim geldiğinde cihazınızın varsayılan uyarı sesini kullanır. iOS kısıtlamaları nedeniyle önizleme kullanılamaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Використовує стандартний звук сповіщення вашого пристрою, коли надходить сповіщення. Попереднє прослуховування недоступне через обмеження iOS."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dùng âm báo mặc định của thiết bị khi có thông báo. Không nghe thử được do giới hạn của iOS."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "收到通知时使用设备的默认提示音。由于 iOS 的限制，无法试听。"
          }
        }
      }
    },

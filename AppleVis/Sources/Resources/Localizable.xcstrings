    "Copies version, build, iOS, device, theme, and accessibility settings to the clipboard so you can paste them into a support request." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ينسخ الإصدار والبناء وiOS والجهاز والسمة وإعدادات إمكانية الوصول إلى الحافظة حتى تتمكن من لصقها في طلب دعم."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopiert Version, Build, iOS, Gerät, Thema und Bedienungshilfen-Einstellungen in die Zwischenablage, damit du sie in eine Support-Anfrage einfügen kannst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αντιγράφει έκδοση, build, iOS, συσκευή, θέμα και ρυθμίσεις προσβασιμότητας στο πρόχειρο ώστε να μπορείτε να τα επικολλήσετε σε ένα αίτημα υποστήριξης."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copia la versión, compilación, iOS, dispositivo, tema y ajustes de accesibilidad al portapapeles para que puedas pegarlos en una solicitud de soporte."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نسخه، بیلد، iOS، دستگاه، پوسته و تنظیمات دسترس‌پذیری را در کلیپ‌بورد کپی می‌کند تا بتوانید آن‌ها را در درخواست پشتیبانی جای‌گذاری کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copie la version, la build, iOS, l'appareil, le thème et les réglages d'accessibilité dans le presse-papiers afin que vous puissiez les coller dans une demande d'assistance."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מעתיק גרסה, build, iOS, מכשיר, ערכת נושא והגדרות נגישות ללוח הגזירים כדי שתוכל להדביק אותם בבקשת תמיכה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "संस्करण, बिल्ड, iOS, डिवाइस, थीम, और सुलभता सेटिंग्स को क्लिपबोर्ड पर कॉपी करता है ताकि आप उन्हें सहायता अनुरोध में पेस्ट कर सकें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menyalin versi, build, iOS, perangkat, tema, dan pengaturan aksesibilitas ke papan klip sehingga Anda dapat menempelkannya ke permintaan dukungan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copia versione, build, iOS, dispositivo, tema e impostazioni di accessibilità negli appunti in modo da poterli incollare in una richiesta di supporto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バージョン、ビルド、iOS、デバイス、テーマ、アクセシビリティ設定をクリップボードにコピーし、サポートリクエストに貼り付けられるようにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "버전, 빌드, iOS, 기기, 테마, 접근성 설정을 클립보드에 복사해 지원 요청에 붙여넣을 수 있게 합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopieert versie, build, iOS, apparaat, thema en toegankelijkheidsinstellingen naar het klembord zodat je ze in een ondersteuningsverzoek kunt plakken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopiuje wersję, build, iOS, urządzenie, motyw i ustawienia ułatwień dostępu do schowka, dzięki czemu możesz je wkleić w zgłoszeniu do pomocy technicznej."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copia versão, build, iOS, dispositivo, tema e configurações de acessibilidade para a área de transferência para que você possa colá-los em uma solicitação de suporte."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Копирует версию, сборку, версию iOS, устройство, тему и настройки специальных возможностей в буфер обмена, чтобы вы могли вставить их в запрос в поддержку."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopierar version, byggnummer, iOS, enhet, tema och hjälpmedelsinställningar till urklipp så att du kan klistra in dem i en supportförfrågan."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คัดลอกเวอร์ชัน บิลด์ iOS อุปกรณ์ ธีม และการตั้งค่าการช่วยการเข้าถึงไปยังคลิปบอร์ดเพื่อให้คุณวางลงในคำขอสนับสนุนได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir destek talebine yapıştırabilmeniz için sürüm, derleme, iOS, cihaz, tema ve erişilebilirlik ayarlarını panoya kopyalar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Копіює версію, збірку, iOS, пристрій, тему та налаштування спеціальних можливостей у буфер обміну, щоб ви могли вставити їх у запит підтримки."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sao chép phiên bản, bản dựng, iOS, thiết bị, giao diện và cài đặt trợ năng vào khay nhớ tạm để bạn có thể dán vào yêu cầu hỗ trợ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将版本、构建号、iOS、设备、主题和辅助功能设置复制到剪贴板，方便您粘贴到支持请求中。"
          }
        }
      }
    },

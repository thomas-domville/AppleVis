    "Matched automatically from the App Store by name — not confirmed by AppleVis." : {
      "comment" : "A description of the warning that appears when the app's name is matched from the App Store, but not yet confirmed by AppleVis.",
      "isCommentAutoGenerated" : true,
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تمت المطابقة تلقائيًا من App Store بالاسم — لم تؤكدها AppleVis."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatisch anhand des Namens aus dem App Store zugeordnet – nicht von AppleVis bestätigt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ταιριάχτηκε αυτόματα από το App Store κατά όνομα — δεν έχει επιβεβαιωθεί από το AppleVis."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coincidencia automática por nombre según la App Store; no confirmado por AppleVis."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "به‌طور خودکار بر اساس نام از App Store تطبیق داده شده — توسط AppleVis تأیید نشده است."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Correspondance automatique par nom depuis l'App Store — non confirmée par AppleVis."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הותאם אוטומטית מ-App Store לפי שם — לא אושר על ידי AppleVis."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store से नाम के आधार पर स्वचालित रूप से मिलान किया गया — AppleVis द्वारा पुष्टि नहीं की गई।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dicocokkan otomatis dari App Store berdasarkan nama — belum dikonfirmasi oleh AppleVis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corrisposto automaticamente dall'App Store per nome — non confermato da AppleVis."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store から名前で自動的に照合されました。AppleVis による確認はまだです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store에서 이름으로 자동 일치됨 — AppleVis가 확인하지 않음."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatisch gekoppeld op naam vanuit de App Store — niet bevestigd door AppleVis."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatycznie dopasowane po nazwie z App Store — niepotwierdzone przez AppleVis."
          }
        },
        "pt" : {
          "stringUnit" : {

    "Narrows the feed down to just topics about Apple products and platforms — everything else stays hidden." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقلص التغذية إلى مواضيع تتعلق فقط بمنتجات ومنصات Apple — يبقى كل شيء آخر مخفيًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beschränkt den Feed auf Themen zu Apple-Produkten und -Plattformen – alles andere bleibt ausgeblendet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Περιορίζει τη ροή μόνο σε θέματα σχετικά με προϊόντα και πλατφόρμες Apple — όλα τα υπόλοιπα παραμένουν κρυφά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reduce el feed a solo los temas sobre productos y plataformas de Apple; todo lo demás permanece oculto."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فید را فقط به موضوعات مربوط به محصولات و پلتفرم‌های اپل محدود می‌کند — بقیه پنهان می‌ماند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réduit le fil aux sujets concernant uniquement les produits et plateformes Apple — tout le reste reste masqué."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מצמצם את הפיד רק לנושאים על מוצרים ופלטפורמות של Apple — כל השאר נשאר מוסתר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फ़ीड को केवल Apple उत्पादों और प्लेटफ़ॉर्म के विषयों तक सीमित करता है — बाकी सब छिपा रहता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mempersempit umpan hanya untuk topik tentang produk dan platform Apple — semua yang lain tetap tersembunyi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restringe il feed solo agli argomenti su prodotti e piattaforme Apple: tutto il resto rimane nascosto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フィードを Apple 製品やプラットフォームに関するトピックのみに絞り込みます。それ以外は非表示のままです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "피드를 Apple 제품 및 플랫폼에 관한 주제로만 좁힙니다 — 나머지는 숨겨진 상태로 유지됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beperkt de feed tot alleen onderwerpen over Apple-producten en -platforms — al het andere blijft verborgen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zawęża kanał tylko do wątków dotyczących produktów i platform Apple — wszystko inne pozostaje ukryte."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reduz o feed a apenas tópicos sobre produtos e plataformas Apple — tudo o mais permanece oculto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сужает ленту только до тем о продуктах и платформах Apple — всё остальное остаётся скрытым."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begränsar flödet till endast ämnen om Apples produkter och plattformar — allt annat förblir dolt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จำกัดฟีดให้เหลือเฉพาะหัวข้อเกี่ยวกับผลิตภัณฑ์และแพลตฟอร์มของ Apple — สิ่งอื่นจะถูกซ่อนไว้"

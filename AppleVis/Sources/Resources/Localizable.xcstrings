        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι Επιλογές της κοινότητας δείχνουν τις εφαρμογές που προτείνουν τα μέλη του AppleVis. Κάθε εφαρμογή εμφανίζεται μία φορά, με το πόσοι την πρότειναν και πότε προτάθηκε τελευταία φορά."
          }
        },
        "es" : {
          "stringUnit" : {

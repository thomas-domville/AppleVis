        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σας ειδοποιεί όταν κάποιος απαντά. Μπορείτε να διακόψετε την παρακολούθηση ανά πάσα στιγμή από το ίδιο το θέμα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",

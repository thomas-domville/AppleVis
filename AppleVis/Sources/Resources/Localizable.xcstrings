    "I confirm this is a genuine message — not sponsored content, advertising, an SEO submission, or any other paid proposal." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أؤكد أن هذه رسالة حقيقية — وليست محتوى مدعومًا أو إعلانًا أو مشاركة لتحسين محركات البحث (SEO) أو أي اقتراح آخر مدفوع الأجر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich bestätige, dass dies eine echte Nachricht ist — kein gesponserter Inhalt, keine Werbung, kein SEO-Beitrag und kein anderweitiger bezahlter Vorschlag."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιβεβαιώνω ότι αυτό είναι ένα γνήσιο μήνυμα — όχι χορηγούμενο περιεχόμενο, διαφήμιση, υποβολή SEO ή οποιαδήποτε άλλη επί πληρωμή πρόταση."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confirmo que este es un mensaje genuino — no contenido patrocinado, publicidad, una propuesta de SEO ni ninguna otra propuesta pagada."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تأیید می‌کنم که این پیام واقعی است — نه محتوای اسپانسرشده، تبلیغات، ارسال سئو یا هر پیشنهاد پولی دیگری."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je confirme qu'il s'agit d'un message authentique — pas d'un contenu sponsorisé, d'une publicité, d'une soumission SEO ou de toute autre proposition payante."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אני מאשר שזוהי הודעה אמיתית — לא תוכן ממומן, פרסום, הגשת SEO או כל הצעה בתשלום אחרת."
          }
        },
        "hi" : {

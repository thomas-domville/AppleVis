    "This cannot be undone. Consider signing out instead if you just want a break." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن التراجع عن هذا. فكّر في تسجيل الخروج بدلاً من ذلك إذا كنت تريد استراحة فقط."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies kann nicht rückgängig gemacht werden. Erwäge stattdessen, dich abzumelden, wenn du nur eine Pause möchtest."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτό δεν μπορεί να αναιρεθεί. Σκεφτείτε να αποσυνδεθείτε αντ' αυτού αν θέλετε απλώς ένα διάλειμμα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto no se puede deshacer. Considera cerrar sesión en su lugar si solo quieres un descanso."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این کار قابل بازگشت نیست. اگر فقط می‌خواهید استراحت کنید، خروج از حساب را در نظر بگیرید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette action est irréversible. Envisagez plutôt de vous déconnecter si vous voulez simplement faire une pause."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לא ניתן לבטל פעולה זו. שקול להתנתק במקום זאת אם אתה רק רוצה הפסקה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसे पूर्ववत नहीं किया जा सकता। यदि आप बस एक ब्रेक चाहते हैं, तो इसके बजाय साइन आउट करने पर विचार करें。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini tidak dapat dibatalkan. Pertimbangkan untuk keluar sebagai gantinya jika Anda hanya ingin istirahat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa azione non può essere annullata. Se vuoi solo fare una pausa, valuta invece di disconnetterti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これは元に戻せません。単に一休みしたいだけの場合は、サインアウトすることをご検討ください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 작업은 되돌릴 수 없습니다. 잠시 쉬고 싶은 것뿐이라면 대신 로그아웃을 고려해 보세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit kan niet ongedaan worden gemaakt. Overweeg in plaats daarvan uit te loggen als je gewoon even pauze wilt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tego nie można cofnąć. Jeśli chcesz po prostu zrobić przerwę, rozważ wylogowanie się."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso não pode ser desfeito. Considere sair em vez disso se você só quer uma pausa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это нельзя отменить. Если вы просто хотите сделать перерыв, вместо этого рассмотрите выход из системы."

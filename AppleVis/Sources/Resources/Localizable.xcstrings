        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminarán todos los episodios descargados. Puedes volver a descargarlos en cualquier momento mientras estés conectado a internet."
          }
        },
        "fa" : {
          "stringUnit" : {

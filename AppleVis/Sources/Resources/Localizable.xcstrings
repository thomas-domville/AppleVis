    "Connect instantly with a sighted volunteer via live video, 24/7 in 185 languages." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تواصل فورًا مع متطوع مبصر عبر فيديو مباشر، على مدار الساعة، بـ 185 لغة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbinde dich sofort per Live-Video mit sehenden Freiwilligen, rund um die Uhr in 185 Sprachen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Συνδεθείτε αμέσως με έναν βλέποντα εθελοντή μέσω ζωντανού βίντεο, όλο το 24ωρο, σε 185 γλώσσες."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",

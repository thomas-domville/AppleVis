          }
        }
      }
    },
    "Your post has several exclamation or question marks in a row. Using fewer will help your message sound calmer." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتوي منشورك على عدة علامات تعجب أو استفهام متتالية. استخدام عدد أقل يجعل رسالتك تبدو أهدأ."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Beitrag enthält mehrere Ausrufe- oder Fragezeichen hintereinander. Weniger davon lassen deine Nachricht ruhiger klingen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η ανάρτησή σας έχει πολλά θαυμαστικά ή ερωτηματικά στη σειρά. Με λιγότερα, το μήνυμά σας θα ακούγεται πιο ήρεμο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu publicación tiene varios signos de exclamación o interrogación seguidos. Usar menos hará que tu mensaje suene más tranquilo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پست شما چند علامت تعجب یا سؤال پشت سر هم دارد. استفادهٔ کمتر از آن‌ها پیامتان را آرام‌تر نشان می‌دهد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre message contient plusieurs points d'exclamation ou d'interrogation d'affilée. En utiliser moins rendra votre message plus calme."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בפוסט שלכם יש כמה סימני קריאה או שאלה ברצף. שימוש בפחות מהם יגרום להודעה להישמע רגועה יותר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी पोस्ट में लगातार कई विस्मयादिबोधक या प्रश्नवाचक चिह्न हैं। कम इस्तेमाल करने से आपका संदेश ज़्यादा शांत लगेगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Postingan Anda memiliki beberapa tanda seru atau tanda tanya berturut-turut. Memakai lebih sedikit akan membuat pesan Anda terdengar lebih tenang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo post ha diversi punti esclamativi o interrogativi di seguito. Usarne meno renderà il messaggio più pacato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "投稿に感嘆符や疑問符が続けて使われています。数を減らすと、落ち着いた印象になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "게시물에 느낌표나 물음표가 여러 개 연달아 있습니다. 개수를 줄이면 메시지가 더 차분하게 느껴집니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je bericht bevat meerdere uitroep- of vraagtekens achter elkaar. Met minder klinkt je bericht rustiger."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twój wpis ma kilka wykrzykników lub znaków zapytania z rzędu. Mniejsza ich liczba sprawi, że wiadomość zabrzmi spokojniej."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua postagem tem vários pontos de exclamação ou de interrogação seguidos. Usar menos vai deixar sua mensagem mais calma."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В вашем сообщении несколько восклицательных или вопросительных знаков подряд. Если их будет меньше, сообщение прозвучит спокойнее."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ditt inlägg har flera utrops- eller frågetecken i rad. Färre gör att ditt meddelande låter lugnare."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "โพสต์ของคุณมีเครื่องหมายอัศเจรีย์หรือเครื่องหมายคำถามหลายตัวติดกัน การใช้น้อยลงจะทำให้ข้อความฟังดูสงบขึ้น"

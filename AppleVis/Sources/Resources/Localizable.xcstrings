    "This draft may break the AppleVis guidelines on respectful discussion. Please change the tone before posting." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قد تخالف هذه المسودة إرشادات AppleVis للنقاش المحترم. يُرجى تغيير النبرة قبل النشر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Entwurf verstößt möglicherweise gegen die AppleVis-Richtlinien für respektvolle Diskussionen. Bitte ändere den Ton vor dem Veröffentlichen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτό το προσχέδιο μπορεί να παραβιάζει τους κανόνες του AppleVis για συζήτηση με σεβασμό. Αλλάξτε τον τόνο πριν το δημοσιεύσετε."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este borrador podría incumplir las normas de AppleVis sobre el debate respetuoso. Cambia el tono antes de publicar."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این پیش‌نویس ممکن است با راهنمای AppleVis دربارهٔ گفتگوی محترمانه مغایر باشد. لطفاً پیش از انتشار لحن را تغییر دهید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce brouillon pourrait enfreindre les règles d'AppleVis sur le respect dans les discussions. Modifiez le ton avant de publier."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הטיוטה הזו עלולה להפר את ההנחיות של AppleVis לדיון מכבד. נא לשנות את הטון לפני הפרסום."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह ड्राफ़्ट सम्मानजनक चर्चा के AppleVis दिशानिर्देशों का उल्लंघन कर सकता है। कृपया पोस्ट करने से पहले लहजा बदलें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Draf ini mungkin melanggar pedoman AppleVis tentang diskusi yang saling menghormati. Harap ubah nadanya sebelum memposting."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa bozza potrebbe violare le linee guida di AppleVis sulla discussione rispettosa. Cambia il tono prima di pubblicare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この下書きは、敬意ある議論に関する AppleVis のガイドラインに反している可能性があります。投稿する前に口調を変えてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 초안은 존중하는 토론에 관한 AppleVis 가이드라인에 어긋날 수 있습니다. 게시하기 전에 어조를 바꿔 주세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit concept kan in strijd zijn met de AppleVis-richtlijnen voor respectvolle discussie. Pas de toon aan voordat je het plaatst."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta wersja robocza może naruszać zasady AppleVis dotyczące kulturalnej dyskusji. Zmień ton przed publikacją."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este rascunho pode violar as diretrizes do AppleVis sobre discussão respeitosa. Mude o tom antes de publicar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот черновик может нарушать правила AppleVis об уважительном общении. Измените тон перед публикацией."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det här utkastet kan bryta mot AppleVis riktlinjer för respektfull diskussion. Ändra tonen innan du publicerar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ฉบับร่างนี้อาจขัดกับแนวทางของ AppleVis เรื่องการสนทนาอย่างให้เกียรติ โปรดเปลี่ยนน้ำเสียงก่อนโพสต์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu taslak, saygılı tartışmayla ilgili AppleVis yönergelerini ihlal edebilir. Lütfen yayınlamadan önce tonu değiştirin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ця чернетка може порушувати правила AppleVis щодо шанобливого спілкування. Змініть тон перед публікацією."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bản nháp này có thể vi phạm quy tắc của AppleVis về thảo luận tôn trọng. Vui lòng đổi giọng điệu trước khi đăng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",

        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajusta el equilibrio de frecuencias del audio. Claridad de voz suele ser lo mejor para pódcasts hablados."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعادل فرکانس صدا را تنظیم می‌کند. وضوح گفتار معمولاً برای پادکست‌های گفتاری بهترین گزینه است."

    "Offers a polished rewrite while you're writing a post or message, without changing what you're trying to say." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقدم إعادة صياغة أنيقة أثناء كتابتك لمنشور أو رسالة، دون تغيير ما تحاول قوله."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bietet beim Verfassen eines Beitrags oder einer Nachricht eine ausgefeilte Umformulierung, ohne zu ändern, was du sagen möchtest."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προσφέρει μια βελτιωμένη επανασύνταξη ενώ γράφετε μια ανάρτηση ή μήνυμα, χωρίς να αλλάζει αυτό που προσπαθείτε να πείτε."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ofrece una reescritura pulida mientras escribes una publicación o mensaje, sin cambiar lo que intentas decir."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هنگام نوشتن پست یا پیام، بازنویسی صیقلی ارائه می‌دهد بدون اینکه آنچه می‌خواهید بگویید را تغییر دهد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Propose une réécriture soignée pendant que vous rédigez une publication ou un message, sans changer ce que vous essayez de dire."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מציע ניסוח מלוטש בזמן שאתה כותב פוסט או הודעה, מבלי לשנות את מה שאתה מנסה לומר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पोस्ट या संदेश लिखते समय, आप जो कहना चाहते हैं उसे बदले बिना एक परिष्कृत पुनर्लेखन प्रदान करता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menawarkan penulisan ulang yang lebih baik saat Anda menulis postingan atau pesan, tanpa mengubah apa yang ingin Anda katakan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offre una riscrittura raffinata mentre stai scrivendo un post o un messaggio, senza cambiare ciò che stai cercando di dire."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "投稿やメッセージを書いている間に、伝えたい内容を変えることなく洗練されたリライトを提案します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "게시물이나 메시지를 작성하는 동안 말하려는 내용을 바꾸지 않고 세련되게 다시 써줍니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biedt een verfijnde herschrijving terwijl je een bericht schrijft, zonder te veranderen wat je probeert te zeggen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oferuje dopracowane przeredagowanie podczas pisania posta lub wiadomości, bez zmiany tego, co próbujesz powiedzieć."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oferece uma reescrita polida enquanto você escreve uma postagem ou mensagem, sem alterar o que você está tentando dizer."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Предлагает отшлифованную переработку текста во время написания публикации или сообщения, не меняя то, что вы хотите сказать."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erbjuder en polerad omskrivning medan du skriver ett inlägg eller meddelande, utan att ändra vad du försöker säga."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เสนอการเขียนใหม่ที่ขัดเกลาขณะที่คุณเขียนโพสต์หรือข้อความ โดยไม่เปลี่ยนสิ่งที่คุณต้องการสื่อ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir gönderi veya mesaj yazarken, söylemeye çalıştığınız şeyi değiştirmeden cilalı bir yeniden yazım sunar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пропонує вдосконалений варіант тексту під час написання допису чи повідомлення, не змінюючи те, що ви хочете сказати."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cung cấp bản viết lại tinh tế trong khi bạn viết bài đăng hoặc tin nhắn, mà không thay đổi ý bạn muốn nói."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在您撰写帖子或消息时提供润色改写，且不改变您想表达的内容。"
          }
        }
      }
    },

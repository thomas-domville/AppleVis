    },
    "This removes all episodes from your queue. Downloaded episodes will not be deleted." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يؤدي هذا إلى إزالة جميع الحلقات من قائمة الانتظار الخاصة بك. لن يتم حذف الحلقات التي تم تنزيلها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch werden alle Folgen aus deiner Warteschlange entfernt. Heruntergeladene Folgen werden nicht gelöscht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτό αφαιρεί όλα τα επεισόδια από την ουρά σας. Τα ληφθέντα επεισόδια δεν θα διαγραφούν."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto elimina todos los episodios de tu cola. Los episodios descargados no se eliminarán."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این کار همهٔ قسمت‌ها را از صف شما حذف می‌کند. قسمت‌های بارگیری‌شده حذف نخواهند شد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela supprime tous les épisodes de votre file d'attente. Les épisodes téléchargés ne seront pas supprimés."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "פעולה זו מסירה את כל הפרקים מהתור שלך. פרקים שהורדו לא יימחקו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह आपकी कतार से सभी एपिसोड हटा देता है। डाउनलोड किए गए एपिसोड हटाए नहीं जाएंगे。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini menghapus semua episode dari antrean Anda. Episode yang diunduh tidak akan dihapus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo rimuove tutti gli episodi dalla tua coda. Gli episodi scaricati non verranno eliminati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これにより、キュー内のすべてのエピソードが削除されます。ダウンロード済みのエピソードは削除されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대기열에서 모든 에피소드를 제거합니다. 다운로드된 에피소드는 삭제되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit verwijdert alle afleveringen uit je wachtrij. Gedownloade afleveringen worden niet verwijderd."

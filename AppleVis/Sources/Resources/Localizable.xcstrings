    "Loads any remaining comments and moves to the last one." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحمّل أي تعليقات متبقية وينتقل إلى آخرها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lädt alle verbleibenden Kommentare und springt zum letzten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Φορτώνει τυχόν εναπομείναντα σχόλια και μεταβαίνει στο τελευταίο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carga los comentarios restantes y va al último."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "همهٔ دیدگاه‌های باقی‌مانده را بارگیری کرده و به آخرین آن‌ها می‌رود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Charge les commentaires restants et passe au dernier."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "טוען את כל התגובות הנותרות ועובר לאחרונה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "शेष टिप्पणियाँ लोड करता है और अंतिम पर जाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memuat semua komentar yang tersisa dan berpindah ke yang terakhir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carica i commenti rimanenti e passa all'ultimo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "残りのコメントをすべて読み込み、最後のコメントに移動します。"

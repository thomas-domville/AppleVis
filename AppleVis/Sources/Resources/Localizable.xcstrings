          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle synchronisierten Daten sind durch Apples Ende-zu-Ende-Verschlüsselung von iCloud geschützt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",

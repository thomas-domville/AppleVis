    "Reads any text on screen. Available via the Share sheet or accessibility shortcut." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقرأ أي نص على الشاشة. متاح من ورقة المشاركة أو اختصار إمكانية الوصول."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liest beliebigen Text auf dem Bildschirm vor. Verfügbar über das Teilen-Menü oder den Bedienungshilfen-Kurzbefehl."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Διαβάζει οποιοδήποτε κείμενο στην οθόνη. Διαθέσιμο από το φύλλο κοινοποίησης ή τη συντόμευση προσβασιμότητας."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lee cualquier texto en pantalla. Disponible desde la hoja de compartir o el atajo de accesibilidad."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هر متنی را روی صفحه می‌خواند. از برگهٔ اشتراک‌گذاری یا میان‌بر دسترس‌پذیری در دسترس است."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lit n'importe quel texte à l'écran. Disponible depuis la feuille de partage ou le raccourci d'accessibilité."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מקריא כל טקסט על המסך. זמין דרך גיליון השיתוף או קיצור הנגישות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्क्रीन पर कोई भी टेक्स्ट पढ़ता है। शेयर शीट या सुलभता शॉर्टकट से उपलब्ध।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Membacakan teks apa pun di layar. Tersedia melalui lembar berbagi atau pintasan aksesibilitas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legge qualsiasi testo sullo schermo. Disponibile dal foglio di condivisione o dall'abbreviazione accessibilità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画面上のテキストを読み上げます。共有シートまたはアクセシビリティショートカットから使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "화면의 모든 텍스트를 읽어 줍니다. 공유 시트나 손쉬운 사용 단축키로 사용할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leest alle tekst op het scherm voor. Beschikbaar via het deelmenu of de toegankelijkheidsshortcut."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odczytuje dowolny tekst na ekranie. Dostępne z arkusza udostępniania lub skrótu ułatwień dostępu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lê qualquer texto na tela. Disponível pela planilha de compartilhamento ou pelo atalho de acessibilidade."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Читает любой текст на экране. Доступно через меню «Поделиться» или быстрые команды универсального доступа."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Läser upp all text på skärmen. Tillgänglig via delningsbladet eller hjälpmedelsgenvägen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อ่านข้อความใดก็ได้บนหน้าจอ ใช้ได้จากแผ่นแชร์หรือทางลัดการช่วยการเข้าถึง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekrandaki herhangi bir metni okur. Paylaş sayfasından veya erişilebilirlik kısayolundan kullanılabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Читає будь-який текст на екрані. Доступно через меню «Поширити» або швидку команду спеціальних можливостей."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đọc mọi văn bản trên màn hình. Dùng được từ bảng chia sẻ hoặc phím tắt trợ năng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "朗读屏幕上的任何文字。可通过共享表单或辅助功能快捷键使用。"
          }
        }
      }
    },
    "Translate selected text using the iOS Translate system. Long-press any text to access." : {

    "The Welcome Tour Got a Lot Bigger" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أصبحت جولة الترحيب أكبر بكثير"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Willkommenstour ist jetzt viel umfangreicher"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η Ξενάγηση Καλωσορίσματος Έγινε Πολύ Μεγαλύτερη"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El recorrido de bienvenida es mucho más completo"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تور خوش‌آمدگویی خیلی بزرگ‌تر شد"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La visite de bienvenue s'est beaucoup enrichie"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",

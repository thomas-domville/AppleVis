            "value" : "על מה זה?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह किस बारे में है?"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini tentang apa?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di cosa si tratta?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "何についてですか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "무엇에 관한 것인가요?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waar gaat dit over?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O co chodzi?"
          }
        },
        "pt" : {
          "stringUnit" : {

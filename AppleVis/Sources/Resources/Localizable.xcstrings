    "See milder language exactly as written. Strong language is still always blocked from posting." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شاهد الألفاظ الأخف تمامًا كما كُتبت. تظل الألفاظ القوية محظورة دائمًا عند النشر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mildere Sprache genau so sehen, wie sie geschrieben wurde. Starke Sprache bleibt beim Posten weiterhin immer blockiert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δείτε την ηπιότερη γλώσσα ακριβώς όπως γράφτηκε. Η έντονη γλώσσα εξακολουθεί να αποκλείεται πάντα κατά τη δημοσίευση."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ve el lenguaje más suave exactamente como se escribió. El lenguaje fuerte sigue siempre bloqueado al publicar."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "زبان ملایم‌تر را دقیقاً همان‌طور که نوشته شده ببینید. زبان تند همچنان همیشه هنگام ارسال مسدود می‌شود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voyez le langage plus léger exactement tel qu'il a été écrit. Le langage fort reste toujours bloqué à la publication."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "צפו בשפה מתונה יותר בדיוק כפי שנכתבה. שפה בוטה עדיין תמיד חסומה בעת פרסום."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हल्की भाषा को बिल्कुल वैसे ही देखें जैसी लिखी गई है। पोस्ट करते समय कठोर भाषा हमेशा रोकी जाती रहेगी।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lihat bahasa yang lebih ringan persis seperti yang ditulis. Bahasa kasar tetap selalu diblokir saat memposting."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vedi il linguaggio più lieve esattamente come è stato scritto. Il linguaggio forte resta sempre bloccato durante la pubblicazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "軽い言葉はそのまま書かれた通りに表示されます。強い言葉は投稿時に常にブロックされたままです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "순화된 표현을 작성된 그대로 볼 수 있습니다. 강한 표현은 게시 시 여전히 항상 차단됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bekijk mildere taal precies zoals geschreven. Sterke taal blijft altijd geblokkeerd bij het plaatsen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobacz łagodniejszy język dokładnie tak, jak został napisany. Mocny język nadal zawsze jest blokowany podczas publikowania."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veja a linguagem mais leve exatamente como foi escrita. A linguagem forte continua sempre bloqueada ao publicar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Видьте более мягкие слова точно так, как они написаны. Резкие выражения по-прежнему всегда блокируются при публикации."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se mildare språk exakt som det skrevs. Starkt språk blockeras fortfarande alltid vid publicering."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ดูภาษาที่รุนแรงน้อยกว่าตามที่เขียนไว้จริง ภาษารุนแรงยังคงถูกบล็อกเสมอเมื่อโพสต์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daha hafif ifadeleri tam olarak yazıldığı gibi görün. Güçlü ifadeler yine de paylaşırken her zaman engellenir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переглядайте м'якіші слова саме так, як їх написано. Різкі вирази й надалі завжди блокуються під час публікації."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xem ngôn từ nhẹ hơn chính xác như đã viết. Ngôn từ mạnh vẫn luôn bị chặn khi đăng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "较温和的用语会完全按原样显示。强烈用语在发布时仍会始终被屏蔽。"
          }
        }
      }
    },

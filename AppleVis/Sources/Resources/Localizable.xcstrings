    "We need your name and email address so we can reply to you." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نحتاج إلى اسمك وعنوان بريدك الإلكتروني حتى نتمكن من الرد عليك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir benötigen deinen Namen und deine E-Mail-Adresse, um dir antworten zu können."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χρειαζόμαστε το όνομά σας και τη διεύθυνση email σας για να μπορέσουμε να σας απαντήσουμε."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Necesitamos tu nombre y dirección de correo electrónico para poder responderte."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای اینکه بتوانیم به شما پاسخ دهیم، به نام و نشانی ایمیل شما نیاز داریم."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous avons besoin de votre nom et de votre adresse e-mail pour pouvoir vous répondre."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אנחנו זקוקים לשם שלך ולכתובת האימייל כדי שנוכל להשיב לך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपको उत्तर देने के लिए हमें आपका नाम और ईमेल पता चाहिए।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kami memerlukan nama dan alamat email Anda agar kami dapat membalas Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abbiamo bisogno del tuo nome e indirizzo email per poterti rispondere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "返信するために、お名前とメールアドレスが必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "답변을 드리기 위해 이름과 이메일 주소가 필요합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We hebben je naam en e-mailadres nodig om je te kunnen antwoorden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potrzebujemy Twojego imienia i adresu e-mail, abyśmy mogli Ci odpowiedzieć."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Precisamos do seu nome e endereço de e-mail para podermos responder a você."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нам нужны ваше имя и адрес электронной почты, чтобы мы могли вам ответить."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi behöver ditt namn och din e-postadress för att kunna svara dig."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เราต้องการชื่อและที่อยู่อีเมลของคุณเพื่อให้เราสามารถตอบกลับคุณได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Size yanıt verebilmemiz için adınıza ve e-posta adresinize ihtiyacımız var."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нам потрібні ваше ім'я та адреса електронної пошти, щоб ми могли вам відповісти."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chúng tôi cần tên và địa chỉ email của bạn để có thể phản hồi bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我们需要您的姓名和电子邮件地址以便回复您。"
          }
        }
      }
    },
    "We only use your email to reply to this message and will not add you to any mailing list." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نستخدم بريدك الإلكتروني فقط للرد على هذه الرسالة ولن نضيفك إلى أي قائمة بريدية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir verwenden deine E-Mail-Adresse nur, um auf diese Nachricht zu antworten, und fügen dich keiner Mailingliste hinzu."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χρησιμοποιούμε το email σας μόνο για να απαντήσουμε σε αυτό το μήνυμα και δεν θα σας προσθέσουμε σε καμία λίστα αλληλογραφίας."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo usamos tu correo electrónico para responder a este mensaje y no te añadiremos a ninguna lista de correo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ما فقط از ایمیل شما برای پاسخ به این پیام استفاده می‌کنیم و شما را به هیچ فهرست پستی اضافه نخواهیم کرد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous n'utilisons votre e-mail que pour répondre à ce message et ne vous ajouterons à aucune liste de diffusion."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אנו משתמשים באימייל שלך רק כדי להשיב להודעה זו ולא נוסיף אותך לאף רשימת תפוצה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हम केवल इस संदेश का उत्तर देने के लिए आपके ईमेल का उपयोग करते हैं और आपको किसी मेलिंग सूची में नहीं जोड़ेंगे।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kami hanya menggunakan email Anda untuk membalas pesan ini dan tidak akan menambahkan Anda ke daftar surat apa pun."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usiamo la tua email solo per rispondere a questo messaggio e non ti aggiungeremo a nessuna mailing list."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メールアドレスはこのメッセージへの返信にのみ使用され、メーリングリストに追加されることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이메일은 이 메시지에 대한 답변에만 사용되며 어떤 메일링 리스트에도 추가되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We gebruiken je e-mail alleen om op dit bericht te reageren en voegen je niet toe aan een mailinglijst."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Używamy Twojego e-maila wyłącznie do odpowiedzi na tę wiadomość i nie dodamy Cię do żadnej listy mailingowej."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usamos seu e-mail apenas para responder a esta mensagem e não adicionaremos você a nenhuma lista de e-mails."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мы используем ваш email только для ответа на это сообщение и не добавим вас в какой-либо список рассылки."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi använder endast din e-post för att svara på detta meddelande och kommer inte att lägga till dig i någon e-postlista."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เราใช้อีเมลของคุณเพื่อตอบกลับข้อความนี้เท่านั้น และจะไม่เพิ่มคุณลงในรายชื่ออีเมลใดๆ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E-postanızı yalnızca bu mesaja yanıt vermek için kullanıyoruz ve sizi hiçbir posta listesine eklemeyeceğiz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ми використовуємо вашу електронну пошту лише для відповіді на це повідомлення й не додамо вас до жодного списку розсилки."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chúng tôi chỉ sử dụng email của bạn để phản hồi tin nhắn này và sẽ không thêm bạn vào bất kỳ danh sách gửi thư nào."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我们仅使用您的电子邮件回复此消息，不会将您添加到任何邮件列表中。"
          }
        }
      }

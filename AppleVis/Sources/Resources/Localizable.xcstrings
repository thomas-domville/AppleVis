            "state" : "translated",
            "value" : "Προσαρμόζει την ισορροπία συχνοτήτων του ήχου."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajusta el equilibrio de frecuencias del audio."
          }

            "value" : "پردازشی اعمال می‌کند تا صداها واضح‌تر و برجسته‌تر شوند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applique un traitement pour rendre les voix plus claires et plus présentes."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מיישם עיבוד כדי להפוך את הקולות לברורים ובולטים יותר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आवाज़ों को स्पष्ट और अधिक प्रमुख बनाने के लिए प्रोसेसिंग लागू करता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menerapkan pemrosesan untuk membuat suara lebih jelas dan menonjol."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applica un'elaborazione per rendere le voci più chiare e prominenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "処理を適用して、声をより明瞭で際立たせます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "음성을 더 명확하고 두드러지게 처리합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Past verwerking toe om stemmen duidelijker en prominenter te maken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stosuje przetwarzanie, aby głosy były wyraźniejsze i bardziej wyeksponowane."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplica processamento para tornar as vozes mais claras e proeminentes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Применяет обработку, делающую голоса более чёткими и выделяющимися."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillämpar bearbetning för att göra röster tydligare och mer framträdande."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้การประมวลผลเพื่อทำให้เสียงพูดชัดเจนและโดดเด่นขึ้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesleri daha net ve belirgin hale getirmek için işleme uygular."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Застосовує обробку, щоб зробити голоси чіткішими та виразнішими."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Áp dụng xử lý để làm cho giọng nói rõ ràng và nổi bật hơn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "应用处理，使人声更清晰、更突出。"
          }
        }
      }
    },

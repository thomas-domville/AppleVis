    "What's this about?" : {
      "comment" : "The label for the subject line of a contact message.",
      "extractionState" : "manual",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عمّ يدور هذا؟"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Worum geht es?"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Για τι πρόκειται;"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿De qué se trata?"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این دربارهٔ چیست؟"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De quoi s'agit-il ?"
          }
        },
        "he" : {
          "stringUnit" : {

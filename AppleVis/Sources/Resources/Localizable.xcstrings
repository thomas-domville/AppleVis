    "Speeds up playback by shortening quiet pauses between words." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يسرّع التشغيل عن طريق تقصير فترات التوقف الصامتة بين الكلمات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beschleunigt die Wiedergabe, indem stille Pausen zwischen Wörtern verkürzt werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιταχύνει την αναπαραγωγή συντομεύοντας τις σιωπηλές παύσεις μεταξύ λέξεων."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acelera la reproducción acortando las pausas silenciosas entre palabras."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "با کوتاه کردن مکث‌های ساکت بین کلمات پخش را سریع‌تر می‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accélère la lecture en raccourcissant les silences entre les mots."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מאיץ את ההשמעה על ידי קיצור ההפסקות השקטות בין מילים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "शब्दों के बीच शांत विराम को छोटा करके प्लेबैक को तेज़ करता है।"

        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पिछला चलाया गया एपिसोड वहीं से शुरू करता है जहां आपने छोड़ा था।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melanjutkan episode terakhir yang diputar dari posisi terakhir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riprende l'ultimo episodio ascoltato da dove avevi lasciato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最後に再生したエピソードを中断したところから再開します。"

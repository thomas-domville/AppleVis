        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mientras escribes una publicación, respuesta o comentario, ofrece traducir tu borrador si parece que no está en inglés."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هنگام نوشتن پست، پاسخ یا دیدگاه، اگر به نظر برسد پیش‌نویس شما انگلیسی نیست، پیشنهاد ترجمهٔ آن را می‌دهد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pendant que vous rédigez une publication, une réponse ou un commentaire, propose de traduire votre brouillon s'il semble ne pas être en anglais."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בזמן שאתה כותב פוסט, תגובה או הערה, מציע לתרגם את הטיוטה שלך אם היא נראית שאינה באנגלית."

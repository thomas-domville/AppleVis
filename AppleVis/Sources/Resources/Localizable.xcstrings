    "Nothing matched your search. Check the spelling, use fewer words, or search for a broader topic." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا شيء يطابق بحثك. تحقق من الإملاء أو استخدم كلمات أقل أو ابحث عن موضوع أعم."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nichts passt zu deiner Suche. Prüfe die Schreibweise, verwende weniger Wörter oder suche nach einem allgemeineren Thema."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τίποτα δεν ταιριάζει με την αναζήτησή σας. Ελέγξτε την ορθογραφία, χρησιμοποιήστε λιγότερες λέξεις ή αναζητήστε ένα γενικότερο θέμα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada coincide con tu búsqueda. Revisa la ortografía, usa menos palabras o busca un tema más general."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هیچ نتیجه‌ای با جست‌وجوی شما مطابقت ندارد. املا را بررسی کنید، از کلمات کمتری استفاده کنید یا موضوع کلی‌تری را جست‌وجو کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun résultat pour votre recherche. Vérifiez l'orthographe, utilisez moins de mots ou cherchez un sujet plus large."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שום דבר לא תאם לחיפוש. בדוק את האיות, השתמש בפחות מילים או חפש נושא רחב יותר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी खोज से कुछ मेल नहीं खाया। वर्तनी जांचें, कम शब्द इस्तेमाल करें या किसी व्यापक विषय को खोजें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak ada yang cocok dengan pencarian Anda. Periksa ejaan, gunakan lebih sedikit kata, atau cari topik yang lebih luas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun risultato per la tua ricerca. Controlla l'ortografia, usa meno parole o cerca un argomento più ampio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "検索に一致するものはありません。スペルを確認するか、単語を減らすか、より広いトピックで検索してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "검색과 일치하는 항목이 없습니다. 철자를 확인하거나, 단어를 줄이거나, 더 넓은 주제로 검색해 보세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niets komt overeen met je zoekopdracht. Controleer de spelling, gebruik minder woorden of zoek op een breder onderwerp."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nic nie pasuje do wyszukiwania. Sprawdź pisownię, użyj mniejszej liczby słów lub wyszukaj szerszy temat."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada corresponde à sua busca. Verifique a ortografia, use menos palavras ou busque um tema mais amplo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "По вашему запросу ничего не найдено. Проверьте написание, используйте меньше слов или поищите более общую тему."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inget matchade din sökning. Kontrollera stavningen, använd färre ord eller sök efter ett bredare ämne."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่มีรายการที่ตรงกับการค้นหาของคุณ ตรวจสอบการสะกด ใช้คำให้น้อยลง หรือค้นหาหัวข้อที่กว้างขึ้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aramanızla eşleşen bir şey bulunamadı. Yazımı kontrol edin, daha az kelime kullanın veya daha genel bir konu arayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "За вашим запитом нічого не знайдено. Перевірте написання, використайте менше слів або пошукайте ширшу тему."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không có kết quả nào khớp với tìm kiếm. Hãy kiểm tra chính tả, dùng ít từ hơn hoặc tìm chủ đề rộng hơn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有与搜索匹配的内容。请检查拼写、减少字词，或搜索更宽泛的话题。"
          }
        }
      }

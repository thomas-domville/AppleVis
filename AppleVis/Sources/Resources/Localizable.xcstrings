        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "משמיע צליל לרגעים ראויים לציון — שמירה, סיום הורדות, התראות והשמעה/השהיה של פודקאסט."
          }
        },
        "hi" : {
          "stringUnit" : {

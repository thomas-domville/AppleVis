    "Data synced via iCloud uses Apple's end-to-end encryption. AppleVis cannot read it." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تستخدم البيانات المتزامنة عبر iCloud التشفير من طرف إلى طرف من Apple. لا يستطيع AppleVis قراءتها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Über iCloud synchronisierte Daten nutzen die Ende-zu-Ende-Verschlüsselung von Apple. AppleVis kann sie nicht lesen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα δεδομένα που συγχρονίζονται μέσω iCloud χρησιμοποιούν τη διατερματική κρυπτογράφηση της Apple. Το AppleVis δεν μπορεί να τα διαβάσει."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los datos sincronizados con iCloud usan el cifrado de extremo a extremo de Apple. AppleVis no puede leerlos."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "داده‌هایی که از طریق iCloud همگام می‌شوند از رمزگذاری سرتاسری Apple استفاده می‌کنند. AppleVis نمی‌تواند آن‌ها را بخواند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les données synchronisées via iCloud utilisent le chiffrement de bout en bout d'Apple. AppleVis ne peut pas les lire."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מידע שמסונכרן דרך iCloud משתמש בהצפנה מקצה לקצה של Apple. AppleVis לא יכול לקרוא אותו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud से सिंक होने वाला डेटा Apple के एंड-टू-एंड एन्क्रिप्शन का उपयोग करता है। AppleVis उसे नहीं पढ़ सकता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Data yang disinkronkan melalui iCloud menggunakan enkripsi end-to-end Apple. AppleVis tidak dapat membacanya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I dati sincronizzati tramite iCloud usano la crittografia end-to-end di Apple. AppleVis non può leggerli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud で同期されるデータには Apple のエンドツーエンド暗号化が使われます。AppleVis はそのデータを読めません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud로 동기화되는 데이터는 Apple의 종단 간 암호화를 사용합니다. AppleVis는 이를 읽을 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gegevens die via iCloud worden gesynchroniseerd, gebruiken de end-to-end-versleuteling van Apple. AppleVis kan ze niet lezen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dane synchronizowane przez iCloud korzystają z szyfrowania end-to-end Apple. AppleVis nie może ich odczytać."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os dados sincronizados pelo iCloud usam a criptografia de ponta a ponta da Apple. O AppleVis não consegue lê-los."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Данные, синхронизируемые через iCloud, защищены сквозным шифрованием Apple. AppleVis не может их прочитать."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Data som synkas via iCloud använder Apples totalsträckskryptering. AppleVis kan inte läsa den."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ข้อมูลที่ซิงค์ผ่าน iCloud ใช้การเข้ารหัสตั้งแต่ต้นทางถึงปลายทางของ Apple AppleVis อ่านข้อมูลนี้ไม่ได้"

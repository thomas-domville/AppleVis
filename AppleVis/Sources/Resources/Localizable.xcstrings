        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "समस्या ढूँढने में हमारी मदद के लिए आपका ऐप संस्करण, डिवाइस और VoiceOver जैसी सुलभता सेटिंग्स जोड़ता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menambahkan versi aplikasi, perangkat, dan pengaturan aksesibilitas, seperti VoiceOver, untuk membantu kami menemukan masalahnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiunge la versione dell'app, il dispositivo e le impostazioni di accessibilità, come VoiceOver, per aiutarci a trovare il problema."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "問題の特定に役立つよう、アプリのバージョン、デバイス、VoiceOver などのアクセシビリティ設定を追加します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "문제를 찾는 데 도움이 되도록 앱 버전, 기기, VoiceOver 같은 손쉬운 사용 설정을 추가합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voegt je appversie, apparaat en toegankelijkheidsinstellingen zoals VoiceOver toe, zodat we het probleem kunnen vinden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaje wersję aplikacji, urządzenie i ustawienia dostępności, takie jak VoiceOver, aby pomóc nam znaleźć problem."

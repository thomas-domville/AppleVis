        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "در موضوعات انجمن، برنامه‌ها و منابع جستجو کنید. نتایج هنگام تایپ نمایش داده می‌شوند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",

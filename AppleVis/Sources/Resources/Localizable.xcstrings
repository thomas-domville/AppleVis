          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מציג טיפים קצרים תלויי הקשר ותזכורות ידידותיות היכן שהם יכולים לחסוך זמן."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जहां वे समय बचा सकते हैं वहां छोटे प्रासंगिक टिप्स और मैत्रीपूर्ण रिमाइंडर दिखाता है。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",

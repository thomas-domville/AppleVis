    "Manage downloads, cached content, and retention policy." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إدارة التنزيلات والمحتوى المخزّن مؤقتاً وسياسة الاحتفاظ."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Downloads, gecachte Inhalte und Aufbewahrungsrichtlinie verwalten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Διαχειριστείτε λήψεις, αποθηκευμένο περιεχόμενο και πολιτική αποθήκευσης."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manage downloads, cached content, and retention policy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gestiona descargas, contenido en caché y política de retención."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مدیریت دانلودها، محتوای ذخیره‌شده در حافظه پنهان و سیاست نگهداری."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gérez les téléchargements, le contenu mis en cache et la politique de conservation."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "נהל הורדות, תוכן במטמון ומדיניות אחסון."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डाउनलोड, कैश की गई सामग्री और रिटेंशन नीति प्रबंधित करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",

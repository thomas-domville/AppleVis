        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tytuł i opis każdego kroku wdrożenia oraz każdy wpis w Nowości — dla tego wydania i całej historii — wyświetlały się po angielsku niezależnie od ustawionego języka aplikacji. Oba naprawione, a ciągi wdrożenia, które od początku nie były przetłumaczalne, są teraz przetłumaczone na wszystkie 22 obsługiwane języki."
          }
        },
        "pt" : {
          "stringUnit" : {

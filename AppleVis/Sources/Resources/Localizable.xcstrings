    "Replays the guided tour of Home, Discover, For You, and Profile & Settings." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعيد تشغيل الجولة الإرشادية للرئيسية، واستكشف، ولك، والملف الشخصي والإعدادات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Startet den geführten Rundgang durch Home, Entdecken, Für dich und Profil & Einstellungen erneut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επαναλαμβάνει την καθοδηγούμενη περιήγηση στην Αρχική, το Ανακαλύψτε, το Για Εσάς, και το Προφίλ & Ρυθμίσεις."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repite el recorrido guiado por Inicio, Descubrir, Para ti, y Perfil y ajustes."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تور راهنمای صفحهٔ اصلی، کاوش، برای شما، و نمایه و تنظیمات را دوباره پخش می‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relance la visite guidée d'Accueil, Découvrir, Pour vous, et Profil et réglages."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מפעיל שוב את הסיור המודרך בבית, גלה, בשבילך, ופרופיל והגדרות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "होम, डिस्कवर, फ़ॉर यू, और प्रोफ़ाइल और सेटिंग्स के निर्देशित टूर को फिर से चलाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memutar ulang tur berpandu Beranda, Jelajahi, For You, dan Profil & Pengaturan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riavvia il tour guidato di Home, Scopri, Per te, e Profilo e impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Home、Discover、For You、プロフィールと設定のガイド付きツアーをもう一度実行します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",

    "Topics you are following. Saved locally and synced via iCloud.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Topics you are following. Saved locally and synced via iCloud."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Temas que sigues. Guardados localmente y sincronizados con iCloud."
          }

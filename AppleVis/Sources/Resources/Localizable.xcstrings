        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gönderinizde art arda birkaç ünlem veya soru işareti var. Daha az kullanmak mesajınızın daha sakin görünmesini sağlar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У вашому дописі кілька знаків оклику чи запитання поспіль. Якщо їх буде менше, повідомлення звучатиме спокійніше."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bài đăng của bạn có nhiều dấu chấm than hoặc chấm hỏi liên tiếp. Dùng ít hơn sẽ giúp tin nhắn nghe bình tĩnh hơn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",

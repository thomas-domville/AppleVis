        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это меняет только то, что вы читаете: AppleVis по-прежнему ведётся и модерируется на английском, и публиковать, как всегда, нужно на английском."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",

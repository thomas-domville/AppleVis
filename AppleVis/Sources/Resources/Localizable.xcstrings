        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι σύνδεσμοι μέσα σε αναρτήσεις και σχόλια προς άλλες σελίδες του AppleVis — θέμα φόρουμ, καταχώριση εφαρμογής, οδηγό, ανάρτηση ιστολογίου, επεισόδιο podcast ή αναφορά σφάλματος — ανοίγουν απευθείας στην εφαρμογή αντί σε πρόγραμμα περιήγησης."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los enlaces de publicaciones y comentarios a otras páginas de AppleVis (un tema del foro, una entrada de app, una guía, una entrada de blog, un episodio de pódcast o un informe de error) se abren directamente en la app en lugar de en un navegador."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پیوندهای درون پست‌ها و نظرها به صفحه‌های دیگر AppleVis — موضوع انجمن، ورودی برنامه، راهنما، پست وبلاگ، قسمت پادکست یا گزارش اشکال — به‌جای مرورگر، مستقیماً در برنامه باز می‌شوند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les liens des publications et commentaires vers d'autres pages d'AppleVis — sujet du forum, fiche d'appli, guide, article de blog, épisode de podcast ou rapport de bug — s'ouvrent directement dans l'app plutôt que dans un navigateur."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "קישורים בפוסטים ובתגובות לדפים אחרים ב-AppleVis — נושא בפורום, רשומת אפליקציה, מדריך, פוסט בבלוג, פרק פודקאסט או דיווח באג — נפתחים ישירות באפליקציה במקום בדפדפן."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पोस्ट और टिप्पणियों में AppleVis के दूसरे पेजों के लिंक — कोई फ़ोरम विषय, ऐप प्रविष्टि, गाइड, ब्लॉग पोस्ट, पॉडकास्ट एपिसोड या बग रिपोर्ट — ब्राउज़र के बजाय सीधे ऐप में खुलते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tautan di postingan dan komentar ke halaman AppleVis lain — topik forum, entri aplikasi, panduan, postingan blog, episode podcast, atau laporan bug — langsung terbuka di aplikasi, bukan di browser."
          }

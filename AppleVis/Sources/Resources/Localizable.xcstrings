    "Limits the Home feed to topics directly related to Apple products and platforms." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقصر تغذية الشاشة الرئيسية على المواضيع المرتبطة مباشرةً بمنتجات ومنصات Apple."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beschränkt den Home-Feed auf Themen, die direkt mit Apple-Produkten und -Plattformen zusammenhängen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Περιορίζει τη ροή Αρχικής σε θέματα άμεσα σχετιζόμενα με προϊόντα και πλατφόρμες Apple."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limita el feed de Inicio a temas directamente relacionados con los productos y plataformas de Apple."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فید صفحهٔ اصلی را به موضوعات مستقیماً مرتبط با محصولات و پلتفرم‌های اپل محدود می‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limite le fil Accueil aux sujets directement liés aux produits et plateformes Apple."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מגביל את פיד הבית לנושאים הקשורים ישירות למוצרים ולפלטפורמות של Apple."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "होम फ़ीड को केवल Apple उत्पादों और प्लेटफ़ॉर्म से सीधे संबंधित विषयों तक सीमित करता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Membatasi umpan Beranda ke topik yang secara langsung terkait dengan produk dan platform Apple."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limita il feed Home agli argomenti direttamente correlati ai prodotti e alle piattaforme Apple."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「ホーム」フィードを Apple 製品やプラットフォームに直接関連するトピックのみに制限します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "홈 피드를 Apple 제품 및 플랫폼과 직접 관련된 주제로 제한합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beperkt de Start-feed tot onderwerpen die direct verband houden met Apple-producten en -platforms."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogranicza kanał Strona główna do wątków bezpośrednio związanych z produktami i platformami Apple."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limita o feed Início a tópicos diretamente relacionados a produtos e plataformas Apple."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ограничивает ленту «Главная» темами, непосредственно связанными с продуктами и платформами Apple."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begränsar Hem-flödet till ämnen som är direkt relaterade till Apples produkter och plattformar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จำกัดฟีดหน้าแรกให้เฉพาะหัวข้อที่เกี่ยวข้องโดยตรงกับผลิตภัณฑ์และแพลตฟอร์มของ Apple"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ana Sayfa akışını doğrudan Apple ürünleri ve platformlarıyla ilgili konularla sınırlar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обмежує стрічку «Головна» темами, безпосередньо пов'язаними з продуктами та платформами Apple."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giới hạn nguồn cấp dữ liệu Trang chủ ở các chủ đề liên quan trực tiếp đến sản phẩm và nền tảng Apple."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将“主页”动态限制为与 Apple 产品和平台直接相关的话题。"
          }
        }
      }
    },

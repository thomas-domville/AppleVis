        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перемикачі, які можна гортати, озвучують ваш вибір"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bộ chọn có thể vuốt sẽ thông báo lựa chọn của bạn"

    "Counts keep adding up across visits until you open the item or mark it as read." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تستمر الأعداد في التراكم عبر الزيارات حتى تفتح العنصر أو تضع عليه علامة كمقروء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Zahlen summieren sich über mehrere Besuche, bis du das Element öffnest oder als gelesen markierst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι αριθμοί συνεχίζουν να αυξάνονται από επίσκεψη σε επίσκεψη μέχρι να ανοίξετε το στοιχείο ή να το σημειώσετε ως αναγνωσμένο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los números se siguen acumulando entre visitas hasta que abras el elemento o lo marques como leído."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شمارش‌ها در بازدیدهای مختلف روی هم جمع می‌شوند تا زمانی که آن مورد را باز کنید یا به عنوان خوانده‌شده علامت بزنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les nombres continuent de s'additionner d'une visite à l'autre jusqu'à ce que vous ouvriez l'élément ou le marquiez comme lu."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "המספרים ממשיכים להצטבר מביקור לביקור עד שתפתח את הפריט או תסמן אותו כנקרא."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आइटम खोलने या उसे पढ़ा हुआ चिह्नित करने तक गिनती हर विज़िट में जुड़ती रहती है।"

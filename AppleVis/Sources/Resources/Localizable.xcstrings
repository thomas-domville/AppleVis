        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleVis hesabınız için e-posta adresinizi ve kullanıcı adınızı, bildirimler için de cihazınızın anlık bildirim belirtecini toplar."

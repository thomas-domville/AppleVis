    "Share your podcast about accessibility, Apple products, or blindness with the AppleVis community." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شارك بودكاست خاص بك حول إمكانية الوصول أو منتجات Apple أو فقدان البصر مع مجتمع AppleVis."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teile deinen Podcast über Barrierefreiheit, Apple-Produkte oder Blindheit mit der AppleVis-Community."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μοιραστείτε το podcast σας για την προσβασιμότητα, τα προϊόντα Apple ή την τύφλωση με την κοινότητα του AppleVis."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comparte tu pódcast sobre accesibilidad, productos Apple o ceguera con la comunidad de AppleVis."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پادکست خود دربارهٔ دسترس‌پذیری، محصولات اپل یا نابینایی را با جامعهٔ AppleVis به اشتراک بگذارید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partagez votre podcast sur l'accessibilité, les produits Apple ou la cécité avec la communauté AppleVis."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שתף את הפודקאסט שלך על נגישות, מוצרי Apple או עיוורון עם קהילת AppleVis."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सुलभता, Apple उत्पादों, या दृष्टिबाधिता के बारे में अपना पॉडकास्ट AppleVis समुदाय के साथ साझा करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bagikan podcast Anda tentang aksesibilitas, produk Apple, atau kebutaan dengan komunitas AppleVis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Condividi il tuo podcast su accessibilità, prodotti Apple o cecità con la comunità di AppleVis."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アクセシビリティ、Apple 製品、視覚障がいに関するポッドキャストを AppleVis コミュニティと共有しましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "접근성, Apple 제품, 또는 시각장애에 관한 팟캐스트를 AppleVis 커뮤니티와 공유하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deel je podcast over toegankelijkheid, Apple-producten of blindheid met de AppleVis-community."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podziel się swoim podcastem o dostępności, produktach Apple lub niewidomych ze społecznością AppleVis."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compartilhe seu podcast sobre acessibilidade, produtos Apple ou cegueira com a comunidade AppleVis."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поделитесь своим подкастом об специальных возможностях, продуктах Apple или незрячих людях с сообществом AppleVis."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dela din podd om tillgänglighet, Apple-produkter eller blindhet med AppleVis-gemenskapen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แชร์พอดแคสต์ของคุณเกี่ยวกับการช่วยการเข้าถึง ผลิตภัณฑ์ Apple หรือการตาบอดกับชุมชน AppleVis"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erişilebilirlik, Apple ürünleri veya görme engellilikle ilgili podcast'inizi AppleVis topluluğuyla paylaşın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поділіться своїм подкастом про доступність, продукти Apple чи незрячість зі спільнотою AppleVis."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chia sẻ podcast của bạn về trợ năng, sản phẩm Apple hoặc mù lòa với cộng đồng AppleVis."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "与 AppleVis 社区分享您关于无障碍、Apple 产品或失明相关话题的播客。"
          }
        }
      }
    },

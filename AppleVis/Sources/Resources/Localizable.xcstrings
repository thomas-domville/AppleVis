    "Resumes the last-played AppleVis podcast episode from where you left off." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستأنف آخر حلقة من بودكاست AppleVis تم تشغيلها من حيث توقفت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setzt die zuletzt abgespielte AppleVis-Podcast-Folge dort fort, wo du aufgehört hast."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Συνεχίζει το τελευταίο αναπαραγμένο επεισόδιο podcast AppleVis από το σημείο όπου σταματήσατε."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reanuda el último episodio de pódcast de AppleVis reproducido desde donde lo dejaste."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آخرین قسمت پادکست AppleVis پخش‌شده را از جایی که متوقف کرده‌اید از سر می‌گیرد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reprend le dernier épisode de podcast AppleVis lu à l'endroit où vous vous étiez arrêté."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מחדש את פרק הפודקאסט האחרון של AppleVis שהושמע מהמקום שבו הפסקת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके द्वारा छोड़े गए स्थान से अंतिम बार चलाया गया AppleVis पॉडकास्ट एपिसोड फिर से शुरू करता है。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melanjutkan episode podcast AppleVis yang terakhir diputar dari tempat Anda berhenti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riprende l'ultimo episodio del podcast AppleVis riprodotto dal punto in cui l'hai interrotto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最後に再生した AppleVis のポッドキャストエピソードを、中断した箇所から再開します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마지막으로 재생한 AppleVis 팟캐스트 에피소드를 멈춘 부분부터 재개합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",

    "For maximum readability, choose Dark or Light themes with your preferred iOS contrast settings." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "للحصول على أقصى قابلية للقراءة، اختر السمة الداكنة أو الفاتحة مع إعدادات التباين المفضلة لديك في iOS."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für maximale Lesbarkeit wähle die Themen „Dunkel“ oder „Hell“ zusammen mit deinen bevorzugten iOS-Kontrasteinstellungen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Για μέγιστη αναγνωσιμότητα, επιλέξτε Σκούρο ή Ανοιχτόχρωμο θέμα με τις προτιμώμενες ρυθμίσεις αντίθεσης iOS."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para la máxima legibilidad, elige los temas Oscuro o Claro con tu configuración de contraste preferida de iOS."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای بیشترین خوانایی، پوستهٔ تیره یا روشن را همراه با تنظیمات کنتراست دلخواه iOS انتخاب کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour une lisibilité maximale, choisissez les thèmes Sombre ou Clair avec vos réglages de contraste iOS préférés."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לקריאות מרבית, בחר בערכות הנושא כהה או בהיר עם הגדרות הניגודיות המועדפות עליך ב-iOS."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अधिकतम पठनीयता के लिए, अपनी पसंदीदा iOS कंट्रास्ट सेटिंग्स के साथ डार्क या लाइट थीम चुनें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk keterbacaan maksimal, pilih tema Gelap atau Terang dengan pengaturan kontras iOS pilihan Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per la massima leggibilità, scegli i temi Scuro o Chiaro con le tue impostazioni di contrasto iOS preferite."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最大限の読みやすさを得るには、お好みの iOS のコントラスト設定と併せて「ダーク」または「ライト」テーマを選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "최대 가독성을 위해 선호하는 iOS 대비 설정과 함께 어둡게 또는 밝게 테마를 선택하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies voor maximale leesbaarheid Donker of Licht met je gewenste iOS-contrastinstellingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dla maksymalnej czytelności wybierz motyw Ciemny lub Jasny wraz z preferowanymi ustawieniami kontrastu iOS."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para máxima legibilidade, escolha os temas Escuro ou Claro com suas configurações de contraste preferidas do iOS."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для максимальной читаемости выберите тёмную или светлую тему в сочетании с предпочтительными настройками контрастности iOS."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "För maximal läsbarhet, välj Mörkt eller Ljust tema med dina föredragna iOS-kontrastinställningar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เพื่อการอ่านที่ชัดเจนที่สุด เลือกธีมเข้มหรือสว่างพร้อมการตั้งค่าคอนทราสต์ iOS ที่คุณต้องการ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maksimum okunabilirlik için tercih ettiğiniz iOS kontrast ayarlarıyla Koyu veya Açık temaları seçin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для максимальної читабельності виберіть темну або світлу тему з бажаними налаштуваннями контрастності iOS."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Để dễ đọc tối đa, hãy chọn giao diện Tối hoặc Sáng cùng cài đặt độ tương phản iOS ưa thích của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为获得最佳可读性，请选择“深色”或“浅色”主题，并配合您偏好的 iOS 对比度设置。"
          }
        }
      }
    },

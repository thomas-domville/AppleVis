          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entrez instantanément en contact avec un bénévole voyant par vidéo en direct, 24 h/24 et 7 j/7, dans 185 langues."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",

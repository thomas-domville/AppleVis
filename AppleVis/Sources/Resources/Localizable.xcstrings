    "Apple Intelligence is available on iPhone 15 Pro and later, and all iPhone 16 models, running iOS 18.1 or later." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتوفر Apple Intelligence على iPhone 15 Pro وما بعده، وجميع طرازات iPhone 16، بنظام iOS 18.1 أو أحدث."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence ist auf dem iPhone 15 Pro und neuer sowie allen iPhone 16-Modellen mit iOS 18.1 oder neuer verfügbar."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Apple Intelligence είναι διαθέσιμο σε iPhone 15 Pro και μεταγενέστερα, και σε όλα τα μοντέλα iPhone 16, με iOS 18.1 ή νεότερο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence está disponible en iPhone 15 Pro y modelos posteriores, y en todos los modelos de iPhone 16, con iOS 18.1 o posterior."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence روی iPhone 15 Pro و مدل‌های بعدی و همهٔ مدل‌های iPhone 16 با iOS 18.1 یا نسخه‌های جدیدتر در دسترس است."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence est disponible sur iPhone 15 Pro et modèles ultérieurs, ainsi que sur tous les modèles iPhone 16, avec iOS 18.1 ou version ultérieure."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence זמין ב-iPhone 15 Pro ואילך, ובכל דגמי ה-iPhone 16, עם iOS 18.1 ואילך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence iPhone 15 Pro और बाद के मॉडलों तथा सभी iPhone 16 मॉडलों पर उपलब्ध है, जिनमें iOS 18.1 या बाद का संस्करण चल रहा हो।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence tersedia di iPhone 15 Pro ke atas, dan semua model iPhone 16, yang menjalankan iOS 18.1 atau lebih baru."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence è disponibile su iPhone 15 Pro e modelli successivi e su tutti i modelli iPhone 16, con iOS 18.1 o successivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence は、iOS 18.1 以降を搭載した iPhone 15 Pro 以降およびすべての iPhone 16 モデルで利用できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence는 iOS 18.1 이상을 실행하는 iPhone 15 Pro 이상 및 모든 iPhone 16 모델에서 사용할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence is beschikbaar op iPhone 15 Pro en later, en alle iPhone 16-modellen, met iOS 18.1 of later."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence jest dostępne na iPhone 15 Pro i nowszych oraz wszystkich modelach iPhone 16 z systemem iOS 18.1 lub nowszym."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Apple Intelligence está disponível no iPhone 15 Pro e modelos posteriores, e em todos os modelos do iPhone 16, com iOS 18.1 ou posterior."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence доступен на iPhone 15 Pro и более новых моделях, а также на всех моделях iPhone 16 с iOS 18.1 или новее."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence är tillgängligt på iPhone 15 Pro och senare samt alla iPhone 16-modeller med iOS 18.1 eller senare."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence ใช้ได้บน iPhone 15 Pro ขึ้นไป และ iPhone 16 ทุกรุ่น ที่ใช้ iOS 18.1 ขึ้นไป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence, iOS 18.1 veya sonrasını çalıştıran iPhone 15 Pro ve sonrası ile tüm iPhone 16 modellerinde kullanılabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence доступний на iPhone 15 Pro та новіших моделях, а також усіх моделях iPhone 16 з iOS 18.1 або новішою версією."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence khả dụng trên iPhone 15 Pro trở lên và tất cả các mẫu iPhone 16 chạy iOS 18.1 trở lên."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence 适用于 iPhone 15 Pro 及更新机型，以及所有 iPhone 16 机型，且需运行 iOS 18.1 或更高版本。"
          }
        }
      }
    },
    "Apple Intelligence tip: select any text you type to proofread, rewrite, shorten, or translate it using Writing Tools." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تلميح Apple Intelligence: حدد أي نص لمراجعته أو إعادة كتابته أو ترجمته باستخدام Writing Tools."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence-Tipp: Markiere Text zum Korrigieren, Umschreiben oder Übersetzen mit Writing Tools."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Συμβουλή Apple Intelligence: επιλέξτε οποιοδήποτε πληκτρολογημένο κείμενο για να το ελέγξετε, να το ξαναγράψετε, να το συντομεύσετε ή να το μεταφράσετε με τα Writing Tools."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence tip: select any text you type to proofread, rewrite, shorten, or translate it using Writing Tools."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consejo de Apple Intelligence: selecciona cualquier texto para corregirlo, reescribirlo o traducirlo con Writing Tools."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نکته Apple Intelligence: هر متنی را انتخاب کنید تا با Writing Tools ویرایش، بازنویسی یا ترجمه شود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conseil Apple Intelligence : sélectionnez du texte pour le corriger, réécrire ou traduire avec Writing Tools."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "טיפ Apple Intelligence: בחר כל טקסט שהוקלד כדי לבדוק, לשכתב, לקצר או לתרגם אותו עם Writing Tools."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence सुझाव: कोई भी टेक्स्ट चुनें और Writing Tools से प्रूफरीड, फिर से लिखें या अनुवाद करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tip Apple Intelligence: pilih teks yang diketik untuk memeriksa, menulis ulang, mempersingkat, atau menerjemahkannya dengan Writing Tools."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suggerimento Apple Intelligence: seleziona testo per correggerlo, riscriverlo o tradurlo con Writing Tools."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligenceのヒント：テキストを選択してWriting Toolsで校正、書き直し、翻訳できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence 팁: 텍스트를 선택해 Writing Tools로 교정, 재작성, 번역할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence-tip: selecteer tekst om te corrigeren, herschrijven of vertalen met Writing Tools."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wskazówka Apple Intelligence: wybierz dowolny wpisany tekst, aby sprawdzić, przepisać, skrócić lub przetłumaczyć go za pomocą Writing Tools."
          }

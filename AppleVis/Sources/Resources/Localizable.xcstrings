        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προσαρτά αυτόματα την έκδοση της εφαρμογής σας και την έκδοση iOS για να βοηθήσει στη διάγνωση του προβλήματος."

        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บอกเราว่าทำไมโพสต์นี้จึงน่าสนใจสำหรับผู้อ่าน AppleVis เพื่อดำเนินการต่อ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Devam etmek için bu yazının AppleVis okuyucularının neden ilgisini çekeceğini bize anlatın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Розкажіть, чому цей допис зацікавить читачів AppleVis, щоб продовжити."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cho chúng tôi biết tại sao bài viết này sẽ thu hút độc giả AppleVis để tiếp tục."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "告诉我们为什么这篇文章会吸引 AppleVis 读者,以继续。"
          }
        }

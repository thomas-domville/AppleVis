    "AppleVis originally tested version %@. Accessibility may differ in the current App Store version." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختبر AppleVis في الأصل الإصدار %@. قد تختلف إمكانية الوصول في الإصدار الحالي على App Store."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleVis hat ursprünglich Version %@ getestet. Die Barrierefreiheit kann in der aktuellen App-Store-Version abweichen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το AppleVis δοκίμασε αρχικά την έκδοση %@. Η προσβασιμότητα μπορεί να διαφέρει στην τρέχουσα έκδοση του App Store."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleVis probó originalmente la versión %@. La accesibilidad puede ser distinta en la versión actual del App Store."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleVis در ابتدا نسخهٔ %@ را آزمایش کرد. دسترس‌پذیری ممکن است در نسخهٔ فعلی App Store متفاوت باشد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",

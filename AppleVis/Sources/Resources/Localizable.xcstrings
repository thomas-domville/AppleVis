        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleVis ऐप निर्देशिका एक सामुदायिक संसाधन है। ऐप जोड़ने से पहले नीचे दी गई बातें पढ़ें और उनकी पुष्टि करें।"
          }
        },
        "id" : {
          "stringUnit" : {

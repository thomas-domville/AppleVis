        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Links in berichten en reacties naar andere AppleVis-pagina's — een forumonderwerp, app-vermelding, handleiding, blogbericht, podcastaflevering of bugmelding — openen direct in de app in plaats van in een browser."
          }
        },
        "pl" : {

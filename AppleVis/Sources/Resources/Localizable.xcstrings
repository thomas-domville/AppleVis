    "Your AppleVis password has been changed. You'll need it the next time you sign in on another device." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم تغيير كلمة مرور AppleVis. ستحتاج إليها في المرة القادمة التي تسجّل فيها الدخول على جهاز آخر."
          }
        },
        "de" : {
          "stringUnit" : {

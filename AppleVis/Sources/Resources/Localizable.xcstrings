    "For your security, enter your current AppleVis password to continue." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لأمانك، أدخل كلمة مرور AppleVis الحالية للمتابعة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zu deiner Sicherheit gib dein aktuelles AppleVis-Passwort ein, um fortzufahren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Για την ασφάλειά σας, εισαγάγετε τον τρέχοντα κωδικό πρόσβασης AppleVis για να συνεχίσετε."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por tu seguridad, introduce tu contraseña actual de AppleVis para continuar."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای امنیت شما، برای ادامه رمز عبور فعلی AppleVis خود را وارد کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour votre sécurité, saisissez votre mot de passe AppleVis actuel pour continuer."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "למען אבטחתך, הזן את סיסמת ה-AppleVis הנוכחית שלך כדי להמשיך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी सुरक्षा के लिए, जारी रखने हेतु अपना वर्तमान AppleVis पासवर्ड दर्ज करें。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demi keamanan Anda, masukkan kata sandi AppleVis Anda saat ini untuk melanjutkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per la tua sicurezza, inserisci la tua password attuale di AppleVis per continuare."
          }
        },
        "ja" : {

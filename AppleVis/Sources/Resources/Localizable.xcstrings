          }
        }
      }
    },
    "Each one also shows when the bug was first reported and last updated." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ويُظهر كل تقرير أيضًا متى أُبلغ عن الخطأ أول مرة ومتى حُدِّث آخر مرة."
          }
        },
        "de" : {

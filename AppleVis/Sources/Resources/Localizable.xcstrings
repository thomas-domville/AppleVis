    "15 themes, including High Contrast, Mouse, and Midnight. You'll choose one in the next few steps." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "15 مظهرًا، منها التباين العالي وMouse وMidnight. ستختار أحدها في الخطوات التالية."

            "value" : "Настройка сначала фокусируется на приветствии"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konfigureringen fokuserar på Välkommen först"
          }
        },
        "th" : {

          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wymagane. Opowiedz nam trochę o swoim wpisie na blogu i dlaczego uważasz, że będzie ciekawy i wartościowy dla społeczności AppleVis."

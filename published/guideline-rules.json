 "ai": {
  "meanings": {
   "tone": "Respectful discussion. No personal attacks, put-downs, or dismissive remarks aimed at another member. Criticising a product, company, or update, and venting about a bug, are fine.",
   "personal-info": "Privacy. Members shouldn't accidentally expose their own or someone else's personal contact details. An address shared on purpose so people can get in touch, such as a developer's or a tester sign-up address, is fine.",
   "self-promotion": "No self-promotion: don't use AppleVis to promote your own website, podcast, YouTube channel, mailing list, or other online resource. This does not prohibit sharing your own resources when doing so would benefit an existing discussion. Developers may share and discuss their apps on the forum, answer questions, seek feedback, and share updates, as long as it's genuine and not primarily promotional. Mentioning your own site while asking for help is fine.",
   "advertising": "No advertising or selling. Posts shouldn't be sales listings or adverts. Talking about wanting to buy something, or asking where to buy it, is fine. Asking a developer for a promo code (an App Store download code) to try their app, or a developer offering codes to testers, is fine; only discount or sale codes are advertising.",
   "press-release": "Press releases need discussion around them. Pasting a press release on its own just to promote something isn't allowed. Quoting part of one while discussing it is fine.",
   "ai-disclosure": "If AI wrote a post, the member should say so. Quoting an AI's answer and saying it came from an AI is fine.",
   "multi-topic": "One topic per post. A new post shouldn't mix unrelated subjects. Several questions about the same subject are fine.",
   "shouting": "Be polite. Don't shout at people with capitals or strings of exclamation marks. Excitement, like \"I love this app!!!\", is fine."
  },
  "examples": {
   "tone": {
    "fine": "This update is a mess and Apple clearly didn't test it with VoiceOver.",
    "breaks": "Nobody asked for your opinion, so stop posting."
   },
   "personal-info": {
    "fine": "If you'd like to join the TestFlight, email me at the address on my app's page.",
    "breaks": "Following up on my case. From: Jane Doe <jane.doe@gmail.com> wrote: ..."
   },
   "self-promotion": {
    "fine": "In my own thread asking for game ideas: I've uploaded the prototype to my website. Could you test it and give me feedback?",
    "breaks": "If this helped anyone, I'd really appreciate a like and subscribe."
   },
   "advertising": {
    "fine": "I'd love a promo code to hear the other sounds the app offers.",
    "breaks": "Use the code BACKTOSCHOOL20 for up to $250 off, valid through August 31."
   }
  }
 }

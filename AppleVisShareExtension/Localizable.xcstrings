            "value" : "تمت الإضافة إلى AppleVis. افتح AppleVis لإكمال العملية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zu AppleVis hinzugefügt. Öffne AppleVis, um fertig zu werden."
